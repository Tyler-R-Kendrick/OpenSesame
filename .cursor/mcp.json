{
  "mcpServers": {
    "storybook": {
      "url": "http://localhost:6006/mcp"
    },
    "stitch": {
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${env:STITCH_API_KEY}"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@4.21.4", "mcp"]
    }
  }
}
