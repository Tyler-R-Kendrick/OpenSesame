{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "storybook": {
      "type": "remote",
      "url": "http://localhost:6006/mcp",
      "enabled": true
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      },
      "enabled": true
    }
  }
}
