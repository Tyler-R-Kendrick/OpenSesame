{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "storybook": {
      "type": "remote",
      "url": "http://localhost:6006/mcp",
      "enabled": false
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      },
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@4.21.4", "mcp"],
      "enabled": true
    }
  }
}
