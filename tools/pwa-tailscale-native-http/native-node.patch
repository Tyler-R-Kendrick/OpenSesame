+// NativeExitDNSReady reports whether the original dialer has an exit DNS path.
+// It reveals no endpoint and must not be used without independent route checks.
+func (d *Dialer) NativeExitDNSReady() bool {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.exitDNSDoHBase != ""
+}
