+// NativeExitDNSReady reports whether the original dialer has an exit DNS path.
+// It reveals no endpoint and must not be used without independent route checks.
+func (d *Dialer) NativeExitDNSReady() bool {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.exitDNSDoHBase != ""
+}
+
+// NativePeerDialPlan resolves only the original node's MagicDNS/ExtraRecords.
+// Unresolved names fail closed; no ambient resolver or selected-exit DNS fallback.
+func (d *Dialer) NativePeerDialPlan(ctx context.Context, network, addr string) (netip.AddrPort, bool, error) {
+	ipp, err := d.resolveAddr(ctx, network, addr)
+	if err != nil {
+		return netip.AddrPort{}, false, err
+	}
+	return d.UserDialPlan(ctx, network, ipp.String())
+}
+
