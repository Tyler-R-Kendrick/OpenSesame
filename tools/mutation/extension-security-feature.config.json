{
  "mutate": [
    "packages/app-core/src/browser/security/broker.ts:75:0-138:0",
    "packages/app-core/src/browser/security/client.ts:69:0-94:0"
  ],
  "ignorePatterns": [
    ".agents/**",
    ".codex/**",
    ".deepsec/**",
    ".tools/**",
    ".turbo/**",
    ".git/**",
    "apps/**",
    "docs/**",
    "crates/**",
    "tests/**",
    "scripts/**",
    "artifacts/**",
    "coverage/**",
    "target/**"
