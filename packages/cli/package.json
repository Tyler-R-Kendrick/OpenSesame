{
  "name": "@opensesame/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Client CLI, opensesame-id: Identity sign-in, claims, Host probes, and the Pages vault commands",
  "bin": {
    "opensesame-id": "./dist/bin.js",
    "opensesame-identity": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/bin.js",
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --native",
    "dev": "node --import tsx src/bin.ts",
    "pack:release": "pnpm build:release && node scripts/pack.mjs",
    "test:native": "vitest run --config vitest.native.config.ts",
    "test:installed": "node scripts/build.mjs && node scripts/test-installed.mjs",
    "test:archive": "node scripts/test-archive.mjs",
    "test:native-installed": "node scripts/build.mjs && node scripts/test-native-installed.mjs"
  },
  "dependencies": {
    "@nats-io/nats-core": "3.4.0",
    "@opensesame/api-client": "workspace:*",
    "@opensesame/app-core": "workspace:*",
    "@opensesame/agent-client": "workspace:*",
    "@opensesame/agent-sandboxes": "workspace:*",
    "@opensesame/cua-password-reset": "workspace:*",
    "@opensesame/log-scrub": "workspace:*",
    "@opensesame/mcp-client": "workspace:*",
    "@opensesame/mcp-host": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/sdk-cli": "workspace:*",
    "@opensesame/vault-core": "workspace:*",
    "agent-browser": "0.40.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@opensesame/capability-registry": "workspace:*",
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "@types/ws": "8.18.2",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "ws": "8.22.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/OpenSesame.git"
  }
}
