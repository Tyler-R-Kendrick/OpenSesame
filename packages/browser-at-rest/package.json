{
  "name": "@opensesame/browser-at-rest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "At-rest sealing for browser storage outside the Pages app: a non-extractable AES-GCM key in the origin's IndexedDB, and a sealed view of any Web Storage (ADR 0149)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensesame/os-domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/OpenSesame.git"
  }
}
