{
  "name": "@opensesame/agent-sandboxes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurable browser sandbox providers for agent runs: local ephemeral, Boat, Cloudflare Browser Run, and WASM with virtualized networking over a relay",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude e2e/**/*.spec.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opensesame/cua-password-reset": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.29",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/OpenSesame.git"
  }
}
