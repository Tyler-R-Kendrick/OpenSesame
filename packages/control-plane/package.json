{
  "name": "@opensesame/control-plane",
  "version": "0.1.0",
  "description": "Identity API on :8788: oidc-provider issuer, upstream and federated sign-in, principals, claims, device authorization, organizations and approvals",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=4 --testTimeout=15000",
    "verify:siop": "vitest run src/__tests__/siop-bridge.pact.test.ts src/__tests__/siop-link.test.ts src/services/siop-verify.test.ts src/services/siop-verify-challenge.test.ts",
    "test:authentication-browser": "vitest run --config vitest.authentication.config.ts",
    "generate:openapi": "tsx src/generate-openapi.ts && pnpm --workspace-root exec biome format --write packages/control-plane/openapi.json"
  },
  "dependencies": {
    "@gdp-ts/core": "0.1.0",
    "@hono/node-server": "2.1.5",
    "@node-saml/node-saml": "5.2.0",
    "@opensesame/agent-protocols": "*",
    "@opensesame/audit": "*",
    "@opensesame/auth-upstream": "*",
    "@opensesame/ceremony-kit": "*",
    "@opensesame/claims": "*",
    "@opensesame/contracts": "*",
    "@opensesame/database": "*",
    "@opensesame/device-auth": "*",
    "@opensesame/ingress-evidence": "*",
    "@opensesame/log-scrub": "*",
    "@opensesame/notification-adapters": "*",
    "@opensesame/oauth-provider": "*",
    "@opensesame/observability": "*",
    "@opensesame/openid4vci": "*",
    "@opensesame/openid4vp": "*",
    "@opensesame/os-domain": "*",
    "@opensesame/policy": "*",
    "@opensesame/siop-v2": "*",
    "@opensesame/support-agent": "*",
    "@opensesame/trust-broker": "*",
    "@opensesame/wallet": "*",
    "@opensesame/webhooks": "*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "ldapts": "9.2.0",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.8",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@opensesame/browser-at-rest": "*",
    "@opensesame/mock-upstream-idp": "*",
    "@opensesame/static-auth": "*",
    "@opensesame/testing": "*",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.29",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSesame-Labs/OpenSesame.git"
  }
}
