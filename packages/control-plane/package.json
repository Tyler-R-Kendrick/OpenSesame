{
  "name": "@opensesame/control-plane",
  "version": "0.1.0",
  "description": "Identity API on :8788: oidc-provider issuer, upstream and federated sign-in, principals, claims, device authorization, organizations and approvals",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=4 --testTimeout=15000",
    "verify:siop": "vitest run src/__tests__/siop-bridge.pact.test.ts src/__tests__/siop-link.test.ts src/services/siop-verify.test.ts src/services/siop-verify-challenge.test.ts",
    "test:authentication-browser": "vitest run --config vitest.authentication.config.ts",
    "generate:openapi": "tsx src/generate-openapi.ts && pnpm --workspace-root exec biome format --write packages/control-plane/openapi.json"
  },
  "dependencies": {
    "@gdp-ts/core": "0.1.0",
    "@hono/node-server": "2.1.5",
    "@node-saml/node-saml": "5.2.0",
    "@opensesame/agent-protocols": "workspace:*",
    "@opensesame/audit": "workspace:*",
    "@opensesame/auth-upstream": "workspace:*",
    "@opensesame/ceremony-kit": "workspace:*",
    "@opensesame/claims": "workspace:*",
    "@opensesame/contracts": "workspace:*",
    "@opensesame/database": "workspace:*",
    "@opensesame/device-auth": "workspace:*",
    "@opensesame/ingress-evidence": "workspace:*",
    "@opensesame/log-scrub": "workspace:*",
    "@opensesame/notification-adapters": "workspace:*",
    "@opensesame/oauth-provider": "workspace:*",
    "@opensesame/observability": "workspace:*",
    "@opensesame/openid4vci": "workspace:*",
    "@opensesame/openid4vp": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/policy": "workspace:*",
    "@opensesame/siop-v2": "workspace:*",
    "@opensesame/support-agent": "workspace:*",
    "@opensesame/trust-broker": "workspace:*",
    "@opensesame/wallet": "workspace:*",
    "@opensesame/webhooks": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "ldapts": "9.2.0",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@opensesame/browser-at-rest": "workspace:*",
    "@opensesame/mock-upstream-idp": "workspace:*",
    "@opensesame/static-auth": "workspace:*",
    "@opensesame/testing": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.29",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/OpenSesame.git"
  }
}
