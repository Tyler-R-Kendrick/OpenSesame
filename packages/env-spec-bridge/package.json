{
  "name": "@opensesame/env-spec-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parses .env.schema with @env-spec/parser and emits JSON for the Rust env-spec crate",
  "bin": {
    "opensesame-env-parse": "./bin/opensesame-env-parse.mjs"
  },
  "scripts": {
    "build": "node -e \"console.log('noop build — ESM ready')\"",
    "bundle": "node scripts/bundle.mjs",
    "test": "node --test test/parse.test.mjs test/bundle.test.mjs"
  },
  "dependencies": {
    "@env-spec/parser": "0.6.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSesame-Labs/OpenSesame.git"
  }
}
