{
  "name": "@opensesame/app-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The client application core shared by the Pages PWA, the CLIs and Android (ADR 0133) \u2014 no React, no DOM shell",
  "exports": {
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*.json": "./src/*.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:catalog": "node scripts/emit-connector-catalog.mjs && biome format --write src/lib/connector-catalog.generated.ts src/lib/ai-model-provider-ids.generated.ts",
    "generate:quorum-types": "node scripts/emit-quorum-types.mjs && biome format --write src/lib/quorum/item-types.generated.ts",
    "generate:reset-mail-types": "node scripts/emit-reset-mail-types.mjs && biome format --write src/lib/password-reset/mail-type.generated.ts",
    "generate:connect": "node scripts/emit-connect-presets.mjs && node scripts/emit-google-account-policy.mjs && biome format --write src/lib/connect-presets.generated.ts src/lib/native-google-account-policy.generated.ts",
    "generate:dispositions": "node scripts/emit-browser-dispositions.mjs && biome format --write src/lib/browser-dispositions.generated.ts",
    "generate:identity": "node scripts/emit-identity-presets.mjs && biome format --write src/lib/identity-presets.generated.ts"
  },
  "devDependencies": {
    "@opensesame/testing": "workspace:*",
    "@peculiar/x509": "1.14.3",
    "@types/node": "22.15.29",
    "@types/react": "19.2.7",
    "@types/whatwg-url": "13.0.0",
    "better-auth": "1.7.7",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vitest": "4.1.12",
    "xml-crypto": "6.1.2"
  },
  "dependencies": {
    "@1password/sdk-core": "0.5.0",
    "@ag-ui/client": "0.0.59",
    "@ai-sdk/provider": "3.0.14",
    "@azure/msal-browser": "5.22.0",
    "@bitwarden/sdk-wasm": "0.1.0",
    "@bufbuild/protobuf": "2.15.0",
    "@cfworker/json-schema": "4.1.1",
    "@effect/platform-node-shared": "4.0.2",
    "@gdp-ts/core": "0.1.0",
    "@levischuck/tiny-cbor": "0.2.11",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@nats-io/nkeys": "2.0.3",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "1.8.0",
    "@openfeature/web-sdk": "1.10.0",
    "@opensesame/api-client": "workspace:*",
    "@opensesame/audit": "workspace:*",
    "@opensesame/auth-upstream": "workspace:*",
    "@opensesame/capability-composition": "workspace:*",
    "@opensesame/capability-registry": "workspace:*",
    "@opensesame/ceremony-kit": "workspace:*",
    "@opensesame/connector-bridge": "workspace:*",
    "@opensesame/contracts": "workspace:*",
    "@opensesame/guide-lang": "workspace:*",
    "@opensesame/log-scrub": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/qr": "workspace:^",
    "@opensesame/sdk-browser": "workspace:*",
    "@opensesame/siop-v2": "workspace:*",
    "@opensesame/static-auth": "workspace:*",
    "@opensesame/support-agent": "workspace:*",
    "@opensesame/vault-core": "workspace:*",
    "@opensesame/vault-item-types": "workspace:*",
    "@opensesame/wallet": "workspace:*",
    "@opensesame/wallet-budget": "workspace:*",
    "@opensesame/wallet-consent": "workspace:*",
    "@opensesame/webmcp": "workspace:*",
    "@vercel/connect": "2.2.0",
    "age-encryption": "0.3.1",
    "ai": "6.0.237",
    "effect": "4.0.2",
    "hash-wasm": "4.12.0",
    "jose": "6.2.8",
    "kdbxweb": "2.1.1",
    "whatwg-url": "14.2.0",
    "xml-core": "1.2.6",
    "xmldsigjs": "2.8.8",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
