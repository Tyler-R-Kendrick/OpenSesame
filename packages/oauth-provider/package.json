{
  "name": "@opensesame/oauth-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./origin/canonical": {
      "types": "./src/origin/canonical.ts",
      "default": "./src/origin/canonical.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opensesame/os-domain": "workspace:*",
    "oidc-provider": "9.11.2"
  },
  "devDependencies": {
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
