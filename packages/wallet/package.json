{
  "name": "@opensesame/wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wallet passes for cross-device interactions: vendor-neutral provider boundary and Google Wallet adapter",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./google-client": {
      "types": "./src/google-client.ts",
      "default": "./src/google-client.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./google-wallet-policy": {
      "types": "./src/google-wallet-policy.ts",
      "default": "./src/google-wallet-policy.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensesame/os-domain": "*",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSesame-Labs/OpenSesame.git"
  }
}
