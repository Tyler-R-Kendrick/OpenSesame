{
  "name": "@opensesame/mcp-client",
  "version": "0.1.0",
  "description": "Agent-facing MCP server over stdio: Host API health, discovery and E2EE sync tools under a short-lived agent capability, with no secret-reading tool",
  "private": true,
  "type": "module",
  "bin": {
    "opensesame-mcp-client": "./src/server.ts"
  },
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensesame/agent-client": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@opensesame/api-client": "workspace:*",
    "@opensesame/observability": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@opensesame/capability-registry": "workspace:*",
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSesame-Labs/OpenSesame.git"
  }
}
