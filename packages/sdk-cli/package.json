{
  "name": "@opensesame/sdk-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node SDK for Identity API command-line clients: device flow, loopback PKCE login and a typed API client",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opensesame/log-scrub": "*",
    "@opensesame/os-domain": "*",
    "@opensesame/qr": "*"
  },
  "devDependencies": {
    "@opensesame/testing": "*",
    "@types/node": "22.15.29",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSesame-Labs/OpenSesame.git"
  }
}
