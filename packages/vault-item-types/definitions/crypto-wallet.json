{
  "apiVersion": "opensesame.dev/v1alpha1",
  "kind": "VaultItemType",
  "metadata": {
    "id": "crypto-wallet",
    "version": "1.0.0",
    "publisher": "https://opensesame.dev"
  },
  "spec": {
    "title": "Crypto wallet",
    "plural": "Crypto wallets",
    "extension": ".wallet",
    "summary": "A wallet's recovery phrase, its addresses, and the network it lives on.",
    "categories": ["finance"],
    "sections": [
      {
        "id": "wallet",
        "title": "Wallet",
        "fields": [
          {
            "id": "walletName",
