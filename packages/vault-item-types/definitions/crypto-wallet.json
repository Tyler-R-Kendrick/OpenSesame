      "trailer": [
        { "key": "wallet", "field": "walletName" },
        { "key": "network", "field": "network" },
        { "key": "private_key", "field": "privateKey" },
        { "key": "pin", "field": "pin" },
        { "key": "address", "field": "addresses" },
        { "key": "derivation_path", "field": "derivationPath" }
