        ]
      }
    ],
    "native": {
      "secret": "apiKey",
      "trailer": [
        { "key": "service", "field": "service" },
        { "key": "client_id", "field": "clientId" },
        { "key": "client_secret", "field": "clientSecret" },
        { "key": "scope", "field": "scopes" },
        { "key": "url", "field": "baseUrl" },
        { "key": "token_url", "field": "tokenUrl" },
        { "key": "expires_at", "field": "expiresAt" },
        { "key": "connection_ref", "field": "connectionRef" }
      ]
    },
    "cxf": { "credential": "api-key" },
    "subtitle": ["service", "baseUrl"],
    "search": ["service", "clientId", "baseUrl"]
