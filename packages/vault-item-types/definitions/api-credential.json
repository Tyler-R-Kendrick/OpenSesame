          { "id": "clientId", "type": "string", "label": "Client id" },
          { "id": "apiKey", "type": "concealed", "label": "API key" },
          {
            "id": "clientSecret",
            "type": "concealed",
            "label": "Client secret"
          },
          {
            "id": "scopes",
            "type": "string",
            "label": "Scope",
            "multiple": true
          }
        ]
      },
      {
        "id": "endpoint",
        "title": "Endpoint",
        "fields": [
          { "id": "baseUrl", "type": "url", "label": "Base URL" },
          { "id": "tokenUrl", "type": "url", "label": "Token endpoint" },
          { "id": "expiresAt", "type": "date", "label": "Expires" },
          {
            "id": "connectionRef",
            "type": "string",
            "label": "Connection reference"
