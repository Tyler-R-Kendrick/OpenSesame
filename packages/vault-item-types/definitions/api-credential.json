{
  "apiVersion": "opensesame.dev/v1alpha1",
  "kind": "VaultItemType",
  "metadata": {
    "id": "api-credential",
    "version": "1.0.0",
    "publisher": "https://opensesame.dev"
  },
  "spec": {
    "title": "API credential",
    "plural": "API credentials",
    "extension": ".api",
    "summary": "An API key or client credential, and the endpoint and scopes it is good for.",
    "categories": ["developer", "access"],
    "sections": [
      {
        "id": "credential",
        "title": "Credential",
        "fields": [
          {
            "id": "service",
            "type": "string",
            "label": "Service",
            "required": true
