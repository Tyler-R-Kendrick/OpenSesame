{
  "name": "@opensesame/identity-worker",
  "version": "0.1.0",
  "description": "Identity-plane cleanup worker: drains the outbox onto the TaskBus, fans out webhooks and notifications, and prunes expired issuer rows",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "sh -c 'test -n \"$DATABASE_URL\" || { echo \"test:postgres needs DATABASE_URL (a role with CREATEDB)\" >&2; exit 1; }' && vitest run src/__tests__/web-push-delivery.postgres.test.ts"
  },
  "dependencies": {
    "@opensesame/log-scrub": "*",
    "@opensesame/claims": "*",
    "@opensesame/database": "*",
    "@opensesame/webhooks": "*",
    "@opensesame/observability": "*",
    "@opensesame/os-domain": "*",
    "nats": "2.29.3",
    "@opensesame/notification-adapters": "*"
  },
  "devDependencies": {
    "@opensesame/testing": "*",
    "@types/node": "22.15.29",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSesame-Labs/OpenSesame.git"
  }
}
