{
  "name": "@opensesame/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Identity-plane Drizzle schema, Postgres migrations, and Postgres and in-memory repositories",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:integration": "vitest run tests/pact.test.ts",
    "test:postgres": "sh -c 'test -n \"$DATABASE_URL\" || { echo \"test:postgres needs DATABASE_URL (a role with CREATEDB)\" >&2; exit 1; }' && vitest run --maxWorkers=4",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:reset": "tsx src/reset.ts"
  },
  "dependencies": {
    "@opensesame/log-scrub": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@opensesame/testing": "workspace:*",
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/OpenSesame.git"
  }
}
