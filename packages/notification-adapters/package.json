{
  "name": "@opensesame/notification-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notification channel adapters (Slack, Teams, Telegram, WeChat, SMS, Web Push, webhook): rendering, delivery, callback provenance (ADR 0084)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test-support": {
      "types": "./test-support/index.ts",
      "default": "./test-support/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:vapid": "tsx scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@opensesame/oauth-provider": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/webhooks": "workspace:*"
  },
  "devDependencies": {
    "@types/jws": "3.2.10",
    "@types/node": "22.15.29",
    "http_ece": "1.2.1",
    "jws": "4.0.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  }
}
