{
  "name": "@opensesame/ceremony-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UI-independent ceremony logic: canonical interaction links, the interaction client, display-safe summaries and device approval (ADR 0086)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate:routes": "node scripts/emit-ceremony-routes.mjs && biome format --write src/ceremony-routes.generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@opensesame/os-domain": "workspace:*"
  }
}
