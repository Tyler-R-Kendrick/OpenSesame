{
  "name": "@opensesame/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod wire schemas shared by the Identity and Host APIs and their clients, plus the duress policy compiler",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./duress": {
      "types": "./src/duress/index.ts",
      "default": "./src/duress/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensesame/os-domain": "*",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@opensesame/testing": "*",
    "@types/node": "22.15.29",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSesame-Labs/OpenSesame.git"
  }
}
