{
  "name": "@opensesame/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod wire schemas shared by the Identity and Host APIs and their clients, plus the duress policy compiler",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./duress": {
      "types": "./src/duress/index.ts",
      "default": "./src/duress/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensesame/os-domain": "workspace:*",
    "yaml": "2.8.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "fast-check": "4.9.0",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  }
}
