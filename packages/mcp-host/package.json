{
  "name": "@opensesame/mcp-host",
  "version": "0.1.0",
  "description": "Host-facing MCP server over stdio or loopback HTTP: task, intent, sync and health tools under a short-lived agent capability, with no secret-reading tool",
  "private": true,
  "type": "module",
  "bin": {
    "opensesame-mcp-host": "./src/server.ts"
  },
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/pact.test.ts src/tools.test.ts"
  },
  "dependencies": {
    "@opensesame/agent-client": "workspace:*",
    "@opensesame/api-client": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@opensesame/observability": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/telemetry": "workspace:*",
    "posthog-node": "5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opensesame/capability-registry": "workspace:*",
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/OpenSesame.git"
  }
}
