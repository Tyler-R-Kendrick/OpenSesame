{
  "name": "@opensesame/sdk-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser SDK for Identity API relying parties: sign-in with PKCE, callbacks, ID-token validation, claims and passkeys",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opensesame/browser-at-rest": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/OpenSesame.git"
  }
}
