{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/dev-dist/**",
      "**/node_modules/**",
      "**/target/**",
      "**/.tools/**",
      "**/tools/oxlint/anti-slop/**",
      "**/skills/install-anti-slop/**",
      ".agents/skills/**",
      ".claude/skills/**",
      "skills-lock.json",
      "**/sbom/**",
      "fixtures/kdbx/roundtrip.expected.json",
      "docs/design/**"
    ]
  },
  "overrides": [
    {
      "include": [
        "apps/pages/public/static-auth/1.0.2/opensesame-auth.min.js",
        "apps/pages/public/auth.js"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "organizeImports": { "enabled": false }
    }
  ]
}
