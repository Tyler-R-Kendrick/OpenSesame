{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnusedImports": "error" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/dev-dist/**",
      "**/node_modules/**",
      "**/target/**",
      "**/.tools/**",
      "**/tools/oxlint/anti-slop/**",
      "**/skills/install-anti-slop/**",
      ".agents/skills/**",
      ".claude/skills/**",
      "skills-lock.json",
      "**/sbom/**",
      "tests/fixtures/kdbx/roundtrip.expected.json",
      "packages/app-core/src/lib/sops/fixtures/upstream/**",
      "docs/design/**",
      "spec/connectors/catalog.view.json",
      "spec/agent-hooks/conformance/**",
      "spec/conformance/slip39/vectors.json",
      "spec/conformance/pepper-position-vectors.json",
      "packages/vault-item-types/src/**/*.generated.ts"
    ]
  },
  "overrides": [
    {
      "include": [
        "apps/pages/public/static-auth/1.0.4/opensesame-auth.min.js",
        "apps/pages/public/auth.js",
        "apps/pages/public/static-auth/1.0.3/opensesame-auth.min.js",
        "apps/pages/public/static-auth/1.0.2/opensesame-auth.min.js"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "organizeImports": { "enabled": false }
    }
  ]
}
