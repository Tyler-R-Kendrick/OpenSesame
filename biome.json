{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/dev-dist/**",
      "**/node_modules/**",
      "**/target/**",
      "**/.tools/**",
      "**/tools/oxlint/anti-slop/**",
      "**/skills/install-anti-slop/**",
      "**/sbom/**",
      "apps/pages/public/auth.js"
    ]
  }
}
