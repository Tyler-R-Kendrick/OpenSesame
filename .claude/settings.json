{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:all)",
      "Bash(pnpm test)",
      "Bash(pnpm test:all)",
      "Bash(pnpm test:integration)",
      "Bash(npx tsc --noEmit)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
