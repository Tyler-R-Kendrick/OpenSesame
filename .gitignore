# Agent harness roots are ignored by default: installed skills, generated
# mirrors, local settings, and runtime state are install output, restored by
# scripts/dev/install-agent-skills.sh (devcontainer post-create) from
# skills-lock.json. Only the repo-built adapters whitelisted below are
# tracked. First-party skills live in skills/ (tracked); their 8
# .agents/skills aliases are whitelisted so discovery works from a clone.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/install-anti-slop
!.agents/skills/local-debug-session
!.agents/skills/opensesame-apis
!.agents/skills/opensesame-chrome-extension
!.agents/skills/opensesame-clis
!.agents/skills/opensesame-mcps
!.agents/skills/security-review
!.agents/skills/visual-evidence
.claude/*
!.claude/README.md
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
# impeccable also installs into .github (Copilot) roots: install output too.
.github/skills/
.github/agents/
.github/hooks/
# Other agent roots installers may create (OpenClaw etc.): never source here.
/agent/
# skills/ holds first-party source only; ignore installer-written entries
# (the skills CLI "universal" target) so they can never be staged.
skills/*
!skills/README.md
!skills/profiles.json
!skills/install-anti-slop/
!skills/local-debug-session/
!skills/opensesame-apis/
!skills/opensesame-chrome-extension/
!skills/opensesame-clis/
!skills/opensesame-mcps/
!skills/security-review/
!skills/visual-evidence/
.codex/*
!.codex/config.toml
!.codex/hooks.json
.grok/*
!.grok/config.toml
!.grok/workflows/
!.grok/workflows/**
.cursor/*
!.cursor/Dockerfile
!.cursor/cloud-path.sh
!.cursor/environment.json
!.cursor/install.sh
!.cursor/kimi-code.md
!.cursor/mcp.json
!.cursor/rules/
!.cursor/rules/**
!.cursor/tools/
!.cursor/tools/**

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# Unanchored: .impeccable may sit at the repo root or under a nested
# workspace (apps/web/.impeccable/...); anchored patterns would miss it.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, critique/*.md.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end

# insta pending-acceptance snapshots (review with `cargo insta review`,
# never commit; the accepted .snap files are the reviewed artifact)
*.snap.new
*.pending-snap

# Seeded Claude Design canvases — ~2.3 MB of editor code each, regenerated
# from the .dc.html artboards beside them (docs/design/canvases/*/README.md).
docs/design/**/opensesame-*.html

# Wallet EVM local-chain vendor (cloned at pin by contracts-harness)
packages/wallet-evm/vendor/


# Local agent debug dumps / tool binaries (never ship)
kimi-debug-session_*.zip
tools/bin/

# Foundry build outputs (regenerate locally)
packages/wallet-x402/forge/out/
packages/wallet-x402/forge/cache/
**/forge/out/
**/forge/cache/

# Duress BROWSER-QA disposable fixtures
apps/pages/scripts/duress/.fixture-dist/
apps/pages/scripts/duress/.artifacts/
apps/pages/scripts/duress/.ui-artifacts/

# Duress swarm workspace (local coordination; never ship)
.duress-swarm/

# mTLS fixture downloads (scripts/mtls/mtls-fixtures.sh) and suite artifacts
.cache/mtls-fixtures/
# verify:live-join servers built from source (scripts/test/live-fixtures.sh)
.cache/live-fixtures/
.cache/bitwarden-oracle/
.cache/tailnet-fixtures/
artifacts/mtls/

# Local parity gauntlet reports and scratch fixtures
/work/
# Public Lighthouse/Is Agentic reports are generated by scripts/quality/web-score.mjs.
/reports/web-score/

# Stitch prototypes and extracted HTML (docs/design/tooling.md); DESIGN.md stays
.stitch/designs/
.stitch/*.html
# Dedicated loopback build used by the identity integration browser gate.
apps/pages/dist-identity-verify/
apps/pages/work/

apps/pages/dist-secret-backends-verify/

# Source-built browser networking runtime (verified build cache).
.cache/pwa-tailscale-native-http/

# Isolated Web App build output
apps/pages/dist-iwa/

# Evidence review scratch is never implementation evidence.
**/.impeccable/review/
**/.impeccable/screenshots/

# Historical execution output belongs on its PR or in private task scratch.
/kimi-reviews/
/docs/security/cloudflare-audit/run-*/

# Source-based design canvases regenerate these artboards before seeding.
/docs/design/canvases/auth-flow/*.dc.html
/docs/design/canvases/first-run-setup/*.dc.html
/docs/design/canvases/pwa-install/*.dc.html
/docs/design/canvases/setup-next-steps/*.dc.html
