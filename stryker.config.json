{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "apps/pages/src/lib/guest-auth.ts",
    "apps/pages/src/lib/notices.ts",
    "apps/pages/src/lib/probe-failure.ts",
    "packages/audit/src/redact.ts",
    "packages/observability/src/agent-payload.ts",
    "packages/os-domain/src/endpoint-display.ts",
    "packages/policy/src/provisional.ts",
    "packages/sdk-cli/src/secure-url.ts"
  ],
  "ignorePatterns": [
    ".agents/**",
    ".codex/**",
    ".deepsec/**",
    ".tools/**",
    ".turbo/**",
    "apps/eve-deepsec/**",
    "artifacts/**",
    "coverage/**",
    "packages/visual-contract/output/**",
    "test-results/**",
    "target/**"
  ],
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": true
  },
  "concurrency": 2,
  "timeoutMS": 10000,
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "artifacts/mutation/typescript.json"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  }
}
