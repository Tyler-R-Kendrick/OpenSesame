{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "apps/pages/src/screens/unlock/unlock-duress-continue.ts",
    "apps/pages/src/screens/unlock/unlock-pin-duress.ts",
    "apps/pages/src/screens/unlock/unlock-duress-refuse.ts"
  ],
  "ignorePatterns": [
    ".agents/**",
    ".codex/**",
    ".deepsec/**",
    ".tools/**",
    ".turbo/**",
    "apps/eve-deepsec/**",
    "artifacts/**",
    "coverage/**",
    "packages/visual-contract/output/**",
    "test-results/**",
    "target/**"
  ],
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.duress-mutation.config.ts",
    "related": false
  },
  "concurrency": 2,
  "timeoutMS": 10000,
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "artifacts/mutation/duress-unlock.json"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  }
}
