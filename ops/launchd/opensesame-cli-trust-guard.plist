<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.opensesame.cli-trust-guard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/opensesame-cli-trust-guard</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>OPENSESAME_CLI_TRUST_GUARD_STATE</key>
