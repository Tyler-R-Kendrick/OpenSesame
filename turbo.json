{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "strict",
  "globalPassThroughEnv": [
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "all_proxy",
    "no_proxy",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "PAGES_CANONICAL_ORIGIN",
        "PAGES_DEPLOYMENT_PROFILE",
        "PAGES_HEADER_SECURITY",
        "GITHUB_REPOSITORY_OWNER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["VITEST_MAX_WORKERS"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "VITEST_MAX_WORKERS",
        "PLAYWRIGHT_CHROMIUM",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_CHROMIUM",
        "PLAYWRIGHT_BROWSERS_PATH",
        "OPENSESAME_OPERATOR_TOKEN"
      ]
    }
  }
}
