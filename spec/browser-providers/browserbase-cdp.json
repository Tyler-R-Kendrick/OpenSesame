{
  "schema_version": 1,
  "id": "browserbase-cdp",
  "kind": "cdp",
  "display_name": "Browserbase-compatible CDP",
  "runtime_configuration": ["connection_id", "session_id", "cdp_url"],
  "confinement": "driver-enforced",
