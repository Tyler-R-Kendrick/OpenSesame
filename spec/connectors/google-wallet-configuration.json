{
  "provider_id": "google-wallet",
  "issuer_id": {
    "pattern": "^\\d{6,32}$"
  },
  "class_id": {
    "suffix_pattern": "^[A-Za-z0-9._-]+$",
    "issuer_separator": ".",
    "qualification": "unqualified-or-this-issuer"
  },
  "service_account_email": {
    "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
    "max_length": 320
  },
  "service_account_key": {
    "format": "pkcs8",
    "algorithm": "RSASSA-PKCS1-v1_5",
    "hash": "SHA-256",
    "usage": "sign",
    "max_raw_length": 32768,
    "pem_pattern": "^-----BEGIN PRIVATE KEY-----\\s*([A-Za-z0-9+/=\\s]{200,32768})-----END PRIVATE KEY-----\\s*$",
    "escaped_newlines": true
  },
  "semantics": {
    "regex_dialect": "ecmascript",
    "length_unit": "utf16_code_units",
    "pem_whitespace": "ecmascript",
    "private_key_validation": "pem_then_webcrypto_import",
    "pem_envelope_stage": "strip_ecmascript_whitespace_then_base64_decode",
    "wallet_config_stage": "pem_envelope_only",
    "native_storage_stage": "webcrypto_pkcs8_rsa_import",
    "native_input_normalization": "trim_public_fields_preserve_private_before_validation",
    "wallet_env_normalization": "trim_each_value_and_lowercase_email",
    "native_verified_entry_stage": "service_account_json_then_wallet_config_then_signed_provider_proof"
  },
  "native_service_account": {
    "type": "service_account",
    "email_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}@[a-z][a-z0-9-]{3,61}\\.(?:iam\\.)?gserviceaccount\\.com$",
    "key_pem_pattern": "^-----BEGIN PRIVATE KEY-----([A-Za-z0-9+/=\\s]{200,8192})-----END PRIVATE KEY-----\\s*$",
    "json_max_length": 32768
  }
}
