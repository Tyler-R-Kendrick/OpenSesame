{
  "schema_version": 1,
  "description": "Model key exchange (ADR 0188): the decisions a conforming implementation makes. Each case issues one root key, then runs its steps in order. An exchange is RFC 8693 token exchange with an RFC 9396 `model_access` detail; a call is the last-hop check. `dpop_optional` is the policy, so no proof is needed; DPoP is covered by the TypeScript suite and by RFC 9449.",
  "now_ms": 1791720000000,
  "policy": {
    "senderConstraint": "dpop_optional",
    "rootMaxLifetimeSeconds": 28800,
    "maxLifetimeSeconds": 3600,
    "defaultLifetimeSeconds": 900,
    "maxDelegationDepth": 2,
    "outputTokenCeiling": 32768
  },
  "providers": [
    {
      "providerId": "openai",
      "protocol": "openai_chat",
      "baseUrl": "https://api.openai.com/v1",
      "connectionId": "conn-openai"
    }
  ],
  "cases": [
    {
      "name": "narrowing models, actions, budget and lifetime is issued",
      "root": {
        "clientId": "app-1",
        "resource": "https://api.openai.com/v1",
        "models": ["gpt-4o", "gpt-4o-mini"],
        "actions": ["model.invoke", "model.list"],
        "budget": {
          "requests": 100,
          "input_tokens": 100000,
          "output_tokens": 50000,
          "max_output_tokens": 4096
        },
        "lifetimeSeconds": 7200,
        "maximumDelegationDepth": 2
      },
      "steps": [
        {
          "op": "exchange",
          "from": "root",
          "details": {
            "locations": ["https://api.openai.com/v1"],
            "models": ["gpt-4o"],
            "actions": ["model.invoke"],
            "budget": {
              "requests": 10,
              "input_tokens": 10000,
              "output_tokens": 5000,
              "max_output_tokens": 1024
            },
            "lifetime_seconds": 600
          },
          "expect": {
            "issued": {
              "scope": "model.invoke",
              "expires_in": 600,
              "models": ["gpt-4o"],
              "resource": "https://api.openai.com/v1"
            }
          },
          "as": "k1"
        }
      ]
    },
