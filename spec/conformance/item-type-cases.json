              "id": "token",
              "type": "concealed",
              "label": "Token"
            }
          ]
        }
      ],
      "native": {
        "secret": "token",
        "trailer": [
          {
            "key": "label",
            "field": "label"
          }
        ]
      },
      "cxf": {
        "credential": "custom-fields"
      },
      "subtitle": ["label"],
      "search": ["label"]
