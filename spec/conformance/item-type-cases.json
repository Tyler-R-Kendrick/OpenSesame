  "projectionCases": [
    {
      "name": "a login projects onto a pass entry",
      "type": "login",
      "values": {
        "username": "ada",
        "password": "correct horse",
        "totp": "",
        "uris": ["https://example.test"]
      },
      "entry": {
        "secret": "correct horse",
        "trailer": "login: ada\nurl: https://example.test\n"
      },
      "rendered": "correct horse\nlogin: ada\nurl: https://example.test\n",
      "readback": {
        "values": {
          "username": "ada",
          "password": "correct horse",
          "uris": ["https://example.test"]
        },
        "extra": {}
      }
    },
    {
      "name": "a TOTP seed is written as a bare otpauth line where pass-otp looks",
      "type": "login",
      "values": {
        "username": "ada",
        "password": "pw",
        "totp": "otpauth://totp/Demo?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "uris": []
      },
      "entry": {
        "secret": "pw",
        "trailer": "login: ada\notpauth://totp/Demo?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ\n"
      },
      "readback": {
        "values": {
          "username": "ada",
          "password": "pw",
          "totp": "otpauth://totp/Demo?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ"
        },
        "extra": {}
      }
    },
    {
      "name": "a repeating field repeats its key once per value",
