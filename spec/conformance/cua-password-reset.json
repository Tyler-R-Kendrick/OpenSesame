{
  "schema_version": 1,
  "adr": "0213",
  "primitives": [
    "navigate",
    "fill-field",
    "click",
    "await-email-link",
    "enter-email-code",
    "enter-TOTP",
    "passkey-prompt",
    "await-human",
    "submit",
    "verify-login"
  ],
  "never_replay": ["submit", "verify-login", "passkey-prompt", "await-human"],
  "human_challenges": ["captcha", "sms", "2fa", "passkey", "email", "unknown"],
  "grant_actions": [
    "password_reset.domain_metadata.list",
    "password_reset.item.use",
    "password_reset.mailbox.read",
    "password_reset.browser.drive",
    "password_reset.runtime.execute",
    "password_reset.model.plan",
    "password_reset.proxy.substitute",
    "password_reset.password.produce",
    "password_reset.human.takeover",
    "password_reset.run.reconcile",
    "password_reset.run.compensate"
  ],
  "rules": {
    "model_values": "forbidden",
    "screenshots": "masked",
    "candidate": "algorithmic_with_human_pepper",
    "checkpoint": "every_intent_and_outcome",
    "submit_interrupted": "reconciliation_required",
    "synthetic_form_password": "exact_form_proxy_only"
  },
  "audience_prefix": "opensesame:password-reset:",
  "vectors": [
    {
      "name": "domain_metadata_is_exact_and_read_only",
      "run_id": "run-01",
      "domain": "example.test",
      "capability": "domain_metadata",
      "grant_actions": ["password_reset.domain_metadata.list"],
      "grant_resources": ["password-reset:domain:example.test:metadata"],
      "raw_credential_export": false,
      "expected": "allow"
    },
    {
      "name": "selected_item_is_narrower",
      "run_id": "run-01",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "item",
      "grant_actions": ["password_reset.item.use"],
      "grant_resources": ["password-reset:domain:example.test:item:login-01"],
      "raw_credential_export": false,
      "expected": "allow"
    },
    {
      "name": "proxy_has_its_own_item_grant",
      "run_id": "run-01",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "proxy",
      "grant_actions": ["password_reset.proxy.substitute"],
      "grant_resources": ["password-reset:domain:example.test:item:login-01"],
      "raw_credential_export": false,
      "expected": "allow"
    },
    {
      "name": "metadata_grant_cannot_use_item",
      "run_id": "run-01",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "item",
      "grant_actions": ["password_reset.domain_metadata.list"],
      "grant_resources": ["password-reset:domain:example.test:metadata"],
      "raw_credential_export": false,
      "expected": "deny"
    },
    {
      "name": "item_grant_cannot_list_domain",
      "run_id": "run-01",
      "domain": "example.test",
      "capability": "domain_metadata",
      "grant_actions": ["password_reset.item.use"],
      "grant_resources": ["password-reset:domain:example.test:item:login-01"],
      "raw_credential_export": false,
      "expected": "deny"
    },
    {
      "name": "another_domain_is_refused",
      "run_id": "run-01",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "item",
      "grant_actions": ["password_reset.item.use"],
      "grant_resources": ["password-reset:domain:other.test:item:login-01"],
      "raw_credential_export": false,
      "expected": "deny"
    },
    {
      "name": "another_item_is_refused",
      "run_id": "run-01",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "item",
      "grant_actions": ["password_reset.item.use"],
      "grant_resources": ["password-reset:domain:example.test:item:login-02"],
      "raw_credential_export": false,
      "expected": "deny"
    },
    {
      "name": "grant_from_another_run_is_refused",
      "run_id": "run-02",
      "grant_run_id": "run-01",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "item",
      "grant_actions": ["password_reset.item.use"],
      "grant_resources": ["password-reset:domain:example.test:item:login-01"],
      "raw_credential_export": false,
      "expected": "deny"
    },
    {
      "name": "intent_from_another_run_is_refused",
      "run_id": "run-02",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "item",
      "intent_run_id": "run-01",
      "grant_actions": ["password_reset.item.use"],
      "grant_resources": ["password-reset:domain:example.test:item:login-01"],
      "raw_credential_export": false,
      "expected": "deny"
    },
    {
      "name": "sibling_capability_needs_approval",
      "run_id": "run-01",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "model",
      "grant_actions": ["password_reset.runtime.execute"],
      "grant_resources": ["password-reset:domain:example.test:item:login-01"],
      "raw_credential_export": false,
      "expected": "deny"
    },
    {
      "name": "wildcard_item_resource_is_not_accepted",
      "run_id": "run-01",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "item",
      "grant_actions": ["password_reset.item.use"],
      "grant_resources": ["password-reset:domain:example.test:item:*"],
      "raw_credential_export": false,
      "expected": "deny"
    },
    {
      "name": "raw_export_is_always_refused",
      "run_id": "run-01",
      "domain": "example.test",
      "item_id": "login-01",
      "capability": "item",
      "grant_actions": ["password_reset.item.use"],
      "grant_resources": ["password-reset:domain:example.test:item:login-01"],
      "raw_credential_export": true,
      "expected": "deny"
    },
    {
      "name": "metadata_cannot_narrow_without_item",
      "run_id": "run-01",
      "domain": "example.test",
      "capability": "domain_metadata",
      "narrow_capability": "model",
      "grant_actions": [],
      "grant_resources": [],
      "raw_credential_export": false,
      "expected": "invalid_scope"
    }
  ]
}
