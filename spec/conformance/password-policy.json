{
  "$comment": "The character-password generator every target uses: packages/app-core (Pages, the client CLI, Android) and crates/sealed-store (the native CLI's pass verbs, the KeePassXC bridge). Each reads this file; neither keeps its own alphabet or defaults. Every selected class contributes at least one character, the rest are drawn uniformly from their union, and the result is shuffled. ADR 0139.",
  "classes": {
    "lower": "abcdefghijklmnopqrstuvwxyz",
    "upper": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "digits": "0123456789",
    "symbols": "!@#$%^&*()-_=+[]{};:,.?"
  },
  "ambiguous": "il1Lo0O",
  "defaults": {
    "length": 20,
    "lower": true,
    "upper": true,
    "digits": true,
    "symbols": true,
    "avoidAmbiguous": true
  },
  "cases": [
    {
      "name": "the defaults",
      "options": {},
      "expect": {
        "length": 20,
        "classes": ["lower", "upper", "digits", "symbols"],
        "ambiguous": false
      }
    },
    {
      "name": "alphanumeric, ambiguous characters allowed",
      "options": { "length": 32, "symbols": false, "avoidAmbiguous": false },
      "expect": {
        "length": 32,
        "classes": ["lower", "upper", "digits"],
        "ambiguous": true
      }
    },
    {
      "name": "a PIN",
      "options": {
        "length": 6,
        "lower": false,
        "upper": false,
        "symbols": false,
        "avoidAmbiguous": false
      },
      "expect": { "length": 6, "classes": ["digits"], "ambiguous": true }
    },
    {
      "name": "too short to hold every class grows to one of each",
      "options": { "length": 2 },
      "expect": {
        "length": 4,
        "classes": ["lower", "upper", "digits", "symbols"],
        "ambiguous": false
      }
    },
    {
      "name": "a zero length grows to one of each",
      "options": {
        "length": 0,
        "upper": false,
        "digits": false,
        "symbols": false
      },
      "expect": { "length": 1, "classes": ["lower"], "ambiguous": false }
    },
    {
      "name": "no class selected is refused",
      "options": {
        "lower": false,
        "upper": false,
        "digits": false,
        "symbols": false
      },
      "error": true
    }
  ]
}
