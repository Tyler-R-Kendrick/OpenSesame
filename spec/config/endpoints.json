{
  "$comment": "The services a target talks to, each named once (ADR 0139). Every target resolves an address the same way: the command-line flag, then `env`, then each of `aliases` in order, then `default`. A Pages deployment writes `pagesRuntimeKey` into os-runtime-config.json, a Pages build reads `viteKey`, and Pages settings store it under `setting`. `listen` is what the server itself binds. An alias is an older name kept so existing deployments keep working; no source file outside this one may read an alias directly.",
  "endpoints": {
    "host": {
      "title": "Host API",
      "env": "OPENSESAME_HOST_API",
      "aliases": ["OPENSESAME_SERVER"],
      "default": "http://127.0.0.1:8787",
      "listen": {
        "env": "OPENSESAME_LISTEN",
        "aliases": [],
        "default": "127.0.0.1:8787"
      },
      "pagesRuntimeKey": "PAGES_HOST_API",
      "viteKey": "VITE_HOST_API",
      "setting": "hostApi",
      "loopbackOnly": false
    },
    "identity": {
      "title": "Identity API",
      "env": "OPENSESAME_IDENTITY_API",
      "aliases": ["OPENSESAME_API_URL", "OPENSESAME_IDENTITY_URL"],
      "default": "http://127.0.0.1:8788",
      "listen": {
        "env": "OPENSESAME_CONTROL_PLANE_PORT",
        "aliases": ["PORT"],
        "default": "8788"
      },
      "pagesRuntimeKey": "PAGES_IDENTITY_API",
      "viteKey": "VITE_IDENTITY_API",
      "setting": "identityApi",
      "loopbackOnly": false
    },
    "daemon": {
      "title": "Host agent",
      "env": "OPENSESAME_DAEMON_API",
      "aliases": ["OPENSESAME_DAEMON_URL"],
      "default": "http://127.0.0.1:18790",
      "listen": {
        "env": "OPENSESAME_DAEMON_LISTEN",
        "aliases": ["OPENSESAME_AGENT_LISTEN"],
        "default": "127.0.0.1:18790"
      },
      "pagesRuntimeKey": "PAGES_DAEMON_API",
      "viteKey": "VITE_DAEMON_API",
      "setting": "daemonApi",
      "loopbackOnly": true
    }
  }
}
