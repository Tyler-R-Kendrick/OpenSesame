FROM rust:1.88-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p opensesame-gateway
FROM debian:bookworm-slim
RUN useradd -u 10001 -m app && apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/opensesame-gateway /usr/local/bin/
USER 10001
EXPOSE 8787
ENTRYPOINT ["opensesame-gateway"]
