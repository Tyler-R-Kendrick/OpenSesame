FROM rust:1.88-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p opensesame-callback-edge
FROM debian:bookworm-slim
RUN useradd -u 10001 -m app
COPY --from=build /src/target/release/opensesame-callback-edge /usr/local/bin/
USER 10001
EXPOSE 8791
ENTRYPOINT ["opensesame-callback-edge"]
