{
  "name": "OpenSesame",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "containerEnv": {
    "DEVCONTAINER": "1",
    "MISE_DATA_DIR": "/opt/mise",
    "CARGO_TARGET_DIR": "/home/vscode/.cache/packages/cargo-target"
  },
  "forwardPorts": [8787, 8788, 18790],
  "onCreateCommand": "mise --version",
  "updateContentCommand": "mise install --locked && bash scripts/dev/dotfiles-bootstrap.sh && mise run deps",
  "postCreateCommand": "mise install --locked && bash scripts/dev/dotfiles-bootstrap.sh && mise run deps && bash scripts/dev/setup-hooks.sh",
  "postStartCommand": "bash scripts/dev/install-agent-skills.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer@0.4.3100",
        "tamasfe.even-better-toml@0.21.2",
        "biomejs.biome@2026.10.241124"
      ],
      "settings": {
        "terminal.integrated.env.linux": {
          "DEVCONTAINER": "1"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
