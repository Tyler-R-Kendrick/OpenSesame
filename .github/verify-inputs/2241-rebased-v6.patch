+    "format": "pkcs8",
+    "algorithm": "RSASSA-PKCS1-v1_5",
+    "hash": "SHA-256",
+    "usage": "sign",
+    "max_raw_length": 32768,
+    "pem_pattern": "^-----BEGIN PRIVATE KEY-----\\s*([A-Za-z0-9+/=\\s]{200,32768})-----END PRIVATE KEY-----\\s*$",
+    "escaped_newlines": true
+  },
+  "semantics": {
+    "regex_dialect": "ecmascript",
+    "length_unit": "utf16_code_units",
+    "pem_whitespace": "ecmascript",
