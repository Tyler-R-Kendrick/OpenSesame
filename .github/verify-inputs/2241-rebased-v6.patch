+    verifyNativeOAuthResource(receipt.connectionId, f.owner),
+  ).rejects.toMatchObject({ code: "scope" });
+  await expect(
+    verifyNativeOAuthMcpResource(receipt.connectionId, f.owner),
+  ).rejects.toMatchObject({ code: "scope" });
