diff --git a/packages/app-core/src/lib/native-google-wallet-configuration.ts b/packages/app-core/src/lib/native-google-wallet-configuration.ts
new file mode 100644
index 000000000..8962b1ea2
--- /dev/null
+++ b/packages/app-core/src/lib/native-google-wallet-configuration.ts
@@ -0,0 +1,48 @@
+import { base64ToBytes } from "./native-base64.js";
+import { GOOGLE_WALLET_CONFIGURATION_POLICY as POLICY } from "./native-google-wallet-policy.generated.js";
+
+const PEM = new RegExp(POLICY.key.pemPattern);
+
+export function validateGoogleWalletPublic(
+  parameters: Record<string, string>,
+): void {
+  const issuer = parameters.issuer_id ?? "";
+  const classId = parameters.class_id ?? "";
+  const email = parameters.service_account_email ?? "";
+  if (!new RegExp(POLICY.issuer.pattern).test(issuer))
+    throw new Error("Enter the numeric Google Wallet issuer id");
+  if (POLICY.walletClass.qualification !== "unqualified-or-this-issuer")
+    throw new Error("Unsupported Google Wallet class qualification");
+  const prefix = `${issuer}${POLICY.walletClass.issuerSeparator}`;
+  const qualified = classId.startsWith(prefix);
+  const suffix = qualified ? classId.slice(prefix.length) : classId;
+  if (
+    (classId.includes(POLICY.walletClass.issuerSeparator) && !qualified) ||
+    !new RegExp(POLICY.walletClass.suffixPattern).test(suffix)
+  )
+    throw new Error("Enter a Google Wallet class id belonging to this issuer");
+  if (
+    email.length > POLICY.email.maxLength ||
+    !new RegExp(POLICY.email.pattern).test(email)
+  )
+    throw new Error("Enter a valid service account email");
+}
+
+export async function validateGoogleWalletKey(raw: string): Promise<void> {
+  try {
+    if (raw.length > POLICY.key.maxRawLength) throw new Error("Key too large");
+    const pem = (
+      POLICY.key.escapedNewlines ? raw.replace(/\\n/g, "\n") : raw
+    ).trim();
+    const body = PEM.exec(pem)?.[1]?.replace(/\s+/g, "") ?? "";
+    await crypto.subtle.importKey(
+      POLICY.key.format,
+      base64ToBytes(body),
+      { name: POLICY.key.algorithm, hash: POLICY.key.hash },
+      false,
+      [POLICY.key.usage],
+    );
+  } catch {
+    throw new Error("Enter a valid PKCS#8 RSA private key");
+  }
+}
