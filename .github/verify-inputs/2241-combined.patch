+// Generated by scripts/emit-google-wallet-configuration.mjs from
+// spec/connectors/google-wallet-configuration.json — do not edit.
+export const GOOGLE_WALLET_CONFIGURATION_POLICY = Object.freeze({
+  issuer: Object.freeze({ pattern: "^\\d{6,32}$" }),
+  walletClass: Object.freeze({
+    qualification: "unqualified-or-this-issuer",
+    suffixPattern: "^[A-Za-z0-9._-]+$",
+    issuerSeparator: ".",
+  }),
+  email: Object.freeze({
+    pattern: "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
+    maxLength: 320,
+  }),
+  key: Object.freeze({
+    format: "pkcs8",
+    algorithm: "RSASSA-PKCS1-v1_5",
+    hash: "SHA-256",
+    usage: "sign",
+    maxRawLength: 32768,
+    pemPattern:
+      "^-----BEGIN PRIVATE KEY-----\\s*([A-Za-z0-9+/=\\s]{200,32768})-----END PRIVATE KEY-----\\s*$",
+    escapedNewlines: true,
+  }),
+});
