diff --git a/packages/agent-sandboxes/e2e/harness.ts b/packages/agent-sandboxes/e2e/harness.ts
new file mode 100644
index 000000000..33718714e
--- /dev/null
+++ b/packages/agent-sandboxes/e2e/harness.ts
@@ -0,0 +1,233 @@
+import {
+  type BrowserDriver,
+  BrowserStepExecutor,
+  type BrowserStepPorts,
+  CandidateCustody,
+  DurableJournal,
+  DurableResetRunner,
+  type HumanChallenge,
+  MemoryCheckpointJournal,
+  RESET_ACTIONS,
+  type ResetAction,
+  type ResetEffects,
+  type ResetRun,
+  fixedGrants,
+  resetAudience,
+  resetResource,
+} from "@opensesame/cua-password-reset";
+/** Runner wiring shared by every sandbox-provider e2e. */
+import type { AuthorityGrant } from "@opensesame/os-domain";
+import type { PasswordMethod } from "@opensesame/vault-core";
+import type { MockResetSite } from "./mock-site.js";
+
+export const PEPPER = "person-pepper";
+
+const method: PasswordMethod = {
+  id: "password-1",
+  type: "password",
+  generator: {
+    id: "derived",
+    counter: 1,
+    rules: {
+      length: 24,
+      lower: true,
+      upper: true,
+      digits: true,
+      symbols: true,
+      avoidAmbiguous: false,
+      minDigits: 1,
+      minSymbols: 1,
+    },
+  },
+  pepper: true,
+  pepperAt: "end",
+  secret: Buffer.alloc(32, 7).toString("base64"),
+  changedAt: "2026-10-27T00:00:00.000Z",
+};
+
+function grant(action: ResetAction, domain: string): AuthorityGrant {
+  const now = new Date();
+  return {
+    id: `grant:${action}`,
+    version: 1,
+    issuerPrincipalId: "person",
+    beneficiaryPrincipalId: "agent",
+    actorId: null,
+    clientId: null,
+    actorInstanceId: "agent-instance-1",
+    proofKeyThumbprint: "proof-key-1",
+    organizationId: "org",
+    projectId: null,
+    environmentId: null,
+    connectionId: null,
+    actions: [action],
+    resources: [resetResource(domain, "item-1")],
+    constraints: {
+      audiences: [resetAudience("run-1")],
+      notBefore: null,
+      expiresAt: new Date(now.getTime() + 600_000),
+      requiredAssurance: null,
+      authenticationMaxAgeSeconds: null,
+      allowedNetworks: [],
+      parameterRulesDigest: null,
+      budgets: {},
+      maximumDelegationDepth: 0,
+      offlineUse: "forbidden",
+      rawCredentialExport: false,
+    },
+    parentGrantId: null,
+    delegationDepth: 0,
+    createdAt: now,
+    revokedAt: null,
+  };
+}
+
+export function resetRun(site: MockResetSite, challenge = false): ResetRun {
+  const domain = new URL(site.origin).hostname;
+  return {
+    id: "run-1",
+    domain,
+    origin: site.origin,
+    itemId: "item-1",
+    transport: "cdp",
+    grantIds: Object.fromEntries(
+      RESET_ACTIONS.map((action) => [action, `grant:${action}`]),
+    ),
+    cursor: 0,
+    status: "running",
+    updatedAt: new Date().toISOString(),
+    recipe: {
+      schemaVersion: 1,
+      review: "approved",
+      domain,
+      entryPath: "/reset",
+      allowedOrigins: [site.origin],
+      steps: [
+        { id: "open", primitive: "navigate", path: "/reset" },
+        {
+          id: "identify",
+          primitive: "fill-field",
+          ref: "e1",
+          expectedLabel: "Email",
+          purpose: "identifier",
+        },
+        {
+          id: "request",
+          primitive: "click",
+          ref: "e2",
+          expectedLabel: "Send reset link",
+        },
+        { id: "mail", primitive: "await-email-link" },
+        ...(challenge
+          ? [{ id: "challenge", primitive: "await-human" as const }]
+          : []),
+        {
+          id: "password",
+          primitive: "fill-field",
+          ref: "e3",
+          expectedLabel: "New password",
+          purpose: "new-password",
+        },
+        {
+          id: "submit",
+          primitive: "submit",
+          ref: "e4",
+          expectedLabel: "Save password",
+        },
+        { id: "verify", primitive: "verify-login" },
+      ],
+    },
+  };
+}
+
+export function runtimeForDriver(
+  browser: BrowserDriver,
+  site: MockResetSite,
+  challenge = false,
+) {
+  const initial = resetRun(site, challenge);
+  const provider = fixedGrants(
+    Object.fromEntries(
+      RESET_ACTIONS.map((action) => [action, grant(action, initial.domain)]),
+    ),
+  );
+  const custody = new CandidateCustody(
+    method,
+    () => PEPPER,
+    () => {
+      const live = provider.grant("password_reset.password.produce", initial);
+      if (live.actions[0] !== "password_reset.password.produce")
+        throw new Error("Not authorized");
+    },
+  );
+  const challenges: HumanChallenge[] = [];
+  const verifyLogin = async (): Promise<boolean> =>
+    custody.withPassword(async (password) => {
+      const response = await fetch(`${site.origin}/login`, {
+        method: "POST",
+        redirect: "manual",
+        headers: { "content-type": "application/x-www-form-urlencoded" },
+        body: new URLSearchParams({
+          email: "person@example.test",
+          password,
+        }),
+      });
+      return response.headers.get("location") === "/account";
+    });
+  const ports: BrowserStepPorts = {
+    identifier: async () => "person@example.test",
+    mailbox: { resetLink: async () => site.resetLink() },
+    candidate: custody,
+    authorizeProxy: () => {
+      provider.grant("password_reset.proxy.substitute", initial);
+    },
+    takeover: {
+      handoff: async (seen) => {
+        challenges.push(seen);
+      },
+      resume: async () => {
+        await fetch(`${site.origin}/challenge/clear`, {
+          method: "POST",
+          redirect: "manual",
+        });
+        await browser.open(site.resetLink());
+      },
+    },
+    verifyLogin,
+  };
+  const executor = new BrowserStepExecutor(browser, ports);
+  const effects: ResetEffects = {
+    execute: (step, current, context) =>
+      executor.execute(step, current, context),
+    backupCandidate: async () => {},
+    verifyCandidate: async () =>
+      (await verifyLogin()) ? "verified" : "not_active",
+    promoteCandidate: async () => {},
+    compensate: async () => {
+      site.restorePassword();
+      return "compensated" as const;
+    },
+  };
+  const store = new MemoryCheckpointJournal();
+  const journal = new DurableJournal(store);
+  return {
+    initial,
+    custody,
+    challenges,
+    journal,
+    store,
+    runner: new DurableResetRunner(journal, effects, provider),
+  };
+}
+
+export async function expectNewPasswordAccepted(
+  custody: CandidateCustody,
+  site: MockResetSite,
+): Promise<void> {
+  const accepted = await custody.withPassword(async (password) =>
+    site.accepts(password),
+  );
+  if (!accepted) throw new Error("site does not accept the new password");
+  if (site.accepts("old-password"))
+    throw new Error("site still accepts the old password");
+}
diff --git a/packages/agent-sandboxes/e2e/mock-site.ts b/packages/agent-sandboxes/e2e/mock-site.ts
new file mode 100644
index 000000000..33afa8ff7
--- /dev/null
+++ b/packages/agent-sandboxes/e2e/mock-site.ts
@@ -0,0 +1,160 @@
+/**
+ * Minimal server-rendered reset site for sandbox-provider e2e. Same shape
+ * as the CUA mock (plain forms, token link, optional CAPTCHA gate) so all
+ * four provider lanes drive identical ceremonies.
+ */
+import { randomUUID } from "node:crypto";
+import {
+  type IncomingMessage,
+  type Server,
+  type ServerResponse,
+  createServer,
+} from "node:http";
+
+function page(response: ServerResponse, body: string): void {
+  response
+    .writeHead(200, { "content-type": "text/html; charset=utf-8" })
+    .end(`<!doctype html><html><body>${body}</body></html>`);
+}
+
+async function bodyText(request: IncomingMessage): Promise<string> {
+  const chunks: Buffer[] = [];
+  for await (const chunk of request) chunks.push(Buffer.from(chunk));
+  return Buffer.concat(chunks).toString("utf8");
+}
+
+export class MockResetSite {
+  private server: Server | undefined;
+  private password = "old-password";
+  private readonly token = randomUUID();
+  private challengePending = false;
+  origin = "";
+  submissions = 0;
+
+  async start(withChallenge = false): Promise<void> {
+    this.challengePending = withChallenge;
+    this.server = createServer((request, response) => {
+      void this.answer(request, response);
+    });
+    await new Promise<void>((resolve) =>
+      this.server?.listen(0, "127.0.0.1", resolve),
+    );
+    const address = this.server.address();
+    if (!address || !(address instanceof Object) || !("port" in address))
+      throw new Error("Mock site did not bind");
+    this.origin = `http://127.0.0.1:${address.port}`;
+  }
+
+  async stop(): Promise<void> {
+    const server = this.server;
+    this.server = undefined;
+    if (server)
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+
+  resetLink(): string {
+    return `${this.origin}/reset/link?token=${this.token}`;
+  }
+
+  accepts(password: string): boolean {
+    return this.password === password;
+  }
+
+  restorePassword(): void {
+    this.password = "old-password";
+  }
+
+  private async answer(
+    request: IncomingMessage,
+    response: ServerResponse,
+  ): Promise<void> {
+    const url = new URL(request.url ?? "/", this.origin);
+    if (request.method === "GET") return this.answerGet(url, response);
+    if (request.method === "POST")
+      return this.answerPost(url, request, response);
+    response.writeHead(404).end();
+  }
+
+  private answerGet(url: URL, response: ServerResponse): void {
+    switch (url.pathname) {
+      case "/reset":
+        page(
+          response,
+          `<form method="post" action="/request"><label>Email<input name="email" type="email"></label><button>Send reset link</button></form>`,
+        );
+        return;
+      case "/check-email":
+        page(response, "<main>Check your email for a reset link</main>");
+        return;
+      case "/reset/link": {
+        if (url.searchParams.get("token") !== this.token) {
+          page(response, "<main>Reset link expired</main>");
+          return;
+        }
+        const challenge = this.challengePending
+          ? `<p>CAPTCHA verify you are human</p><form method="post" action="/challenge/clear"><button>Challenge completed</button></form>`
+          : "";
+        page(
+          response,
+          `${challenge}<form method="post" action="/password"><input type="hidden" name="token" value="${this.token}"><label>New password<input name="password" type="password"></label><button>Save password</button></form>`,
+        );
+        return;
+      }
+      case "/login":
+        page(
+          response,
+          `<form method="post" action="/login"><label>Email<input name="email" type="email"></label><label>Password<input name="password" type="password"></label><button>Sign in</button></form>`,
+        );
+        return;
+      case "/account":
+        page(response, "<main>Signed in</main>");
+        return;
+      default:
+        response.writeHead(404).end();
+    }
+  }
+
+  private async answerPost(
+    url: URL,
+    request: IncomingMessage,
+    response: ServerResponse,
+  ): Promise<void> {
+    const values = new URLSearchParams(await bodyText(request));
+    switch (url.pathname) {
+      case "/request":
+        response.writeHead(303, { location: "/check-email" }).end();
+        return;
+      case "/challenge/clear":
+        this.challengePending = false;
+        response
+          .writeHead(303, {
+            location: `/reset/link?token=${this.token}`,
+          })
+          .end();
+        return;
+      case "/password": {
+        const next = values.get("password");
+        if (values.get("token") !== this.token || !next) {
+          page(response, "<main>Password was not updated</main>");
+          return;
+        }
+        this.password = next;
+        this.submissions += 1;
+        page(response, "<main>Password updated</main>");
+        return;
+      }
+      case "/login":
+        if (
+          values.get("email") === "person@example.test" &&
+          values.get("password") === this.password
+        ) {
+          response.writeHead(303, { location: "/account" }).end();
+          return;
+        }
+        page(response, "<main>Sign in failed</main>");
+        return;
+      default:
+        response.writeHead(404).end();
+    }
+  }
+}
diff --git a/packages/agent-sandboxes/e2e/relay.spec.ts b/packages/agent-sandboxes/e2e/relay.spec.ts
new file mode 100644
index 000000000..c1423671a
--- /dev/null
+++ b/packages/agent-sandboxes/e2e/relay.spec.ts
@@ -0,0 +1,56 @@
+import { expect, test } from "@playwright/test";
+import {
+  LocalSandboxProvider,
+  relayDriverOverWebSocket,
+  startRelayServer,
+} from "../src/index.js";
+import {
+  PEPPER,
+  expectNewPasswordAccepted,
+  runtimeForDriver,
+} from "./harness.js";
+import { MockResetSite } from "./mock-site.js";
+
+const executable = process.env.AGENT_BROWSER;
+if (!executable) throw new Error("AGENT_BROWSER is not configured");
+
+test("full reset through the driver relay, with a takeover pause", async () => {
+  const site = new MockResetSite();
+  await site.start(true);
+  const local = new LocalSandboxProvider({ executable });
+  const hosted = await local.allocate({ origin: site.origin });
+  const relay = await startRelayServer({
+    token: "relay-e2e-token",
+    driver: hosted.browser,
+  });
+  let relayClosedBrowser = false;
+  let phase = "initialize";
+  try {
+    const driver = relayDriverOverWebSocket(relay.url, {
+      token: "relay-e2e-token",
+    });
+    const runtime = runtimeForDriver(driver, site, true);
+    phase = "start";
+    const parked = await runtime.runner.start(runtime.initial);
+    expect(parked.status).toBe("awaiting_human");
+    expect(runtime.challenges).toEqual(["captcha"]);
+    phase = "resume";
+    const finished = await runtime.runner.resumeAfterHuman(parked);
+    expect(finished.status).toBe("succeeded");
+    expect(site.submissions).toBe(1);
+    phase = "verify";
+    await expectNewPasswordAccepted(runtime.custody, site);
+    const journalText = JSON.stringify(await runtime.store.load("run-1"));
+    expect(journalText).not.toContain(PEPPER);
+    phase = "close";
+    await driver.close();
+    relayClosedBrowser = true;
+  } catch (error) {
+    process.stderr.write(`relay e2e failure phase: ${phase}\n`);
+    throw error;
+  } finally {
+    await relay.close().catch(() => {});
+    if (!relayClosedBrowser) await hosted.close().catch(() => {});
+    await site.stop().catch(() => {});
+  }
+});
diff --git a/packages/agent-sandboxes/e2e/wasm.spec.ts b/packages/agent-sandboxes/e2e/wasm.spec.ts
