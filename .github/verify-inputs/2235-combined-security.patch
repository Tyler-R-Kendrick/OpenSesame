@@ -0,0 +1,364 @@
+import { type Server, createServer } from "node:http";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import {
+  type RunningVirtualNetworkRelay,
+  startVirtualNetworkRelay,
+} from "./vnet-server.js";
+import { virtualFetchOverHttp } from "./vnet.js";
+
+describe("virtual network relay", () => {
+  let target: Server;
+  let targetPort = 0;
+  let relay: RunningVirtualNetworkRelay;
+
+  beforeAll(async () => {
+    target = createServer((request, response) => {
+      if (request.url === "/start") {
+        response.writeHead(303, {
+          location: "/final",
+          "set-cookie": "session=abc; Path=/",
+        });
+        response.end();
+        return;
+      }
+      response
+        .writeHead(200, { "content-type": "text/plain" })
+        .end(`cookie:${request.headers.cookie ?? ""} method:${request.method}`);
+    });
+    await new Promise<void>((resolve) => {
+      target.listen(0, "127.0.0.1", resolve);
+    });
+    const address = target.address();
+    targetPort =
+      address instanceof Object && "port" in address ? address.port : 0;
+    relay = await startVirtualNetworkRelay({
+      token: "relay-token",
+      allowLoopbackTargets: true,
+    });
+  });
+
+  afterAll(async () => {
+    await relay.close();
+    await new Promise<void>((resolve) => target.close(() => resolve()));
+  });
+
+  it("follows redirects relay-side and carries cookies per session", async () => {
+    const virtualFetch = virtualFetchOverHttp(relay.url, "relay-token");
+    const result = await virtualFetch({
+      sessionId: "s1",
+      url: `http://127.0.0.1:${targetPort}/start`,
+      method: "POST",
+      body: "payload",
+    });
+    expect(result.status).toBe(200);
+    expect(result.url).toBe(`http://127.0.0.1:${targetPort}/final`);
+    expect(result.bodyText).toBe("cookie:session=abc method:GET");
+    // A different session does not inherit the cookie.
+    const other = await virtualFetch({
+      sessionId: "s2",
+      url: `http://127.0.0.1:${targetPort}/final`,
+      method: "GET",
+    });
+    expect(other.bodyText).toBe("cookie: method:GET");
+  });
+
+  it("pins a session to its first host when no allowlist is given", async () => {
+    const virtualFetch = virtualFetchOverHttp(relay.url, "relay-token");
+    await virtualFetch({
+      sessionId: "s3",
+      url: `http://127.0.0.1:${targetPort}/final`,
+      method: "GET",
+    });
+    await expect(
+      virtualFetch({
+        sessionId: "s3",
+        url: "http://example.com/final",
+        method: "GET",
+      }),
+    ).rejects.toThrow(/refused/u);
+  });
+
+  it("requires the relay token", async () => {
+    const virtualFetch = virtualFetchOverHttp(relay.url, "wrong");
+    await expect(
+      virtualFetch({
+        sessionId: "s4",
+        url: `http://127.0.0.1:${targetPort}/final`,
+        method: "GET",
+      }),
+    ).rejects.toThrow("refused (401)");
+  });
+});
+
+describe("virtual network boundaries", () => {
+  it("refuses plaintext non-loopback relay transport", () => {
+    expect(() =>
+      virtualFetchOverHttp("http://relay.example.test", "token"),
+    ).toThrow(/HTTPS/u);
+    expect(() =>
+      virtualFetchOverHttp("https://user:pass@relay.example.test", "token"),
+    ).toThrow(/HTTPS/u);
+    expect(() =>
+      virtualFetchOverHttp("http://localhost:4000", "token"),
+    ).toThrow(/HTTPS/u);
+  });
+
+  it("refuses plaintext listeners outside literal loopback", async () => {
+    await expect(
+      startVirtualNetworkRelay({ token: "token", host: "0.0.0.0" }),
+    ).rejects.toThrow(/literal loopback/u);
+    await expect(
+      startVirtualNetworkRelay({ token: "token", host: "localhost" }),
+    ).rejects.toThrow(/literal loopback/u);
+    await expect(startVirtualNetworkRelay({ token: "" })).rejects.toThrow(
+      /token/u,
+    );
+  });
+
+  it("does not follow cross-origin redirects or allow a session policy to widen", async () => {
+    let received = 0;
+    const sink = createServer((_request, response) => {
+      received += 1;
+      response.end();
+    });
+    await new Promise<void>((resolve) => sink.listen(0, "127.0.0.1", resolve));
+    const sinkAddress = sink.address();
+    if (!sinkAddress || typeof sinkAddress === "string")
+      throw new Error("sink failed");
+    const sinkOrigin = `http://127.0.0.1:${sinkAddress.port}`;
+    const source = createServer((_request, response) =>
+      response.writeHead(307, { location: `${sinkOrigin}/capture` }).end(),
+    );
+    await new Promise<void>((resolve) =>
+      source.listen(0, "127.0.0.1", resolve),
+    );
+    const sourceAddress = source.address();
+    if (!sourceAddress || typeof sourceAddress === "string")
+      throw new Error("source failed");
+    const sourceOrigin = `http://127.0.0.1:${sourceAddress.port}`;
+    const relay = await startVirtualNetworkRelay({
+      token: "token",
+      allowLoopbackTargets: true,
+    });
+    const fetch = virtualFetchOverHttp(relay.url, "token");
+    try {
+      await expect(
+        fetch({
+          sessionId: "redirect",
+          url: sourceOrigin,
+          method: "POST",
+          body: "password-canary",
+          allowedOrigins: [sourceOrigin, sinkOrigin],
+        }),
+      ).rejects.toThrow(/refused/u);
+      expect(received).toBe(0);
+      await expect(
+        fetch({
+          sessionId: "redirect",
+          url: sinkOrigin,
+          method: "GET",
+          allowedOrigins: [sinkOrigin],
+        }),
+      ).rejects.toThrow(/refused/u);
+      expect(received).toBe(0);
+    } finally {
+      await relay.close();
+      await new Promise<void>((resolve) => source.close(() => resolve()));
+      await new Promise<void>((resolve) => sink.close(() => resolve()));
+    }
+  });
+});
+
+describe("session lifecycle and redirects", () => {
+  it("closes authenticated sessions and expires idle sessions while preserving active resume", async () => {
+    let clock = 0;
+    const targetFetch: typeof globalThis.fetch = async (_url, init) =>
+      new Response(new Headers(init?.headers).get("cookie") ?? "", {
+        headers: { "set-cookie": "session=abc; Path=/; Secure" },
+      });
+    const relay = await startVirtualNetworkRelay({
+      token: "token",
+      sessionIdleTtlMs: 1000,
+      now: () => clock,
+      fetchImpl: targetFetch,
+    });
+    const fetch = virtualFetchOverHttp(relay.url, "token");
+    const request = (sessionId: string) => ({
+      sessionId,
+      url: "https://accounts.test/",
+      method: "GET",
+    });
+    try {
+      for (let i = 0; i < 500; i += 1) await fetch(request(`session-${i}`));
+      await expect(fetch(request("overflow"))).rejects.toThrow(/refused/u);
+      const unauthorized = await globalThis.fetch(`${relay.url}/close`, {
+        method: "POST",
+        headers: {
+          authorization: "Bearer wrong",
+          "content-type": "application/json",
+        },
+        body: JSON.stringify({ sessionId: "session-0" }),
+      });
+      expect(unauthorized.status).toBe(401);
+      await fetch.closeSession?.("session-1");
+      await fetch(request("overflow"));
+      clock = 500;
+      expect((await fetch(request("session-0"))).bodyText).toBe("session=abc");
+      clock = 1001;
+      await fetch(request("new"));
+      expect((await fetch(request("session-0"))).bodyText).toBe("session=abc");
+      expect((await fetch(request("session-2"))).bodyText).toBe("");
+      expect((await fetch(request("session-1"))).bodyText).toBe("");
+    } finally {
+      await relay.close();
+    }
+  }, 20_000);
+
+  it("keeps in-flight sessions until completion after close", async () => {
+    let release: (() => void) | undefined;
+    let started: (() => void) | undefined;
+    const entered = new Promise<void>((resolve) => {
+      started = resolve;
+    });
+    const targetFetch: typeof globalThis.fetch = async () => {
+      started?.();
+      await new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      return new Response("done");
+    };
+    const relay = await startVirtualNetworkRelay({
+      token: "token",
+      fetchImpl: targetFetch,
+    });
+    const fetch = virtualFetchOverHttp(relay.url, "token");
+    const request = {
+      sessionId: "active",
+      url: "https://accounts.test/",
+      method: "GET",
+    };
+    try {
+      const inFlight = fetch(request);
+      await entered;
+      await fetch.closeSession?.("active");
+      await expect(fetch(request)).rejects.toThrow(/refused/u);
+      release?.();
+      expect((await inFlight).bodyText).toBe("done");
+    } finally {
+      release?.();
+      await relay.close();
+    }
+  });
+
+  it("allows an approved cross-origin redirect without forwarding body or headers and refuses downgrade", async () => {
+    const seen: Array<{
+      url: string;
+      method: string;
+      body: BodyInit | null | undefined;
+      headers: Headers;
+    }> = [];
+    let downgrade = false;
+    const targetFetch: typeof globalThis.fetch = async (input, init) => {
+      const url = input.toString();
+      seen.push({
+        url,
+        method: init?.method ?? "",
+        body: init?.body,
+        headers: new Headers(init?.headers),
+      });
+      if (url.startsWith("https://rp.test"))
+        return new Response(null, {
+          status: 302,
+          headers: {
+            location: downgrade
+              ? "http://127.0.0.1:9999/"
+              : "https://idp.test/",
+          },
+        });
+      return new Response("ok");
+    };
+    const relay = await startVirtualNetworkRelay({
+      token: "token",
+      fetchImpl: targetFetch,
+    });
+    const fetch = virtualFetchOverHttp(relay.url, "token");
+    const allowedOrigins = [
+      "https://rp.test",
+      "https://idp.test",
+      "http://127.0.0.1:9999",
+    ];
+    try {
+      const result = await fetch({
+        sessionId: "flow",
+        url: "https://rp.test/",
+        method: "POST",
+        body: "password-canary",
+        headers: { "content-type": "application/x-www-form-urlencoded" },
+        allowedOrigins,
+      });
+      expect(result.bodyText).toBe("ok");
+      expect(seen[1]?.method).toBe("GET");
+      expect(seen[1]?.body).toBeUndefined();
+      expect(seen[1]?.headers.has("content-type")).toBe(false);
+      expect(seen[1]?.headers.has("cookie")).toBe(false);
+      downgrade = true;
+      await expect(
+        fetch({
+          sessionId: "downgrade",
+          url: "https://rp.test/",
+          method: "POST",
+          body: "password-canary",
+          allowedOrigins,
+        }),
+      ).rejects.toThrow(/refused/u);
+      expect(
+        seen.some((entry) => entry.url.startsWith("http://127.0.0.1")),
+      ).toBe(false);
+    } finally {
+      await relay.close();
+    }
+  });
+
+  it("does not replay a secret-bearing relay RPC across HTTP redirects", async () => {
+    let captured = 0;
+    const sink = createServer((_request, response) => {
+      captured += 1;
+      response.end();
+    });
+    await new Promise<void>((resolve) => sink.listen(0, "127.0.0.1", resolve));
+    const sinkAddress = sink.address();
+    if (!sinkAddress || typeof sinkAddress === "string")
+      throw new Error("sink failed");
+    const redirector = createServer((_request, response) =>
+      response
+        .writeHead(307, {
+          location: `http://127.0.0.1:${sinkAddress.port}/capture`,
+        })
+        .end(),
+    );
+    await new Promise<void>((resolve) =>
+      redirector.listen(0, "127.0.0.1", resolve),
+    );
+    const address = redirector.address();
+    if (!address || typeof address === "string")
+      throw new Error("redirector failed");
+    try {
+      const fetch = virtualFetchOverHttp(
+        `http://127.0.0.1:${address.port}`,
+        "secret-token",
+      );
+      await expect(
+        fetch({
+          sessionId: "run",
+          url: "https://rp.test/",
+          method: "POST",
+          body: "password-canary",
+        }),
+      ).rejects.toThrow();
+      expect(captured).toBe(0);
+    } finally {
+      await new Promise<void>((resolve) => redirector.close(() => resolve()));
+      await new Promise<void>((resolve) => sink.close(() => resolve()));
+    }
+  });
+});
diff --git a/packages/agent-sandboxes/src/vnet-server.ts b/packages/agent-sandboxes/src/vnet-server.ts
new file mode 100644
index 000000000..551f25bec
--- /dev/null
+++ b/packages/agent-sandboxes/src/vnet-server.ts
@@ -0,0 +1,375 @@
+/**
+ * Reference virtual-network relay: performs the real HTTP requests for
+ * WASM-hosted drivers, one cookie jar per session, redirects followed
+ * relay-side. This is user-controlled infrastructure by design — it sees
+ * reset traffic in plaintext, so it must never be a shared public proxy.
+ * The bearer token grants access to all sessions: use it only among mutually
+ * trusted clients. Session IDs and cookie jars do not provide tenant isolation.
+ * Origins are bound on first use and
+ * redirects stay within the session's approved origins. DNS uses checked, pinned
+ * IPv4 addresses; loopback target access is an explicit development option.
+ */
+
+import {
+  type IncomingMessage,
+  type Server,
+  type ServerResponse,
+  createServer,
+} from "node:http";
+import { CookieJar } from "./vnet-cookie-jar.js";
+import { pinnedFetch } from "./vnet-pinned-fetch.js";
+import {
+  type VirtualFetchRequest,
+  type VirtualFetchResponse,
+  virtualFetchRequestSchema,
+} from "./vnet.js";
+
+export interface VirtualNetworkRelayOptions {
+  port?: number;
+  host?: string;
+  token: string;
+  /** Additional server-wide hostname restriction; session origins still apply. */
+  allowedDomains?: readonly string[];
+  /** Test/development only: allow literal localhost and 127.0.0.1 targets. */
+  allowLoopbackTargets?: boolean;
+  /** Idle sessions expire after this interval; default 30 minutes, maximum one day. */
+  sessionIdleTtlMs?: number;
+  /** Trusted monotonic clock override for tests. */
+  now?: () => number;
+  /** Trusted transport override; the caller is responsible for destination enforcement. */
+  fetchImpl?: typeof fetch;
+}
+
+export interface RunningVirtualNetworkRelay {
+  url: string;
+  port: number;
+  close(): Promise<void>;
+}
+
+type Session = {
+  jar: CookieJar;
+  origins: string[];
+  lastUsed: number;
+  active: number;
+  closing: boolean;
+};
+
+type RelayContext = {
+  options: VirtualNetworkRelayOptions;
+  sessions: Map<string, Session>;
+  ttl: number;
+  now: () => number;
+  allowed: ReadonlySet<string>;
+  fetchImpl: typeof fetch;
+};
+
+function normalizedOrigin(value: string): string {
+  const url = new URL(value);
+  const loopback = ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
+  if (
+    url.username ||
+    url.password ||
+    (url.protocol !== "https:" && !(url.protocol === "http:" && loopback))
+  )
+    throw new Error(
+      "virtual network: only HTTPS or loopback HTTP is permitted",
+    );
+  return url.origin;
+}
+
+function assertAllowed(
+  url: URL,
+  allowed: ReadonlySet<string>,
+  session: Session,
+): void {
+  if (allowed.size > 0 && !allowed.has(url.hostname))
+    throw new Error("virtual network: host is not allowlisted");
+  if (!session.origins.includes(normalizedOrigin(url.href)))
+    throw new Error("virtual network: origin is not allowed for this session");
+}
+
+function redirectTarget(
+  response: Response,
+  url: URL,
+  method: string,
+  body: string | undefined,
+): { url: URL; method: string; body: string | undefined } | null {
+  const location = response.headers.get("location");
+  if (![301, 302, 303, 307, 308].includes(response.status) || !location)
+    return null;
+  const next = { url: new URL(location, url), method, body };
+  if (
+    response.status === 303 ||
+    response.status === 301 ||
+    response.status === 302
+  ) {
+    if (method !== "GET" && method !== "HEAD") {
+      next.method = "GET";
+      next.body = undefined;
+    }
+  }
+  return next;
+}
+
+function requestHeaders(
+  request: VirtualFetchRequest,
+  forward: boolean,
+  jar: CookieJar,
+  url: URL,
+): Record<string, string> {
+  const headers: Record<string, string> = {};
+  for (const [name, value] of Object.entries(
+    forward ? (request.headers ?? {}) : {},
+  )) {
+    const lower = name.toLowerCase();
+    if (!["accept", "accept-language", "content-type"].includes(lower))
+      throw new Error("virtual network: request header is not permitted");
+    headers[lower] = value;
+  }
+  const cookies = jar.header(url);
+  if (cookies) headers.cookie = cookies;
+  return headers;
+}
+
+function isCrossOriginRedirect(
+  redirect: { url: URL; method: string },
+  url: URL,
+  allowed: ReadonlySet<string>,
+  session: Session,
+): boolean {
+  if (normalizedOrigin(redirect.url.href) === normalizedOrigin(url.href))
+    return false;
+  assertAllowed(redirect.url, allowed, session);
+  if (
+    (url.protocol === "https:" && redirect.url.protocol !== "https:") ||
+    (redirect.method !== "GET" && redirect.method !== "HEAD")
+  )
+    throw new Error("virtual network: unsafe cross-origin redirect");
+  return true;
+}
+
+async function performFetch(
+  fetchImpl: typeof fetch,
+  jar: CookieJar,
+  allowed: ReadonlySet<string>,
+  session: Session,
+  request: VirtualFetchRequest,
+): Promise<VirtualFetchResponse> {
+  let url = new URL(request.url);
+  let method = request.method.toUpperCase();
+  let body = request.body;
+  let forwardRequestHeaders = true;
+  for (let hop = 0; hop <= 10; hop += 1) {
+    assertAllowed(url, allowed, session);
+    const headers = requestHeaders(request, forwardRequestHeaders, jar, url);
+    const init: RequestInit = { method, headers, redirect: "manual" };
+    if (body !== undefined && method !== "GET" && method !== "HEAD")
+      init.body = body;
+    const response = await fetchImpl(url, init);
+    jar.store(url, response.headers);
+    const redirect = redirectTarget(response, url, method, body);
+    if (redirect) {
+      if (isCrossOriginRedirect(redirect, url, allowed, session)) {
+        forwardRequestHeaders = false;
+        redirect.body = undefined;
+      }
+      url = redirect.url;
+      method = redirect.method;
+      body = redirect.body;
+      continue;
+    }
+    const responseHeaders: Record<string, string> = {};
+    response.headers.forEach((value, key) => {
+      if (key !== "set-cookie") responseHeaders[key] = value;
+    });
+    return {
+      status: response.status,
+      url: url.href,
+      headers: responseHeaders,
+      bodyText: await response.text(),
+    };
+  }
+  throw new Error("virtual network: too many redirects");
+}
+
+async function readRequestBody(
+  request: IncomingMessage,
+  response: ServerResponse,
+): Promise<string | null> {
+  const chunks: Buffer[] = [];
+  let length = 0;
+  try {
+    for await (const chunk of request) {
+      const bytes = Buffer.from(chunk);
+      length += bytes.length;
+      if (length > 1_000_000) {
+        response.writeHead(413).end();
+        return null;
+      }
+      chunks.push(bytes);
+    }
+  } catch {
+    response.destroy();
+    return null;
+  }
+  return Buffer.concat(chunks).toString("utf8");
+}
+
+function closeSession(data: unknown, sessions: Map<string, Session>): void {
+  if (
+    !data ||
+    typeof data !== "object" ||
+    !("sessionId" in data) ||
+    typeof data.sessionId !== "string" ||
+    !data.sessionId ||
+    data.sessionId.length > 128
+  )
+    throw new Error("virtual network: invalid session id");
+  const session = sessions.get(data.sessionId);
+  if (session) {
+    session.closing = true;
+    if (session.active === 0) sessions.delete(data.sessionId);
+  }
+}
+
+function sessionFor(
+  parsed: VirtualFetchRequest,
+  context: RelayContext,
+): Session {
+  const currentTime = context.now();
+  for (const [id, existing] of context.sessions) {
+    if (
+      existing.active === 0 &&
+      (existing.closing || currentTime - existing.lastUsed >= context.ttl)
+    )
+      context.sessions.delete(id);
+  }
+  const origins = [
+    ...new Set((parsed.allowedOrigins ?? [parsed.url]).map(normalizedOrigin)),
+  ].sort();
+  let session = context.sessions.get(parsed.sessionId);
+  if (!session) {
+    if (context.sessions.size >= 500)
+      throw new Error("virtual network: session limit reached");
+    session = {
+      jar: new CookieJar(),
+      origins,
+      lastUsed: currentTime,
+      active: 0,
+      closing: false,
+    };
+    context.sessions.set(parsed.sessionId, session);
+  } else if (session.closing) {
+    throw new Error("virtual network: session is closing");
+  } else if (
+    parsed.allowedOrigins &&
+    JSON.stringify(origins) !== JSON.stringify(session.origins)
+  ) {
+    throw new Error("virtual network: session policy changed");
+  }
+  return session;
+}
+
+async function fetchSession(
+  parsed: VirtualFetchRequest,
+  context: RelayContext,
+): Promise<VirtualFetchResponse> {
+  const session = sessionFor(parsed, context);
+  session.active += 1;
+  try {
+    return await performFetch(
+      context.fetchImpl,
+      session.jar,
+      context.allowed,
+      session,
+      parsed,
+    );
+  } finally {
+    session.active -= 1;
+    session.lastUsed = context.now();
+    if (session.closing && session.active === 0)
+      context.sessions.delete(parsed.sessionId);
+  }
+}
+
+async function handleRequest(
+  request: IncomingMessage,
+  response: ServerResponse,
+  context: RelayContext,
+): Promise<void> {
+  if (
+    request.method !== "POST" ||
+    !["/fetch", "/close"].includes(request.url ?? "")
+  ) {
+    response.writeHead(404).end();
+    return;
+  }
+  if (request.headers.authorization !== `Bearer ${context.options.token}`) {
+    response.writeHead(401).end();
+    return;
+  }
+  const body = await readRequestBody(request, response);
+  if (body === null) return;
+  try {
+    const data: unknown = JSON.parse(body);
+    if (request.url === "/close") {
+      closeSession(data, context.sessions);
+      response.writeHead(204).end();
+      return;
+    }
+    const parsed = virtualFetchRequestSchema.parse(data);
+    const result = await fetchSession(parsed, context);
+    response
+      .writeHead(200, { "content-type": "application/json" })
+      .end(JSON.stringify(result));
+  } catch (error) {
+    response.writeHead(502, { "content-type": "application/json" }).end(
+      JSON.stringify({
+        error: error instanceof Error ? error.message : "fetch failed",
+      }),
+    );
+  }
+}
+
+export async function startVirtualNetworkRelay(
+  options: VirtualNetworkRelayOptions,
+): Promise<RunningVirtualNetworkRelay> {
+  const host = options.host ?? "127.0.0.1";
+  if (host !== "127.0.0.1" && host !== "::1")
+    throw new Error(
+      "virtual network: plaintext listener must bind literal loopback",
+    );
+  if (!options.token) throw new Error("virtual network: token is required");
+  const sessions = new Map<string, Session>();
+  const ttl = options.sessionIdleTtlMs ?? 30 * 60_000;
+  if (!Number.isInteger(ttl) || ttl < 1 || ttl > 24 * 60 * 60_000)
+    throw new Error("virtual network: invalid session idle timeout");
+  const now = options.now ?? (() => performance.now());
+  const allowed = new Set(options.allowedDomains ?? []);
+  const fetchImpl =
+    options.fetchImpl ?? pinnedFetch(options.allowLoopbackTargets === true);
+  const context: RelayContext = {
+    options,
+    sessions,
+    ttl,
+    now,
+    allowed,
+    fetchImpl,
+  };
+  const server: Server = createServer((request, response) => {
+    void handleRequest(request, response, context);
+  });
+  await new Promise<void>((resolve) => {
+    server.listen(options.port ?? 0, host, resolve);
+  });
+  const address = server.address();
+  const port =
+    address instanceof Object && "port" in address ? address.port : 0;
+  return {
+    url: `http://${host === "::1" ? "[::1]" : host}:${port}`,
+    port,
+    close: async () => {
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+    },
+  };
+}
diff --git a/packages/agent-sandboxes/src/vnet.ts b/packages/agent-sandboxes/src/vnet.ts
new file mode 100644
index 000000000..181985570
--- /dev/null
+++ b/packages/agent-sandboxes/src/vnet.ts
@@ -0,0 +1,96 @@
+/**
+ * Virtualized networking for the WASM lane.
+ *
+ * A WASM/browser-hosted DOM driver cannot open sockets to the target site
+ * (no raw TCP, and the same-origin policy stands in the way), so every
+ * fetch it makes is an RPC to a relay: the relay performs the real request
+ * (cookies and redirects included, per session) and returns the final
+ * response. The driver only ever talks to its relay; the relay is the
+ * only party that sees the target site, which is why it must be
+ * user-controlled infrastructure, never a shared public proxy.
+ */
+
+import { z } from "zod";
+
+export interface VirtualFetchRequest {
+  sessionId: string;
+  url: string;
+  method: string;
+  /** Immutable origins authorized for this session by the caller. */
+  allowedOrigins?: readonly string[] | undefined;
+  headers?: Record<string, string> | undefined;
+  body?: string | undefined;
+}
+
+export interface VirtualFetchResponse {
+  status: number;
+  /** Final URL after relay-side redirect following. */
+  url: string;
+  headers: Record<string, string>;
+  bodyText: string;
+}
+
+export type VirtualFetch = ((
+  request: VirtualFetchRequest,
+) => Promise<VirtualFetchResponse>) & {
+  closeSession?: (sessionId: string) => Promise<void>;
+};
+
+export const virtualFetchRequestSchema = z.object({
+  sessionId: z.string().min(1).max(128),
+  url: z.string().url().max(2048),
+  method: z.enum(["GET", "HEAD", "POST"]),
+  allowedOrigins: z.array(z.string().url().max(2048)).min(1).max(32).optional(),
+  headers: z.record(z.string(), z.string()).optional(),
+  body: z.string().optional(),
+});
+
+const virtualFetchResponseSchema = z.object({
+  status: z.number(),
+  url: z.string(),
+  headers: z.record(z.string(), z.string()),
+  bodyText: z.string(),
+});
+
+/** HTTP client side of the virtual-network relay (global `fetch` only). */
+export function virtualFetchOverHttp(
+  relayUrl: string,
+  token: string,
+): VirtualFetch {
+  const base = new URL(relayUrl);
+  const loopback = ["127.0.0.1", "[::1]"].includes(base.hostname);
+  if (
+    base.username ||
+    base.password ||
+    base.search ||
+    base.hash ||
+    (base.protocol !== "https:" && !(base.protocol === "http:" && loopback)) ||
+    !token
+  )
+    throw new Error(
+      "virtual network relay requires HTTPS or loopback HTTP and a token",
+    );
+  const endpoint = base.href.replace(/\/$/u, "");
+  const send = async (path: string, body: unknown) => {
+    const response = await fetch(`${endpoint}${path}`, {
+      method: "POST",
+      headers: {
+        authorization: `Bearer ${token}`,
+        "content-type": "application/json",
+      },
+      body: JSON.stringify(body),
+      redirect: "error",
+    });
+    if (!response.ok)
+      throw new Error(`virtual network relay refused (${response.status})`);
+    return response;
+  };
+  const virtualFetch: VirtualFetch = async (request) =>
+    virtualFetchResponseSchema.parse(
+      await (await send("/fetch", request)).json(),
+    );
+  virtualFetch.closeSession = async (sessionId) => {
+    await send("/close", { sessionId });
+  };
+  return virtualFetch;
+}
diff --git a/packages/agent-sandboxes/src/wasm-dom-driver.test.ts b/packages/agent-sandboxes/src/wasm-dom-driver.test.ts
new file mode 100644
index 000000000..949e2585f
--- /dev/null
+++ b/packages/agent-sandboxes/src/wasm-dom-driver.test.ts
@@ -0,0 +1,110 @@
+import { describe, expect, it } from "vitest";
+import type { VirtualFetch, VirtualFetchRequest } from "./vnet.js";
+import { WasmDomDriver } from "./wasm-dom-driver.js";
+
+const FORM_PAGE = `<!doctype html><html><body>
+  <form method="post" action="/reset/submit">
+    <label>Email <input name="email" type="email"></label>
+    <label>New password <input name="password" type="password"></label>
+    <button>Save password</button>
+  </form>
+</body></html>`;
+
+type RecordedRequest = { url: string; method: string; body?: string };
+
+function memoryFetch(pageEntries: ReadonlyArray<readonly [string, string]>) {
+  const pages = new Map(pageEntries);
+  const requests: RecordedRequest[] = [];
+  return {
+    requests,
+    virtualFetch: async (request: VirtualFetchRequest) => {
+      const recorded: RecordedRequest = {
+        url: request.url,
+        method: request.method,
+      };
+      if (request.body !== undefined) recorded.body = request.body;
+      requests.push(recorded);
+      const page = pages.get(new URL(request.url).pathname);
+      return {
+        status: page ? 200 : 404,
+        url: request.url,
+        headers: {},
+        bodyText: page ?? "<html><body>missing</body></html>",
+      };
+    },
+  };
+}
+
+function driverFor(virtualFetch: VirtualFetch): WasmDomDriver {
+  return new WasmDomDriver({
+    virtualFetch,
+    sessionId: "test-session",
+    allowedDomains: ["accounts.example.test"],
+  });
+}
+
+describe("WasmDomDriver", () => {
+  it("snapshots form fields with labels and kinds", async () => {
+    const { virtualFetch } = memoryFetch([["/reset", FORM_PAGE]]);
+    const driver = driverFor(virtualFetch);
+    await driver.open("https://accounts.example.test/reset");
+    const snapshot = await driver.snapshot();
+    expect(snapshot.origin).toBe("https://accounts.example.test");
+    expect(snapshot.fields).toEqual([
+      { ref: "e1", kind: "email", label: "Email" },
+      { ref: "e2", kind: "password", label: "New password" },
+      { ref: "e3", kind: "button", label: "Save password" },
+    ]);
+  });
+
+  it("fills and submits a form through the virtual network only", async () => {
+    const { virtualFetch, requests } = memoryFetch([
+      ["/reset", FORM_PAGE],
+      ["/reset/submit", "<html><body>Password updated</body></html>"],
+    ]);
+    const driver = driverFor(virtualFetch);
+    await driver.open("https://accounts.example.test/reset");
+    await driver.fill("e1", "person@example.test");
+    await driver.fillSecret("e2", "candidate-pepper-value");
+    await driver.click("e3");
+    const submission = requests.find((r) => r.method === "POST");
+    expect(submission?.url).toBe("https://accounts.example.test/reset/submit");
+    expect(submission?.body).toContain("email=person%40example.test");
+    expect(submission?.body).toContain("password=candidate-pepper-value");
+    expect(await driver.pageUrl()).toContain("/reset/submit");
+    // The secret never appears in an observation.
+    expect(JSON.stringify(await driver.snapshot())).not.toContain(
+      "candidate-pepper-value",
+    );
+  });
+
+  it("surfaces an active challenge as static, but not branding", async () => {
+    const { virtualFetch } = memoryFetch([
+      [
+        "/reset",
+        "<html><body><p>CAPTCHA verify you are human</p><p>This site is protected by reCAPTCHA</p></body></html>",
+      ],
+      [
+        "/plain",
+        "<html><body><p>This site is protected by reCAPTCHA</p></body></html>",
+      ],
+    ]);
+    const driver = driverFor(virtualFetch);
+    await driver.open("https://accounts.example.test/reset");
+    expect((await driver.snapshot()).fields).toContainEqual({
+      ref: "e1",
+      kind: "static",
+      label: "CAPTCHA verify you are human",
+    });
+    await driver.open("https://accounts.example.test/plain");
+    expect((await driver.snapshot()).fields).toEqual([]);
+  });
+
+  it("refuses navigation outside the allowlist", async () => {
+    const { virtualFetch } = memoryFetch([]);
+    const driver = driverFor(virtualFetch);
+    await expect(driver.open("https://evil.example.test/")).rejects.toThrow(
+      "approved domains",
+    );
+  });
+});
diff --git a/packages/agent-sandboxes/src/wasm-dom-driver.ts b/packages/agent-sandboxes/src/wasm-dom-driver.ts
new file mode 100644
index 000000000..e301b0441
--- /dev/null
+++ b/packages/agent-sandboxes/src/wasm-dom-driver.ts
@@ -0,0 +1,275 @@
+/**
+ * The WASM-lane browser driver: a DOM-level driver with **no direct
+ * network access**. Pages are fetched through the virtual-network relay
+ * (`VirtualFetch`), parsed locally, and forms are filled/submitted as
+ * serialized DOM state. The same code runs in Node (tests), a browser
+ * tab, or a WASM host — only `linkedom` and the relay port are needed.
+ *
+ * Honest ceiling, same as every DOM/proxy lane: JavaScript-driven pages,
+ * canvas widgets, and WebAuthn will not work here. Server-rendered form
+ * flows (the long tail of password-reset pages) do. Challenges are still
+ * surfaced as static observations so the run parks for a person through
+ * the usual takeover channel instead of failing silently.
+ */
+
+import type {
+  BrowserDriver,
+  Observation,
+} from "@opensesame/cua-password-reset";
+import { parseHTML } from "linkedom";
+import type { VirtualFetch } from "./vnet.js";
+
+export interface WasmDomDriverOptions {
+  virtualFetch: VirtualFetch;
+  sessionId: string;
+  allowedDomains: readonly string[];
+}
+
+// Structural DOM surface the driver needs. Declared locally so the driver
+// does not depend on any one DOM implementation's types (linkedom here, a
+// WASM DOM host there).
+interface DomElement {
+  tagName: string;
+  textContent: string | null;
+  ownerDocument: DomDocument | null;
+  getAttribute(name: string): string | null;
+  setAttribute(name: string, value: string): void;
+  hasAttribute(name: string): boolean;
+  closest(selector: string): DomElement | null;
+  querySelectorAll(selector: string): ArrayLike<DomElement>;
+  value?: string;
+}
+
+interface DomDocument {
+  body: { textContent: string | null } | null;
+  querySelector(selector: string): DomElement | null;
+  querySelectorAll(selector: string): ArrayLike<DomElement>;
+}
+
+type Element = DomElement;
+
+const ACTIVE_CAPTCHA =
+  /verify you are human|verify you(?:'|’)re human|i(?:'|’)m not a robot|not a robot|select all (?:images|squares|tiles)|captcha (?:challenge|required|verification)|performing security verification|checking your browser/iu;
+
+function staticChallengePhrase(text: string): string | null {
+  if (ACTIVE_CAPTCHA.test(text)) return "CAPTCHA verify you are human";
+  if (/passkey|security key/iu.test(text))
+    return "Passkey security key required";
+  if (/text message/iu.test(text)) return "Text message code required";
+  if (/authenticator|totp/iu.test(text))
+    return "Authenticator TOTP code required";
+  if (/one-time code|code from email|email code/iu.test(text))
+    return "One-time code from email";
+  return null;
+}
+
+function fieldKind(element: Element): Observation["fields"][number]["kind"] {
+  const tag = element.tagName.toLowerCase();
+  if (tag === "a") return "link";
+  if (tag === "button") return "button";
+  const type = (element.getAttribute("type") ?? "text").toLowerCase();
+  if (type === "submit" || type === "button") return "button";
+  if (type === "password") return "password";
+  const name = element.getAttribute("name") ?? "";
+  const label = labelOf(element);
+  if (/totp|authenticator|one-time|otp/iu.test(`${name} ${label}`))
+    return "otp";
+  if (type === "email" || /email/iu.test(`${name} ${label}`)) return "email";
+  return "text";
+}
+
+function associatedLabel(element: Element): string | null {
+  const id = element.getAttribute("id");
+  const doc = element.ownerDocument;
+  if (id && doc) {
+    const linked = doc.querySelector(`label[for="${id}"]`);
+    if (linked?.textContent) return linked.textContent.trim().slice(0, 200);
+  }
+  const wrapping = element.closest("label");
+  if (wrapping?.textContent) return wrapping.textContent.trim().slice(0, 200);
+  return null;
+}
+
+function labelOf(element: Element): string {
+  const aria = element.getAttribute("aria-label");
+  if (aria) return aria.slice(0, 200);
+  const associated = associatedLabel(element);
+  if (associated) return associated;
+  if (
+    element.tagName.toLowerCase() === "button" ||
+    element.tagName.toLowerCase() === "a"
+  )
+    return (element.textContent ?? "").trim().slice(0, 200);
+  const placeholder = element.getAttribute("placeholder");
+  if (placeholder) return placeholder.slice(0, 200);
+  const value = element.getAttribute("value");
+  if (value && (element.getAttribute("type") ?? "").toLowerCase() === "submit")
+    return value.slice(0, 200);
+  return (element.getAttribute("name") ?? "").slice(0, 200);
+}
+
+function parseDocument(html: string): DomDocument {
+  const parsed = parseHTML(html);
+  // SAFETY: parseHTML's document implements the structural surface above, exercised by the DOM driver tests.
+  return parsed.document as DomDocument;
+}
+
+export class WasmDomDriver implements BrowserDriver {
+  private document: DomDocument | null = null;
+  private currentUrl = "about:blank";
+
+  constructor(private readonly options: WasmDomDriverOptions) {}
+
+  private assertAllowed(url: URL): void {
+    if (!this.options.allowedDomains.includes(url.hostname))
+      throw new Error("wasm driver: navigation left the approved domains");
+  }
+
+  private elements(): Element[] {
+    if (!this.document) return [];
+    return Array.from(
+      this.document.querySelectorAll(
+        "input, button, a[href], select, textarea",
+      ),
+    ).filter(
+      (element) =>
+        (element.getAttribute("type") ?? "").toLowerCase() !== "hidden",
+    );
+  }
+
+  private elementForRef(ref: string): Element {
+    const elements = this.elements();
+    const index = Number(ref.slice(1)) - 1;
+    const element = ref.startsWith("e") ? elements[index] : undefined;
+    if (!element) throw new Error(`wasm driver: unknown ref ${ref}`);
+    return element;
+  }
+
+  async open(url: string): Promise<void> {
+    const target = new URL(url);
+    this.assertAllowed(target);
+    const response = await this.options.virtualFetch({
+      sessionId: this.options.sessionId,
+      url: target.href,
+      method: "GET",
+    });
+    const finalUrl = new URL(response.url);
+    this.assertAllowed(finalUrl);
+    this.currentUrl = finalUrl.href;
+    this.document = parseDocument(response.bodyText);
+  }
+
+  async snapshot(): Promise<Observation> {
+    const fields = this.elements().map((element, index) => ({
+      ref: `e${index + 1}`,
+      kind: fieldKind(element),
+      label: labelOf(element),
+    }));
+    const text = this.document?.body?.textContent ?? "";
+    const challenge = staticChallengePhrase(text);
+    if (
+      challenge &&
+      !fields.some((field) => field.label === challenge) &&
+      fields.length < 100
+    ) {
+      fields.push({
+        ref: `e${fields.length + 1}`,
+        kind: "static" as const,
+        label: challenge,
+      });
+    }
+    return {
+      id: crypto.randomUUID(),
+      origin: new URL(this.currentUrl).origin,
+      fields: fields.slice(0, 100),
+    };
+  }
+
+  async click(ref: string): Promise<void> {
+    const element = this.elementForRef(ref);
+    const tag = element.tagName.toLowerCase();
+    if (tag === "a") {
+      const href = element.getAttribute("href");
+      if (!href) throw new Error("wasm driver: link has no href");
+      await this.open(new URL(href, this.currentUrl).href);
+      return;
+    }
+    const form = element.closest("form");
+    if (!form) return;
+    await this.submitForm(form, element);
+  }
+
+  private serializeForm(form: Element, submitter: Element): URLSearchParams {
+    const values = new URLSearchParams();
+    const controls = form.querySelectorAll("input, select, textarea, button");
+    for (const candidate of Array.from(controls)) {
+      const name = candidate.getAttribute("name");
+      if (!name || candidate.hasAttribute("disabled")) continue;
+      const type = (candidate.getAttribute("type") ?? "text").toLowerCase();
+      if (
+        candidate.tagName.toLowerCase() === "button" ||
+        type === "submit" ||
+        type === "button"
+      ) {
+        if (candidate === submitter)
+          values.append(name, candidate.getAttribute("value") ?? "");
+        continue;
+      }
+      if (
+        (type === "checkbox" || type === "radio") &&
+        !candidate.hasAttribute("checked")
+      )
+        continue;
+      values.append(
+        name,
+        candidate.value ?? candidate.getAttribute("value") ?? "",
+      );
+    }
+    return values;
+  }
+
+  private async submitForm(form: Element, submitter: Element): Promise<void> {
+    const method = (form.getAttribute("method") ?? "get").toUpperCase();
+    const action = new URL(
+      form.getAttribute("action") ?? this.currentUrl,
+      this.currentUrl,
+    );
+    this.assertAllowed(action);
+    const values = this.serializeForm(form, submitter);
+    if (method === "GET") {
+      action.search = values.toString();
+      await this.open(action.href);
+      return;
+    }
+    const response = await this.options.virtualFetch({
+      sessionId: this.options.sessionId,
+      url: action.href,
+      method,
+      headers: { "content-type": "application/x-www-form-urlencoded" },
+      body: values.toString(),
+    });
+    const finalUrl = new URL(response.url);
+    this.assertAllowed(finalUrl);
+    this.currentUrl = finalUrl.href;
+    this.document = parseDocument(response.bodyText);
+  }
+
+  async fill(ref: string, value: string): Promise<void> {
+    const element = this.elementForRef(ref);
+    element.setAttribute("value", value);
+    element.value = value;
+  }
+
+  async fillSecret(ref: string, value: string): Promise<void> {
+    await this.fill(ref, value);
+  }
+
+  async pageUrl(): Promise<string> {
+    return this.currentUrl;
+  }
+
+  async close(): Promise<void> {
+    this.document = null;
+    this.currentUrl = "about:blank";
+  }
+}
diff --git a/packages/agent-sandboxes/src/wasm-provider.ts b/packages/agent-sandboxes/src/wasm-provider.ts
new file mode 100644
index 000000000..b70d74c67
--- /dev/null
+++ b/packages/agent-sandboxes/src/wasm-provider.ts
@@ -0,0 +1,73 @@
+/**
+ * WASM lane provider: allocates the DOM-level driver whose entire network
+ * is virtualized through a user-controlled relay. The driver itself is
+ * host-agnostic TypeScript (Node, browser tab, or WASM host); this
+ * provider only binds it to a relay endpoint and session.
+ */
+
+import { randomUUID } from "node:crypto";
+import {
+  type AllocatedSandbox,
+  type SandboxAllocationRequest,
+  type SandboxProvider,
+  allowedDomainsFor,
+} from "./types.js";
+import { type VirtualFetch, virtualFetchOverHttp } from "./vnet.js";
+import { WasmDomDriver } from "./wasm-dom-driver.js";
+
+export interface WasmRelayProviderOptions {
+  /** Base URL of the virtual-network relay. */
+  relayUrl?: string;
+  relayToken?: string;
+  /** Inject a virtual fetch directly (tests, in-process relay). */
+  virtualFetch?: VirtualFetch;
+}
+
+export class WasmRelayProvider implements SandboxProvider {
+  readonly id = "wasm-relay" as const;
+
+  constructor(private readonly options: WasmRelayProviderOptions = {}) {}
+
+  async allocate(request: SandboxAllocationRequest): Promise<AllocatedSandbox> {
+    const { url, allowedDomains } = allowedDomainsFor(request);
+    const session = request.session ?? `wasm-${randomUUID()}`;
+    let virtualFetch = this.options.virtualFetch;
+    if (!virtualFetch) {
+      if (!this.options.relayUrl || !this.options.relayToken)
+        throw new Error(
+          "wasm-relay provider needs a relay URL and token (or an injected virtual fetch)",
+        );
+      virtualFetch = virtualFetchOverHttp(
+        this.options.relayUrl,
+        this.options.relayToken,
+      );
+    }
+    const allowedOrigins = [
+      ...new Set([
+        url.origin,
+        ...allowedDomains
+          .filter((domain) => domain !== url.hostname)
+          .map((domain) => `https://${domain}`),
+      ]),
+    ];
+    const boundFetch = virtualFetch;
+    const browser = new WasmDomDriver({
+      virtualFetch: (input) => boundFetch({ ...input, allowedOrigins }),
+      sessionId: session,
+      allowedDomains,
+    });
+    return {
+      provider: this.id,
+      session,
+      browser,
+      allowedDomains,
+      close: async () => {
+        try {
+          await browser.close();
+        } finally {
+          await boundFetch.closeSession?.(session);
+        }
+      },
+    };
+  }
+}
