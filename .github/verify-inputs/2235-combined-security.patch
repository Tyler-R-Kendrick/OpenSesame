index 000000000..39fbde08d
--- /dev/null
+++ b/packages/agent-sandboxes/src/vnet-cookie-jar.ts
@@ -0,0 +1,111 @@
+/** Host-only jar; an exact-host Domain attribute never broadens its scope. */
+type Cookie = {
+  name: string;
+  value: string;
+  host: string;
+  path: string;
+  secure: boolean;
+  expires: number | null;
+};
+
+function defaultPath(pathname: string): string {
+  const last = pathname.lastIndexOf("/");
+  return last <= 0 ? "/" : pathname.slice(0, last);
+}
+
+function pathMatches(request: string, cookie: string): boolean {
+  return (
+    request === cookie ||
+    (request.startsWith(cookie) &&
+      (cookie.endsWith("/") || request[cookie.length] === "/"))
+  );
+}
+
+export class CookieJar {
+  private readonly cookies: Cookie[] = [];
+
+  store(url: URL, headers: Headers): void {
+    for (const line of headers.getSetCookie?.() ?? []) {
+      const [pair, ...attributes] = line.split(";");
+      if (!pair) continue;
+      const eq = pair.indexOf("=");
+      if (eq <= 0) continue;
+      const name = pair.slice(0, eq).trim();
+      const value = pair.slice(eq + 1).trim();
+      if (
+        !/^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/u.test(name) ||
+        [...value].some(
+          (char) =>
+            char.charCodeAt(0) <= 32 ||
+            char.charCodeAt(0) === 127 ||
+            char === ";" ||
+            char === ",",
+        )
+      )
+        continue;
+      let path = defaultPath(url.pathname);
+      let secure = false;
+      let expires: number | null = null;
+      let maxAge: number | null = null;
+      let hasDomain = false;
+      let domainMatches = true;
+      for (const attribute of attributes) {
+        const [rawName, ...rest] = attribute.trim().split("=");
+        const key = (rawName ?? "").toLowerCase();
+        const attrValue = rest.join("=").trim();
+        if (key === "domain") {
+          hasDomain = true;
+          if (
+            attrValue.replace(/^\./u, "").toLowerCase() !==
+            url.hostname.toLowerCase()
+          )
+            domainMatches = false;
+        }
+        if (key === "secure") secure = true;
+        if (key === "path" && attrValue.startsWith("/")) path = attrValue;
+        if (key === "expires") {
+          const parsed = Date.parse(attrValue);
+          if (Number.isFinite(parsed)) expires = parsed;
+        }
+        if (key === "max-age" && /^-?\d+$/u.test(attrValue))
+          maxAge = Number(attrValue);
+      }
+      if (
+        !domainMatches ||
+        (secure && url.protocol !== "https:") ||
+        (name.startsWith("__Secure-") && !secure) ||
+        (name.startsWith("__Host-") && (!secure || path !== "/" || hasDomain))
+      )
+        continue;
+      if (maxAge !== null)
+        expires = maxAge <= 0 ? 0 : Date.now() + maxAge * 1000;
+      const index = this.cookies.findIndex(
+        (c) => c.host === url.hostname && c.path === path && c.name === name,
+      );
+      if (index >= 0) this.cookies.splice(index, 1);
+      if (expires === null || expires > Date.now())
+        this.cookies.push({
+          name,
+          value,
+          host: url.hostname,
+          path,
+          secure,
+          expires,
+        });
+    }
+  }
+
+  header(url: URL): string {
+    return this.cookies
+      .filter(
+        (c) =>
+          c.host === url.hostname &&
+          (!c.secure || url.protocol === "https:") &&
+          (c.expires === null || c.expires > Date.now()) &&
+          pathMatches(url.pathname, c.path),
+      )
+      .sort((a, b) => b.path.length - a.path.length)
+      .map((c) => `${c.name}=${c.value}`)
+      .join("; ");
+  }
+}
