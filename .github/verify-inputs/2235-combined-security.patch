index 000000000..eee27ac66
--- /dev/null
+++ b/packages/agent-sandboxes/src/relay-driver.ts
@@ -0,0 +1,184 @@
+/**
+ * A `BrowserDriver` that drives a browser behind the relay protocol.
+ * Pure TypeScript with no Node imports: the same code runs in Node, in a
+ * browser tab, or compiled to WASM, given a WebSocket-like transport.
+ */
+
+import type {
+  BrowserDriver,
+  Observation,
+} from "@opensesame/cua-password-reset";
+import {
+  type RelayRequest,
+  type RelayResponse,
+  type RelayTransport,
+  parseRelayResponse,
+} from "./relay-protocol.js";
+
+export class RelayBrowserDriver implements BrowserDriver {
+  private sequence = 0;
+
+  constructor(private readonly transport: RelayTransport) {}
+
+  private async call(
+    request: Omit<RelayRequest, "id">,
+  ): Promise<RelayResponse & { ok: true }> {
+    this.sequence += 1;
+    const response = await this.transport({ ...request, id: this.sequence });
+    if (!response.ok) throw new Error(`relay driver: ${response.error}`);
+    return response;
+  }
+
+  async open(url: string): Promise<void> {
+    await this.call({ method: "open", url });
+  }
+
+  async snapshot(): Promise<Observation> {
+    const response = await this.call({ method: "snapshot" });
+    if (!response.observation)
+      throw new Error("relay driver: snapshot carried no observation");
+    return response.observation;
+  }
+
+  async click(ref: string): Promise<void> {
+    await this.call({ method: "click", ref });
+  }
+
+  async fill(ref: string, value: string): Promise<void> {
+    await this.call({ method: "fill", ref, value });
+  }
+
+  async fillSecret(ref: string, value: string): Promise<void> {
+    await this.call({ method: "fillSecret", ref, value });
+  }
+
+  async pageUrl(): Promise<string> {
+    const response = await this.call({ method: "pageUrl" });
+    return response.pageUrl ?? "";
+  }
+
+  async close(): Promise<void> {
+    await this.call({ method: "close" });
+  }
+}
+
+interface SocketLike {
+  send(data: string): void;
+  close(): void;
+  addEventListener(
+    type: "message",
+    listener: (event: { data: unknown }) => void,
+  ): void;
+  addEventListener(type: "open", listener: () => void): void;
+  addEventListener(type: "error" | "close", listener: () => void): void;
+}
+
+/**
+ * WebSocket transport for the relay protocol. Works with the global
+ * `WebSocket` in browsers, Workers, WASM hosts, and Node ≥ 22. Requests
+ * are serialized: the driver issues one command at a time, matching the
+ * single-page session behind the relay.
+ */
+export function webSocketRelayTransport(
+  socket: SocketLike,
+  ready: Promise<void>,
+): RelayTransport {
+  let pending: {
+    id: number;
+    resolve: (response: RelayResponse) => void;
+    reject: (error: Error) => void;
+  } | null = null;
+  let closed = false;
+  const fail = () => {
+    closed = true;
+    const settle = pending;
+    pending = null;
+    settle?.reject(new Error("relay driver: connection closed"));
+  };
+  socket.addEventListener("close", fail);
+  socket.addEventListener("error", fail);
+  socket.addEventListener("message", (event) => {
+    const settle = pending;
+    if (!settle) return;
+    const parsed = parseRelayResponse(String(event.data));
+    if (!parsed) {
+      pending = null;
+      settle.reject(new Error("relay driver: undecodable response"));
+      return;
+    }
+    if (parsed.id !== settle.id) return;
+    pending = null;
+    settle.resolve(parsed);
+  });
+  return async (request) => {
+    await ready;
+    if (closed) throw new Error("relay driver: connection closed");
+    if (pending) throw new Error("relay driver: concurrent request");
+    return new Promise<RelayResponse>((resolve, reject) => {
+      pending = { id: request.id, resolve, reject };
+      try {
+        socket.send(JSON.stringify(request));
+      } catch {
+        pending = null;
+        closed = true;
+        reject(new Error("relay driver: connection closed"));
+      }
+    });
+  };
+}
+
+export interface RelaySocketOptions {
+  token: string;
+}
+
+/** Connect a relay driver to a `ws(s)://` relay endpoint. */
+export function relayDriverOverWebSocket(
+  url: string,
+  options: RelaySocketOptions,
+): RelayBrowserDriver {
+  if (!options.token) throw new Error("relay driver: token is required");
+  const endpoint = new URL(url);
+  if (
+    endpoint.username ||
+    endpoint.password ||
+    (endpoint.protocol !== "wss:" &&
+      !(
+        endpoint.protocol === "ws:" &&
+        (endpoint.hostname === "127.0.0.1" || endpoint.hostname === "[::1]")
+      ))
+  ) {
+    throw new Error(
+      "relay driver: remote relay requires wss and no URL credentials",
+    );
+  }
+  const socket = new WebSocket(endpoint.href);
+  const ready = new Promise<void>((resolve, reject) => {
+    socket.addEventListener("open", () => {
+      const onAuth = (event: MessageEvent) => {
+        const parsed = parseRelayResponse(String(event.data));
+        if (parsed && parsed.id !== 0) return;
+        socket.removeEventListener("message", onAuth);
+        if (parsed?.ok) resolve();
+        else reject(new Error("relay driver: authentication refused"));
+      };
+      socket.addEventListener("message", onAuth);
+      try {
+        socket.send(JSON.stringify({ type: "auth", token: options.token }));
+      } catch {
+        reject(new Error("relay driver: connection failed"));
+      }
+    });
+    socket.addEventListener("error", () =>
+      reject(new Error("relay driver: connection failed")),
+    );
+    socket.addEventListener("close", () =>
+      reject(new Error("relay driver: connection closed")),
+    );
+  });
+  // The socket can close before the first driver call observes readiness.
+  void ready.catch(() => {});
+  // SAFETY: the global WebSocket implements the SocketLike surface used here (send/close/addEventListener), verified by the relay tests.
+  return new RelayBrowserDriver(
+    webSocketRelayTransport(socket as SocketLike, ready),
+  );
+}
diff --git a/packages/agent-sandboxes/src/relay-protocol.ts b/packages/agent-sandboxes/src/relay-protocol.ts
new file mode 100644
index 000000000..4c12e1813
--- /dev/null
+++ b/packages/agent-sandboxes/src/relay-protocol.ts
@@ -0,0 +1,121 @@
+/**
+ * The driver relay protocol: JSON messages carrying exactly the
+ * `BrowserDriver` surface, so a browser that lives somewhere else (a Boat
+ * sandbox, a future WASM host with a real engine) can be driven from here
+ * without provider credentials or site secrets ever entering a command
+ * log. `fillSecret` values cross only inside this authenticated channel,
+ * one fill at a time, exactly as the local stdin fill does.
+ */
+
+import type { Observation } from "@opensesame/cua-password-reset";
+import { z } from "zod";
+
+export const RELAY_METHODS = [
+  "open",
+  "snapshot",
+  "click",
+  "fill",
+  "fillSecret",
+  "pageUrl",
+  "close",
+] as const;
+export type RelayMethod = (typeof RELAY_METHODS)[number];
+
+export interface RelayRequest {
+  id: number;
+  method: RelayMethod;
+  url?: string | undefined;
+  ref?: string | undefined;
+  value?: string | undefined;
+}
+
+/**
+ * First frame on a relay socket. Browser/WASM WebSocket clients cannot set
+ * upgrade headers, so the bearer token travels as this frame instead; the
+ * relay answers `{id: 0, ok: true}` and refuses requests before it.
+ */
+export interface RelayAuth {
+  type: "auth";
+  token: string;
+}
+
+export type RelayResponse =
+  | {
+      id: number;
+      ok: true;
+      observation?: Observation | undefined;
+      pageUrl?: string | undefined;
+    }
+  | { id: number; ok: false; error: string };
+
+/** One request/response round trip. Transport is the caller's choice. */
+export type RelayTransport = (request: RelayRequest) => Promise<RelayResponse>;
+
+const relayRequestSchema = z.object({
+  id: z.number(),
+  method: z.enum(RELAY_METHODS),
+  url: z.string().optional(),
+  ref: z.string().optional(),
+  value: z.string().optional(),
+});
+
+const relayAuthSchema = z.object({
+  type: z.literal("auth"),
+  token: z.string(),
+});
+
+const relayResponseSchema = z.union([
+  z.object({
+    id: z.number(),
+    ok: z.literal(true),
+    observation: z
+      .object({
+        id: z.string(),
+        origin: z.string(),
+        fields: z.array(
+          z.object({
+            ref: z.string(),
+            kind: z.enum([
+              "email",
+              "text",
+              "password",
+              "otp",
+              "button",
+              "link",
+              "static",
+            ]),
+            label: z.string(),
+          }),
+        ),
+      })
+      .optional(),
+    pageUrl: z.string().optional(),
+  }),
+  z.object({ id: z.number(), ok: z.literal(false), error: z.string() }),
+]);
+
+/** Parse one relay response frame; anything else is not a relay message. */
+export function parseRelayResponse(text: string): RelayResponse | null {
+  const parsed = relayResponseSchema.safeParse(parseJsonText(text));
+  return parsed.success ? parsed.data : null;
+}
+
+function parseJsonText(text: string) {
+  try {
+    return JSON.parse(text);
+  } catch {
+    return null;
+  }
+}
+
+/** Parse one inbound relay frame; anything else is not a relay message. */
+export function parseRelayFrame(
+  text: string,
+): { auth: RelayAuth } | { request: RelayRequest } | null {
+  const parsed = parseJsonText(text);
+  const auth = relayAuthSchema.safeParse(parsed);
+  if (auth.success) return { auth: auth.data };
+  const request = relayRequestSchema.safeParse(parsed);
+  if (request.success) return { request: request.data };
+  return null;
+}
diff --git a/packages/agent-sandboxes/src/relay-server.ts b/packages/agent-sandboxes/src/relay-server.ts
new file mode 100644
index 000000000..5185b2ccd
--- /dev/null
+++ b/packages/agent-sandboxes/src/relay-server.ts
@@ -0,0 +1,168 @@
+/**
+ * Reference relay server: hosts one real `BrowserDriver` behind the relay
+ * protocol over an authenticated WebSocket. This is the process a remote
+ * sandbox lane runs next to its browser (Boat runs it inside the sandbox;
+ * tests run it in-process). The bearer token is checked before requests and
+ * never logged. Remote access requires a TLS-terminating proxy.
+ */
+
+import { type Server, createServer } from "node:http";
+import type { BrowserDriver } from "@opensesame/cua-password-reset";
+import { WebSocket, WebSocketServer } from "ws";
+import {
+  type RelayRequest,
+  type RelayResponse,
+  parseRelayFrame,
+} from "./relay-protocol.js";
+
+export interface RelayServerOptions {
+  /** Port to bind; 0 picks an ephemeral port (tests). */
+  port?: number;
+  host?: string;
+  /** Required bearer token for the upgrade or first authentication frame. */
+  token: string;
+  /** The browser this relay drives. One session per server. */
+  driver: BrowserDriver;
+}
+
+export interface RunningRelayServer {
+  url: string;
+  port: number;
+  close(): Promise<void>;
+}
+
+type DispatchResult = Omit<Extract<RelayResponse, { ok: true }>, "id" | "ok">;
+
+type DispatchHandler = (
+  driver: BrowserDriver,
+  request: RelayRequest,
+) => Promise<DispatchResult>;
+
+const HANDLERS = {
+  open: async (driver, request) => {
+    await driver.open(request.url ?? "");
+    return {};
+  },
+  snapshot: async (driver) => ({ observation: await driver.snapshot() }),
+  click: async (driver, request) => {
+    await driver.click(request.ref ?? "");
+    return {};
+  },
+  fill: async (driver, request) => {
+    await driver.fill(request.ref ?? "", request.value ?? "");
+    return {};
+  },
+  fillSecret: async (driver, request) => {
+    await driver.fillSecret(request.ref ?? "", request.value ?? "");
+    return {};
+  },
+  pageUrl: async (driver) => ({
+    pageUrl: driver.pageUrl ? await driver.pageUrl() : "",
+  }),
+  close: async (driver) => {
+    await driver.close?.();
+    return {};
+  },
+} satisfies Record<RelayRequest["method"], DispatchHandler>;
+
+async function dispatch(
+  driver: BrowserDriver,
+  request: RelayRequest,
+): Promise<RelayResponse> {
+  try {
+    const result = await HANDLERS[request.method](driver, request);
+    return { id: request.id, ok: true, ...result };
+  } catch (error) {
+    return {
+      id: request.id,
+      ok: false,
+      error: error instanceof Error ? error.message : "driver failed",
+    };
+  }
+}
+
+export async function startRelayServer(
+  options: RelayServerOptions,
+): Promise<RunningRelayServer> {
+  const host = options.host ?? "127.0.0.1";
+  if (host !== "127.0.0.1" && host !== "::1")
+    throw new Error(
+      "relay server: plaintext listener must bind literal loopback",
+    );
+  if (!options.token) throw new Error("relay server: token is required");
+  const server: Server = createServer((request, response) => {
+    response.writeHead(404).end();
+    void request;
+  });
+  const wss = new WebSocketServer({ noServer: true });
+  let owner: WebSocket | null = null;
+  // A disconnect must not let the next owner overtake an in-flight command.
+  let queue = Promise.resolve();
+  server.on("upgrade", (request, socket, head) => {
+    const headerAuthed =
+      request.headers.authorization === `Bearer ${options.token}`;
+    wss.handleUpgrade(request, socket, head, (ws) => {
+      let authenticated = false;
+      const claim = () => {
+        if (owner && owner !== ws) return false;
+        owner = ws;
+        authenticated = true;
+        return true;
+      };
+      ws.on("close", () => {
+        if (owner === ws) owner = null;
+      });
+      ws.on("error", () => ws.terminate());
+      if (headerAuthed && !claim()) {
+        ws.close(1008, "relay session already owned");
+        return;
+      }
+      ws.on("message", (data) => {
+        const frame = parseRelayFrame(data.toString());
+        if (!authenticated) {
+          if (
+            frame &&
+            "auth" in frame &&
+            frame.auth.token === options.token &&
+            claim()
+          ) {
+            ws.send(JSON.stringify({ id: 0, ok: true }));
+          } else {
+            ws.send(
+              JSON.stringify({ id: 0, ok: false, error: "unauthorized" }),
+            );
+            ws.close(1008, "unauthorized");
+          }
+          return;
+        }
+        if (!frame || !("request" in frame)) return;
+        const request = frame.request;
+        queue = queue
+          .then(async () => {
+            if (owner !== ws || ws.readyState !== WebSocket.OPEN) return;
+            const response = await dispatch(options.driver, request);
+            if (ws.readyState !== WebSocket.OPEN) return;
+            ws.send(JSON.stringify(response));
+            if (request.method === "close" && response.ok) ws.close();
+          })
+          .catch(() => ws.terminate());
+      });
+    });
+  });
+  await new Promise<void>((resolve) => {
+    server.listen(options.port ?? 0, host, resolve);
+  });
+  const address = server.address();
+  const port =
+    address instanceof Object && "port" in address ? address.port : 0;
+  return {
+    url: `ws://${host === "::1" ? "[::1]" : host}:${port}`,
+    port,
+    close: async () => {
+      for (const client of wss.clients) client.terminate();
+      wss.close();
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+      await queue;
+    },
+  };
+}
diff --git a/packages/agent-sandboxes/src/relay.test.ts b/packages/agent-sandboxes/src/relay.test.ts
new file mode 100644
index 000000000..8461d45ae
--- /dev/null
+++ b/packages/agent-sandboxes/src/relay.test.ts
@@ -0,0 +1,203 @@
+import { once } from "node:events";
+import type {
+  BrowserDriver,
+  Observation,
+} from "@opensesame/cua-password-reset";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { WebSocket } from "ws";
+import { relayDriverOverWebSocket } from "./relay-driver.js";
+import { type RunningRelayServer, startRelayServer } from "./relay-server.js";
+
+const OBSERVATION: Observation = {
+  id: "obs-1",
+  origin: "https://accounts.example.test",
+  fields: [{ ref: "e1", kind: "email", label: "Email" }],
+};
+
+function fakeDriver(): BrowserDriver & { calls: string[] } {
+  const calls: string[] = [];
+  return {
+    calls,
+    open: vi.fn(async (url: string) => {
+      calls.push(`open ${url}`);
+    }),
+    snapshot: vi.fn(async () => OBSERVATION),
+    click: vi.fn(async (ref: string) => {
+      calls.push(`click ${ref}`);
+    }),
+    fill: vi.fn(async () => {}),
+    fillSecret: vi.fn(async (ref: string) => {
+      calls.push(`fillSecret ${ref}`);
+    }),
+    pageUrl: vi.fn(async () => "https://accounts.example.test/reset"),
+    close: vi.fn(async () => {
+      calls.push("close");
+    }),
+  };
+}
+
+describe("driver relay", () => {
+  let server: RunningRelayServer | null = null;
+
+  afterEach(async () => {
+    await server?.close();
+    server = null;
+    vi.unstubAllGlobals();
+  });
+
+  it("drives the hosted browser over an authenticated socket", async () => {
+    const hosted = fakeDriver();
+    server = await startRelayServer({ token: "s3cret-token", driver: hosted });
+    const driver = relayDriverOverWebSocket(server.url, {
+      token: "s3cret-token",
+    });
+    await driver.open("https://accounts.example.test/reset");
+    await expect(driver.snapshot()).resolves.toEqual(OBSERVATION);
+    await driver.fillSecret("e1", "value-never-logged");
+    await expect(driver.pageUrl()).resolves.toContain("/reset");
+    await driver.close();
+    expect(hosted.calls).toEqual([
+      "open https://accounts.example.test/reset",
+      "fillSecret e1",
+      "close",
+    ]);
+  });
+
+  it("refuses a wrong relay token", async () => {
+    server = await startRelayServer({
+      token: "s3cret-token",
+      driver: fakeDriver(),
+    });
+    const driver = relayDriverOverWebSocket(server.url, { token: "wrong" });
+    await expect(
+      driver.open("https://accounts.example.test/reset"),
+    ).rejects.toThrow(/refused|failed/u);
+  });
+
+  it("surfaces hosted driver errors as relay errors", async () => {
+    const hosted = fakeDriver();
+    vi.mocked(hosted.open).mockRejectedValue(new Error("navigation blocked"));
+    server = await startRelayServer({ token: "t", driver: hosted });
+    const driver = relayDriverOverWebSocket(server.url, { token: "t" });
+    await expect(driver.open("https://x.test/")).rejects.toThrow(
+      "navigation blocked",
+    );
+  });
+  it("allows retrying close when the hosted driver fails to close", async () => {
+    const hosted = fakeDriver();
+    if (!hosted.close) throw new Error("fake driver requires close");
+    vi.mocked(hosted.close).mockRejectedValueOnce(new Error("close failed"));
+    server = await startRelayServer({ token: "t", driver: hosted });
+    const driver = relayDriverOverWebSocket(server.url, { token: "t" });
+    await expect(driver.close()).rejects.toThrow("close failed");
+    await expect(driver.close()).resolves.toBeUndefined();
+    expect(hosted.close).toHaveBeenCalledTimes(2);
+  });
+
+  it("rejects insecure remote addresses and plaintext non-loopback listeners", async () => {
+    const driver = fakeDriver();
+    await expect(
+      startRelayServer({ host: "0.0.0.0", token: "t", driver }),
+    ).rejects.toThrow(/loopback/u);
+    await expect(startRelayServer({ token: "", driver })).rejects.toThrow(
+      /token/u,
+    );
+    expect(() =>
+      relayDriverOverWebSocket("ws://example.test/relay", { token: "t" }),
+    ).toThrow(/wss/u);
+    expect(() =>
+      relayDriverOverWebSocket("ws://localhost/relay", { token: "t" }),
+    ).toThrow(/wss/u);
+    expect(() =>
+      relayDriverOverWebSocket("wss://user:password@example.test/relay", {
+        token: "t",
+      }),
+    ).toThrow(/credentials/u);
+    const constructed = vi.fn();
+    class Socket {
+      constructor(url: string) {
+        constructed(url);
+      }
+      addEventListener() {}
+      send() {}
+      close() {}
+    }
+    vi.stubGlobal("WebSocket", Socket);
+    relayDriverOverWebSocket("wss://example.test/relay", { token: "t" });
+    expect(constructed).toHaveBeenCalledWith("wss://example.test/relay");
+  });
+
+  it("allows only one authenticated client to own the browser session", async () => {
+    const hosted = fakeDriver();
+    server = await startRelayServer({ token: "shared", driver: hosted });
+    const first = relayDriverOverWebSocket(server.url, { token: "shared" });
+    await first.open("https://first.example/");
+    const second = relayDriverOverWebSocket(server.url, { token: "shared" });
+    await expect(second.open("https://second.example/")).rejects.toThrow(
+      /refused|closed/u,
+    );
+    expect(hosted.calls).toEqual(["open https://first.example/"]);
+    await first.close();
+  });
+
+  it("serializes pipelined commands and reconnects after in-flight work", async () => {
+    const hosted = fakeDriver();
+    let release: () => void = () => {};
+    const held = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    vi.mocked(hosted.open).mockImplementation(async () => {
+      await held;
+    });
+    server = await startRelayServer({ token: "shared", driver: hosted });
+    const first = new WebSocket(server.url);
+    try {
+      await once(first, "open");
+      first.send(JSON.stringify({ type: "auth", token: "shared" }));
+      await once(first, "message");
+      first.send(
+        JSON.stringify({ id: 1, method: "open", url: "https://x.test/" }),
+      );
+      first.send(JSON.stringify({ id: 2, method: "snapshot" }));
+      await vi.waitFor(() => expect(hosted.open).toHaveBeenCalledOnce());
+      expect(hosted.snapshot).not.toHaveBeenCalled();
+      first.terminate();
+      await once(first, "close");
+      const next = relayDriverOverWebSocket(server.url, { token: "shared" });
+      const nextSnapshot = next.snapshot();
+      await new Promise((resolve) => setTimeout(resolve, 25));
+      expect(hosted.snapshot).not.toHaveBeenCalled();
+      release();
+      await expect(nextSnapshot).resolves.toEqual(OBSERVATION);
+      expect(hosted.snapshot).toHaveBeenCalledOnce();
+      await next.close();
+    } finally {
+      release();
+      first.terminate();
+    }
+  });
+
+  it("rejects an in-flight and subsequent command when the socket closes", async () => {
+    const hosted = fakeDriver();
+    let release: () => void = () => {};
+    const held = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    vi.mocked(hosted.open).mockImplementation(async () => {
+      await held;
+    });
+    server = await startRelayServer({ token: "t", driver: hosted });
+    const driver = relayDriverOverWebSocket(server.url, { token: "t" });
+    const pending = driver.open("https://x.test/");
+    await vi.waitFor(() => expect(hosted.open).toHaveBeenCalledOnce());
+    const closing = server.close();
+    try {
+      await expect(pending).rejects.toThrow(/closed|failed/u);
+      await expect(driver.snapshot()).rejects.toThrow(/closed/u);
+    } finally {
+      release();
+      await closing;
+      server = null;
+    }
+  });
+});
diff --git a/packages/agent-sandboxes/src/vnet-cookie-jar.test.ts b/packages/agent-sandboxes/src/vnet-cookie-jar.test.ts
new file mode 100644
index 000000000..f35fd1102
--- /dev/null
+++ b/packages/agent-sandboxes/src/vnet-cookie-jar.test.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it } from "vitest";
+import { CookieJar } from "./vnet-cookie-jar.js";
+
+function cookies(...lines: string[]): Headers {
+  const headers = new Headers();
+  for (const line of lines) headers.append("set-cookie", line);
+  return headers;
+}
+
+describe("virtual network cookies", () => {
+  it("enforces Secure, path, expiry, and host-only domain scope", () => {
+    const jar = new CookieJar();
+    const url = new URL("https://accounts.example.test/reset/start");
+    jar.store(
+      url,
+      cookies(
+        "auth=secret; Secure; Path=/reset",
+        "gone=x; Max-Age=0",
+        "domain=x; Domain=example.test",
+        "exact=y; Domain=.accounts.example.test; Secure; Path=/",
+        "__Host-invalid=x; Domain=accounts.example.test; Secure; Path=/",
+        "plain=x; Path=/",
+      ),
+    );
+    expect(jar.header(new URL("https://accounts.example.test/reset/go"))).toBe(
+      "auth=secret; exact=y; plain=x",
+    );
+    expect(jar.header(new URL("http://accounts.example.test/reset/go"))).toBe(
+      "plain=x",
+    );
+    expect(jar.header(new URL("https://accounts.example.test/elsewhere"))).toBe(
+      "exact=y; plain=x",
+    );
+    expect(jar.header(new URL("https://evil.example.test/reset/go"))).toBe("");
+    jar.store(url, cookies("auth=; Secure; Path=/reset; Max-Age=0"));
+    expect(jar.header(url)).toBe("exact=y; plain=x");
+  });
+});
diff --git a/packages/agent-sandboxes/src/vnet-cookie-jar.ts b/packages/agent-sandboxes/src/vnet-cookie-jar.ts
new file mode 100644
index 000000000..81167ff6c
--- /dev/null
+++ b/packages/agent-sandboxes/src/vnet-cookie-jar.ts
@@ -0,0 +1,153 @@
+/** Host-only jar; an exact-host Domain attribute never broadens its scope. */
+type Cookie = {
+  name: string;
+  value: string;
+  host: string;
+  path: string;
+  secure: boolean;
+  expires: number | null;
+};
+
+function defaultPath(pathname: string): string {
+  const last = pathname.lastIndexOf("/");
+  return last <= 0 ? "/" : pathname.slice(0, last);
+}
+
+function pathMatches(request: string, cookie: string): boolean {
+  return (
+    request === cookie ||
+    (request.startsWith(cookie) &&
+      (cookie.endsWith("/") || request[cookie.length] === "/"))
+  );
+}
+
+type CookieAttributes = {
+  path: string;
+  secure: boolean;
+  expires: number | null;
+  maxAge: number | null;
+  hasDomain: boolean;
+  domainMatches: boolean;
+};
+
+function applyAttribute(
+  state: CookieAttributes,
+  url: URL,
+  attribute: string,
+): void {
+  const [rawName, ...rest] = attribute.trim().split("=");
+  const key = (rawName ?? "").toLowerCase();
+  const value = rest.join("=").trim();
+  if (key === "domain") {
+    state.hasDomain = true;
+    if (value.replace(/^\./u, "").toLowerCase() !== url.hostname.toLowerCase())
+      state.domainMatches = false;
+  }
+  if (key === "secure") state.secure = true;
+  if (key === "path" && value.startsWith("/")) state.path = value;
+  if (key === "expires") {
+    const parsed = Date.parse(value);
+    if (Number.isFinite(parsed)) state.expires = parsed;
+  }
+  if (key === "max-age" && /^-?\d+$/u.test(value)) state.maxAge = Number(value);
+}
+
+function cookiePair(
+  pair: string | undefined,
+): { name: string; value: string } | null {
+  if (!pair) return null;
+  const eq = pair.indexOf("=");
+  if (eq <= 0) return null;
+  const name = pair.slice(0, eq).trim();
+  const value = pair.slice(eq + 1).trim();
+  if (
+    !/^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/u.test(name) ||
+    [...value].some(
+      (char) =>
+        char.charCodeAt(0) <= 32 ||
+        char.charCodeAt(0) === 127 ||
+        char === ";" ||
+        char === ",",
+    )
+  )
+    return null;
+  return { name, value };
+}
+
+function validAttributes(
+  name: string,
+  url: URL,
+  state: CookieAttributes,
+): boolean {
+  return !(
+    !state.domainMatches ||
+    (state.secure && url.protocol !== "https:") ||
+    (name.startsWith("__Secure-") && !state.secure) ||
+    (name.startsWith("__Host-") &&
+      (!state.secure || state.path !== "/" || state.hasDomain))
+  );
+}
+
+function parseCookie(url: URL, line: string): Cookie | null {
+  const [pair, ...attributes] = line.split(";");
+  const parsed = cookiePair(pair);
+  if (!parsed) return null;
+  const state: CookieAttributes = {
+    path: defaultPath(url.pathname),
+    secure: false,
+    expires: null,
+    maxAge: null,
+    hasDomain: false,
+    domainMatches: true,
+  };
+  for (const attribute of attributes) applyAttribute(state, url, attribute);
+  if (!validAttributes(parsed.name, url, state)) return null;
+  const expires =
+    state.maxAge === null
+      ? state.expires
+      : state.maxAge <= 0
+        ? 0
+        : Date.now() + state.maxAge * 1000;
+  return {
+    name: parsed.name,
+    value: parsed.value,
+    host: url.hostname,
+    path: state.path,
+    secure: state.secure,
+    expires,
+  };
+}
+
+export class CookieJar {
+  private readonly cookies: Cookie[] = [];
+
+  store(url: URL, headers: Headers): void {
+    for (const line of headers.getSetCookie?.() ?? []) {
+      const cookie = parseCookie(url, line);
+      if (!cookie) continue;
+      const index = this.cookies.findIndex(
+        (c) =>
+          c.host === url.hostname &&
+          c.path === cookie.path &&
+          c.name === cookie.name,
+      );
+      if (index >= 0) this.cookies.splice(index, 1);
+      if (cookie.expires === null || cookie.expires > Date.now())
+        this.cookies.push(cookie);
+    }
+  }
+
+  header(url: URL): string {
+    return this.cookies
+      .filter(
+        (c) =>
+          c.host === url.hostname &&
+          (!c.secure || url.protocol === "https:") &&
+          (c.expires === null || c.expires > Date.now()) &&
+          pathMatches(url.pathname, c.path),
+      )
+      .sort((a, b) => b.path.length - a.path.length)
+      .map((c) => `${c.name}=${c.value}`)
+      .join("; ");
+  }
+}
