{
  "name": "opensesame",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter @opensesame/database db:generate && pnpm --filter @opensesame/database db:migrate && bash scripts/setup-hooks.sh",
    "dev": "turbo run dev --parallel --filter=@opensesame/control-plane --filter=@opensesame/console --filter=@opensesame/ceremonies --filter=@opensesame/worker --filter=@opensesame/mock-upstream-idp --filter=@opensesame/example-rp-alpha --filter=@opensesame/example-rp-beta --filter=@opensesame/example-static-rp",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --changed --since=origin/main --no-errors-on-unmatched .",
    "lint:all": "biome check .",
    "lint:anti-slop": "oxlint --config oxlint.config.ts .",
    "lint:fix": "biome check --write --changed --since=origin/main --no-errors-on-unmatched . && biome check --write --staged --no-errors-on-unmatched .",
    "setup:hooks": "bash scripts/setup-hooks.sh",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:security": "pnpm --filter @opensesame/testing test:security",
    "test:redteam": "pnpm --filter @opensesame/redteam redteam",
    "test:visual": "pnpm --filter @opensesame/visual-contract test:visual",
    "test:coverage:ts": "node scripts/ts-coverage-gate.mjs",
    "test:coverage:rust": "cargo +1.88.0 llvm-cov --workspace --all-targets --summary-only --fail-under-lines 69 --fail-under-functions 67 --json --output-path coverage/rust-summary.json",
    "test:coverage": "pnpm test:coverage:ts && pnpm test:coverage:rust",
    "test:mutation:ts": "stryker run",
    "test:mutation:rust": "cargo +1.88.0 mutants --gitignore true -p opensesame-redaction -p opensesame-task-bus -p opensesame-relay -p opensesame-connection-detect --file crates/redaction/src/lib.rs --file crates/task-bus/src/validate.rs --file crates/relay/src/lib.rs --file crates/connection-detect/src/lib.rs -j 2 -o artifacts/mutation/rust",
    "test:mutation": "pnpm test:mutation:ts && pnpm test:mutation:rust",
    "audit:cve-lite": "bash ./scripts/cve-lite-gate.sh",
    "audit:ast-grep": "bash ./scripts/ast-grep-security-gate.sh",
    "audit:clippy": "bash ./scripts/clippy-gate.sh",
    "audit:osv": "bash ./scripts/osv-scanner-gate.sh",
    "audit:cargo-audit": "bash ./scripts/cargo-audit-gate.sh",
    "audit:gitleaks": "bash ./scripts/gitleaks-gate.sh",
    "audit:semgrep": "bash ./scripts/semgrep-gate.sh",
    "audit:deepsec": "bash ./scripts/deepsec-gate.sh",
    "audit:daemon-deps": "bash ./scripts/daemon-deps-gate.sh",
    "eve:deepsec": "pnpm --dir apps/eve-deepsec exec eve dev",
    "audit:fuzz": "bash ./scripts/fuzz-pr-gate.sh",
    "audit:fuzz:batch": "bash ./scripts/fuzz-batch.sh",
    "audit:kani": "bash ./scripts/kani-gate.sh",
    "audit:miri": "bash ./scripts/miri-gate.sh",
    "audit:shuttle": "bash ./scripts/shuttle-gate.sh",
    "test:fuzz": "bash ./scripts/jazzer-gate.sh",
    "test:fuzz:batch": "FUZZ_SECONDS=${FUZZ_SECONDS:-300} bash ./scripts/jazzer-gate.sh",
    "test:task-access": "bash ./scripts/task-security-battle-test.sh",
    "test:nats-dogfood": "bash ./scripts/nats-dogfood-test.sh",
    "test:live-stack": "bash ./scripts/live-stack-test.sh",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:integration",
    "db:migrate": "pnpm --filter @opensesame/database db:migrate",
    "db:reset": "pnpm --filter @opensesame/database db:reset",
    "generate:openapi": "pnpm --filter @opensesame/control-plane generate:openapi",
    "generate:sbom": "mkdir -p sbom && pnpm dlx @cyclonedx/cdxgen -o sbom/bom.json",
    "verify": "pnpm lint && pnpm test:all && cargo +1.88.0 test --workspace --all-targets && ./scripts/battle-test.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@env-spec/parser": "0.4.1",
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "1.55.1",
    "@simplewebauthn/server": "13.2.2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitejs/plugin-react": "4.5.0",
    "@vitest/coverage-v8": "4.1.10",
    "better-auth": "1.6.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "jose": "6.2.8",
    "oidc-provider": "9.11.2",
    "oxlint": "1.79.0",
    "pino": "9.7.0",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "turbo": "2.9.14",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "wxt": "0.20.6",
    "zod": "3.25.67"
  },
  "pnpm": {
    "overrides": {
      "vitest": "4.1.10",
      "vite": "6.4.3",
      "shell-quote": "1.10.0",
      "adm-zip": "0.6.0",
      "tmp": "0.2.7",
      "uuid": "14.0.1",
      "typed-rest-client>qs": "6.15.3",
      "playwright": "1.55.1",
      "esbuild": ">=0.25.0",
      "fx-runner>shell-quote": "1.10.0",
      "web-ext-run>tmp": "0.2.7",
      "firefox-profile>adm-zip": "0.6.0",
      "promptfoo>ai": "6.0.237",
      "promptfoo>@huggingface/transformers": "-"
    }
  }
}
