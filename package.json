{
  "name": "opensesame",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter @opensesame/database db:generate && pnpm --filter @opensesame/database db:migrate",
    "dev": "turbo run dev --parallel --filter=@opensesame/control-plane --filter=@opensesame/console --filter=@opensesame/worker --filter=@opensesame/mock-upstream-idp --filter=@opensesame/example-rp-alpha --filter=@opensesame/example-rp-beta",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test --filter='./packages/*' --filter='./apps/control-plane' --filter='./apps/worker'",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:security": "pnpm --filter @opensesame/testing test:security",
    "audit:cve-lite": "bash ./scripts/cve-lite-gate.sh",
    "audit:ast-grep": "bash ./scripts/ast-grep-security-gate.sh",
    "audit:clippy": "bash ./scripts/clippy-gate.sh",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:integration",
    "db:migrate": "pnpm --filter @opensesame/database db:migrate",
    "db:reset": "pnpm --filter @opensesame/database db:reset",
    "generate:openapi": "pnpm --filter @opensesame/control-plane generate:openapi",
    "generate:sbom": "pnpm dlx @cyclonedx/cdxgen -o sbom/bom.json || mkdir -p sbom && echo '{\"bomFormat\":\"CycloneDX\",\"specVersion\":\"1.5\",\"components\":[]}' > sbom/bom.json",
    "verify": "pnpm test:all && cargo +1.88.0 test --workspace --lib && ./scripts/battle-test.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@env-spec/parser": "0.4.1",
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.55.1",
    "@simplewebauthn/server": "13.2.2",
    "@vitejs/plugin-react": "4.5.0",
    "better-auth": "1.6.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "jose": "6.2.8",
    "oidc-provider": "9.11.2",
    "pino": "9.7.0",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "turbo": "2.9.14",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "wxt": "0.20.6",
    "zod": "3.25.67"
  },
  "pnpm": {
    "overrides": {
      "vitest": "4.1.10",
      "vite": "6.4.3",
      "shell-quote": "1.10.0",
      "adm-zip": "0.6.0",
      "tmp": "0.2.7",
      "uuid": "14.0.1",
      "playwright": "1.55.1",
      "esbuild": ">=0.25.0",
      "fx-runner>shell-quote": "1.10.0",
      "web-ext-run>tmp": "0.2.7",
      "firefox-profile>adm-zip": "0.6.0"
    }
  }
}
