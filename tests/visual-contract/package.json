{
  "name": "@opensesame/visual-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright + pixelmatch visual regression contract that renders apps/pages and diffs it against the tests/visual-contract/baselines design baselines",
  "scripts": {
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:integration": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.29",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "8.0.0",
    "pixelmatch-legacy": "npm:pixelmatch@7.2.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opensesame/os-domain": "*"
  }
}
