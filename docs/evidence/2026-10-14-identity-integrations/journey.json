    {
      "name": "byo-ldap",
      "route": "settings/connections/byo-identity",
      "protocol": "ldap",
      "phases": ["after"]
    }
  ],
  "measurements": [
    "identity catalog link count",
    "configuration control labels and readonly state",
    "document horizontal overflow"
  ],
  "rawCaptures": "system temporary directory: opensesame-identity-evidence/{before,after}",
  "sheets": [
    "1280-catalog.png",
