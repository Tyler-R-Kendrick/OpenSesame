  "sheets": [
    {
      "shot": "1280-bitwarden",
      "width": 1280,
      "title": "Connections \u203a Bitwarden \u2014 1280 \u00d7 900",
      "caption": "The page said \"native application, OS or CLI access; this browser cannot run that companion and has no supported browser driver\", behind a collapsed \"Other sign-in methods\", and sent \"Bitwarden documentation\" to fnox's page about fnox's Bitwarden backend. Now it says what Bitwarden's two APIs are (the Vault Management API is the CLI's `bw serve`, which refuses any request with an Origin header; the Public API manages organizations and sends no CORS headers to this site), open by default, links Bitwarden's own pages, and names the import that works today.",
      "before": "BEFORE_BITWARDEN_1280",
      "after": "AFTER_BITWARDEN_1280"
    },
    {
      "shot": "390-bitwarden",
      "width": 390,
      "title": "Connections \u203a Bitwarden \u2014 390 \u00d7 844",
      "caption": "Same page on a phone: the reason is readable without opening anything, and every link is its own line.",
      "before": "BEFORE_BITWARDEN_390",
      "after": "AFTER_BITWARDEN_390"
    },
    {
      "shot": "1280-aws",
      "width": 1280,
      "title": "Connections \u203a AWS Secrets Manager \u2014 1280 \u00d7 900",
      "caption": "AWS Secrets Manager's API answers browser requests from this site (preflight 200 and the real response both carry allow-origin *; the error body is readable), so \"cannot run that companion\" was false. It now connects: region and the person's own IAM key, signed in the browser with SigV4 and sent only to the endpoint AWS publishes for the region. Nothing about the endpoint is typed.",
      "before": "BEFORE_AWS",
      "after": "AFTER_AWS"
    },
    {
      "shot": "390-aws",
      "width": 390,
      "title": "Connections \u203a AWS Secrets Manager \u2014 390 \u00d7 844",
