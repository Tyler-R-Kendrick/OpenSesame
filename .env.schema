# @defaultSensitive=false
# ---
# OpenSesame identity plane environment schema (@env-spec / ADR 0006).
# Commit this file. Put secret values in local .env / secret stores — never here.

# @type=url
# @public
# Downstream OIDC issuer (control plane / oauth-provider)
OPENSESAME_ISSUER=http://127.0.0.1:8788

# @type=url
# @public
# Control-plane HTTP API (may equal issuer in local single-process mode)
OPENSESAME_API_URL=http://127.0.0.1:8788

# @type=url
# @public
OPENSESAME_CONSOLE_ORIGIN=http://127.0.0.1:5173

# @type=string
# @sensitive
# Legacy Better Auth session secret. Better Auth IS mounted now (ADR 0057
# supersedes ADR 0052 §6) at /v1/auth, for email magic-link only — but it
# derives its signing key from OPENSESAME_CLAIM_PEPPER by HKDF rather than
# reading this, so there is one fewer secret to keep in sync. Unused.
OPENSESAME_AUTH_SECRET=

# @type=url
# @public
# Legacy Better Auth `baseURL`. The mount uses OPENSESAME_PUBLIC_URL: the
# magic-link a message carries has to point at the origin the browser is
# already on, so a second base URL could only ever disagree with it. Unused.
OPENSESAME_AUTH_BASE_URL=http://127.0.0.1:5173

# @type=url
# @sensitive
# SMTP connection URL for outbound email — today, only the sign-in magic link
# (ADR 0057 / D16). Carries credentials in userinfo, e.g.
# smtps://user:pass@smtp.example.com:465. When unset, local/dev builds compose
# messages through nodemailer's jsonTransport and never send them; a
# deployment without OPENSESAME_ALLOW_DEV_DEFAULTS refuses to send instead.
OPENSESAME_SMTP_URL=

# @type=string
# @public
# From address on those messages. Defaults to no-reply@<host of publicUrl>.
OPENSESAME_MAIL_FROM=

# @type=string
# @required @sensitive
# Postgres connection for identity plane
DATABASE_URL=postgres://opensesame:opensesame@127.0.0.1:5432/opensesame

# @type=string
# @required @sensitive
# Pepper for claim-token digests (HMAC purpose-bound).
# Required unless OPENSESAME_ALLOW_DEV_DEFAULTS=true (local/test only).
OPENSESAME_CLAIM_PEPPER=

# @type=boolean
# @public
# Permit development defaults (default claim pepper, etc.). Never set in production.
OPENSESAME_ALLOW_DEV_DEFAULTS=false

# @type=boolean
# @public
# Accept Authorization: Bearer prn_… (local tests only). Requires ALLOW_DEV_DEFAULTS; never in production.
OPENSESAME_ALLOW_PRINCIPAL_BEARER=false

# @type=enum(development,test,production)
# @public
# Deployment mode. Prefer this over NODE_ENV for OpenSesame fail-closed checks.
OPENSESAME_ENV=development


# @type=string
# @required @sensitive
# Pepper for user-code digests (separate purpose prefix)
OPENSESAME_USER_CODE_PEPPER=

# @type=string
# @sensitive
# Pairwise subject derivation pepper / sector HMAC key
OPENSESAME_PAIRWISE_PEPPER=

# @type=string
# @public
# Truthy: 1|true|yes|on
OPENSESAME_ORIGIN_CLIENTS_ENABLED=false

# @type=string
# @public
OPENSESAME_DCR_ENABLED=false

# @type=string
# @public
OPENSESAME_CIMD_ENABLED=false

# @type=url
# @public
# Public base URL this control plane is reached at. It is load-bearing beyond
# cosmetics: it is the origin inside the origin-profile client id
# (`origin:<origin>`, ADR 0034), the base of every federated redirect_uri, and
# the default OIDC issuer when OPENSESAME_ISSUER is unset. Defaults to
# http://<host>:<port>, which is correct only for a local stack — set it
# explicitly anywhere a proxy, a port mapping or TLS termination sits in front.
OPENSESAME_PUBLIC_URL=http://127.0.0.1:8788

# @type=url
# @public
# Legacy single confidential upstream (superseded by OPENSESAME_PROVIDERS
# below, which expresses the same thing plus a label and a kind). Still
# honored: when all three of ISSUER/CLIENT_ID/CLIENT_SECRET are set they are
# absorbed into the registry as one credentialed provider.
OPENSESAME_UPSTREAM_ISSUER=http://127.0.0.1:9090

# @type=string
# @public
OPENSESAME_UPSTREAM_CLIENT_ID=opensesame-upstream

# @type=string
# @sensitive
OPENSESAME_UPSTREAM_CLIENT_SECRET=

# @type=string
# @public
# Comma-separated OIDC issuers trusted to admit durable principals (ADR 0033).
# An assertion from an unlisted issuer is refused even when its signature
# verifies. Production defaults to https://shoo.dev alone; development also
# allows the local mock IdP (http://127.0.0.1:9090, http://localhost:9090).
# In production the list must be non-empty and every entry must be https —
# see `assertSecureConfig` in apps/control-plane/src/config.ts.
OPENSESAME_TRUSTED_UPSTREAMS=https://shoo.dev

# ---------------------------------------------------------------------------
# Federated provider registry (ADR 0055).
#
# OPENSESAME_PROVIDERS lists the provider ids on offer. Each id `x` is then
# configured through OPENSESAME_PROVIDER_X_* variables (the id, uppercased):
#
#   _ISSUER          issuer URL (required for a generic id)
#   _LABEL           button text — "Sign in with {label}"
#   _KIND            `oidc` (default) or `oauth2` — oauth2 is the plain leg for
#                    providers that issue no id_token, GitHub among them
#   _CLIENT_ID       client id registered with that provider
#   _CLIENT_SECRET   client secret (@sensitive; requires _CLIENT_ID)
#   _SCOPES          space-separated scopes
#   _AUTHORIZE_URL   oauth2 only: authorization endpoint
#   _TOKEN_URL       oauth2 only: token endpoint
#   _USERINFO_URL    oauth2 only: userinfo endpoint
#   _EMAILS_URL      oauth2 only: an endpoint listing the account's addresses
#                    with the provider's own `verified` flag (GitHub's
#                    /user/emails). Only an address confirmed there counts as
#                    verified, and only a verified one can join an account the
#                    same person already has. Optional: a provider that puts a
#                    verified flag on the profile document needs no second read.
#   _SUBJECT_FIELD   oauth2 only: the userinfo field carrying a STABLE subject.
#                    GitHub's `id` is immutable; its `login` is renameable and
#                    must never be used — a renameable subject is an
#                    account-takeover path.
#
# google, microsoft, github and apple carry built-in defaults (issuer, kind,
# endpoints, scopes) so a real deployment usually needs only a client id and
# secret. Every configured issuer is merged into OPENSESAME_TRUSTED_UPSTREAMS
# automatically — a provider never has to be listed twice — and a provider
# entry that configuration cannot satisfy refuses the boot rather than failing
# one sign-in at a time.
#
# A client id with no secret is not an error: that leg runs as a public
# origin-profile client (ADR 0034).
# ---------------------------------------------------------------------------

# @type=string
# @public
# Comma-separated provider ids, e.g. `google,microsoft,github,apple`. Empty
# means the deployment offers only what OPENSESAME_TRUSTED_UPSTREAMS lists.
OPENSESAME_PROVIDERS=

# @type=string
# @public
# Google Cloud OAuth client id (issuer https://accounts.google.com).
OPENSESAME_PROVIDER_GOOGLE_CLIENT_ID=

# @type=string
# @sensitive
OPENSESAME_PROVIDER_GOOGLE_CLIENT_SECRET=

# @type=string
# @public
# Microsoft Entra ID tenant id (GUID or verified domain). REQUIRED for the
# microsoft provider and deliberately not optional: the multi-tenant endpoints
# (common, organizations, consumers) publish the literal template
# https://login.microsoftonline.com/{tenantid}/v2.0 as their issuer, which
# exact-match issuer validation can never satisfy. Configuring one of them is
# refused at boot.
OPENSESAME_PROVIDER_MICROSOFT_TENANT=

# @type=string
# @public
# App registration (client) id in that tenant.
OPENSESAME_PROVIDER_MICROSOFT_CLIENT_ID=

# @type=string
# @sensitive
OPENSESAME_PROVIDER_MICROSOFT_CLIENT_SECRET=

# @type=string
# @public
# Apple Developer team id — the `iss` of the client-secret JWT.
OPENSESAME_PROVIDER_APPLE_TEAM_ID=

# @type=string
# @public
# Sign in with Apple key id — the client-secret JWT's `kid`.
OPENSESAME_PROVIDER_APPLE_KEY_ID=

# @type=string
# @public
# Services id registered with Apple; the JWT `sub`.
OPENSESAME_PROVIDER_APPLE_CLIENT_ID=

# @type=string
# @sensitive
# Apple ES256 private key, PEM contents. Apple issues no static client secret:
# the secret is a short-lived JWT signed with this key. Prefer the _FILE form
# below and keep the key out of git either way.
OPENSESAME_PROVIDER_APPLE_PRIVATE_KEY=

# @type=string
# @public
# Filesystem path to the Apple ES256 private key PEM, read at boot. Used only
# when _PRIVATE_KEY is unset. The path is configuration; the key it names is
# the secret.
OPENSESAME_PROVIDER_APPLE_PRIVATE_KEY_FILE=

# @type=string
# @public
# Pre-registered demo RP clients
OPENSESAME_RP_ALPHA_CLIENT_ID=rp-alpha

# @type=string
# @public
OPENSESAME_RP_BETA_CLIENT_ID=rp-beta

# @type=string
# @public
OPENSESAME_CLI_CLIENT_ID=opensesame-cli

# @type=string
# @public
# Feature: allow anonymous / provisional principals
OPENSESAME_ANONYMOUS_ENABLED=true

# @type=string
# @public
OPENSESAME_DEVICE_FLOW_ENABLED=true

# @type=string
# @public
OPENSESAME_AGENT_CLAIMS_ENABLED=true

# @type=boolean
# @public
# Experimental trust-broker protocol surfaces. Disabled by default; enabling a
# surface never disables its security validation or production key requirements.
OPENSESAME_OID4VP_ENABLED=false
OPENSESAME_OID4VCI_ENABLED=false
OPENSESAME_FEDCM_ENABLED=false
OPENSESAME_DIGITAL_CREDENTIALS_API_ENABLED=false
OPENSESAME_OPENID_FEDERATION_ENABLED=false
OPENSESAME_SD_JWT_VC_ENABLED=false
OPENSESAME_TOKEN_STATUS_LIST_ENABLED=false
OPENSESAME_PRESENTATION_AGENT_INTENTS_ENABLED=false

# @type=string
# @public
# PostHog telemetry (WP5, packages/telemetry) is fully opt-in: unset means no
# process ever sends an event, a no-op end to end. Marked public rather than
# sensitive because a PostHog *project* API key is a write-only capture key
# by design (it cannot read data back) — the same class of value this schema
# already treats as public for the OPENSESAME_*_CLIENT_ID entries above —
# and VITE_OPENSESAME_TELEMETRY_KEY below is, by construction, compiled into
# the publicly served apps/pages bundle, so marking either one sensitive
# would be misleading. The event/prop allowlist that bounds what a
# configured key can ever receive lives in packages/telemetry, independent
# of this key. See docs/operators/posthog-setup.md.
OPENSESAME_TELEMETRY_KEY=

# @type=string
# @public
# Same PostHog project key, inlined into the apps/pages build at build time
# (Vite only exposes VITE_-prefixed vars to import.meta.env). Unset means no
# posthog.init() call, a verified no-op — see apps/pages/src/lib/telemetry.ts
# and docs/operators/posthog-setup.md.
VITE_OPENSESAME_TELEMETRY_KEY=

# @type=string
# @public
# GitHub OAuth App client id for the connection broker (`opensesame connect
# create github`). The broker derives this name from the provider id; without
# it the github provider reports `configured: false` and authorize fails.
# Shared with the identity-plane registry above: listing `github` in
# OPENSESAME_PROVIDERS makes the control plane read this same pair for the
# GitHub sign-in leg. One OAuth App can serve both, or give the planes
# separate deployments if they should not share credentials.
OPENSESAME_PROVIDER_GITHUB_CLIENT_ID=

# @type=string
# @sensitive
# GitHub OAuth App client secret paired with the client id above.
OPENSESAME_PROVIDER_GITHUB_CLIENT_SECRET=

# @type=string
# @public
# Overrides GitHub's built-in https://api.github.com/user/emails. Point this at
# a GitHub Enterprise Server API, or at a reference server in a test. Reading it
# is what lets a GitHub sign-in carry a verified address, so an account that
# already exists under the same confirmed email is joined rather than duplicated
# (ADR 0057). Requires the `user:email` scope, which the built-in default
# requests.
OPENSESAME_PROVIDER_GITHUB_EMAILS_URL=

# @type=string
# @public
# GitHub App id for `github-app` installation-token leases and sealed-store
# backup pushes (`opensesame backup`).
GITHUB_APP_ID=

# @type=string
# @public
# Filesystem path to the GitHub App private key PEM. Keep the key outside git;
# GITHUB_APP_PRIVATE_KEY (inline PEM) is also honored for CI-style injection.
GITHUB_APP_PRIVATE_KEY_PATH=

# @type=string
# @public
# Installation to mint tokens for. Optional when the app has exactly one
# installation.
GITHUB_APP_INSTALLATION_ID=

# @type=string
# @sensitive
# Ambient token override for sealed-store backup pushes; checked before the
# GitHub App and `gh auth token` fallbacks.
GITHUB_TOKEN=

# @type=url
# @public
# GitHub API base for the gateway backup actor and CLI (ADR 0039).
# Defaults to https://api.github.com when unset.
GITHUB_API_BASE=

# @type=string
# @public
# Backup actor tick in milliseconds (ADR 0039). Defaults to 5000. Mutations
# also wake the actor via notify, so this is a ceiling, not a latency.
OPENSESAME_BACKUP_INTERVAL_MS=

# @type=url
# @public
# PostHog ingestion host for OPENSESAME_TELEMETRY_KEY (apps/mcp-host).
# Defaults to https://us.i.posthog.com when unset.
OPENSESAME_TELEMETRY_HOST=https://us.i.posthog.com

# @type=url
# @public
# Same PostHog ingestion host, for apps/pages specifically — Vite only
# inlines VITE_-prefixed vars into the build, so it cannot see the unprefixed
# OPENSESAME_TELEMETRY_HOST above at build time. Defaults to
# https://us.i.posthog.com when unset, same as the host-side variable.
VITE_OPENSESAME_TELEMETRY_HOST=https://us.i.posthog.com

# --- Host TaskBus / NATS JetStream (ADR 0042) ---

# @type=string
# @public
# memory | nats. When unset: nats if NATS_URL is set, else memory.
# Process env overrides durable Host operator config (Compose-friendly).
OPENSESAME_TASKBUS=

# @type=string
# @public
# NATS client URL Host/worker dial (e.g. nats://127.0.0.1:4222 or
# nats://box.tailXXXX.ts.net:4222). Never commit operator seeds.
NATS_URL=

# --- Host NATS auth callout (ADR 0042; gateway :8787) ---

# @type=string
# @sensitive
# Shared secret presented by the NATS auth-callout bridge to
# POST /api/v1/nats/auth/callout (Authorization: Bearer or
# X-OpenSesame-Callout-Token). Never commit a live value.
OPENSESAME_NATS_CALLOUT_SECRET=

# @type=string
# @public
# Comma-separated OIDC issuer allowlist for mixed-mode callout admission.
# Unknown issuers are denied. Example: http://127.0.0.1:8788,https://idp.example
OPENSESAME_NATS_CALLOUT_ISSUERS=http://127.0.0.1:8788

# @type=string
# @sensitive
# Host→Identity service token for GET /v1/principals/mapping/resolve.
# Falls back to OPENSESAME_NATS_CALLOUT_SECRET when unset. Never join by email.
OPENSESAME_MAPPING_RESOLVE_TOKEN=
