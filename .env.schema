# @defaultSensitive=false
# ---
# OpenSesame identity plane environment schema (@env-spec / ADR 0006).
# Commit this file. Put secret values in local .env / secret stores — never here.

# @type=url
# @public
# Downstream OIDC issuer (control plane / oauth-provider)
OPENSESAME_ISSUER=http://127.0.0.1:8788

# @type=url
# @public
# Control-plane HTTP API (may equal issuer in local single-process mode)
OPENSESAME_API_URL=http://127.0.0.1:8788

# @type=url
# @public
OPENSESAME_CONSOLE_ORIGIN=http://127.0.0.1:5173

# @type=string
# @required @sensitive
# Better Auth / upstream session secret (min 32 chars in production)
OPENSESAME_AUTH_SECRET=

# @type=url
# @public
OPENSESAME_AUTH_BASE_URL=http://127.0.0.1:5173

# @type=string
# @required @sensitive
# Postgres connection for identity plane
DATABASE_URL=postgres://opensesame:opensesame@127.0.0.1:5432/opensesame

# @type=string
# @required @sensitive
# Pepper for claim-token digests (HMAC purpose-bound).
# Required unless OPENSESAME_ALLOW_DEV_DEFAULTS=true (local/test only).
OPENSESAME_CLAIM_PEPPER=

# @type=boolean
# @public
# Permit development defaults (default claim pepper, etc.). Never set in production.
OPENSESAME_ALLOW_DEV_DEFAULTS=false

# @type=boolean
# @public
# Accept Authorization: Bearer prn_… (local tests only). Requires ALLOW_DEV_DEFAULTS; never in production.
OPENSESAME_ALLOW_PRINCIPAL_BEARER=false

# @type=enum(development,test,production)
# @public
# Deployment mode. Prefer this over NODE_ENV for OpenSesame fail-closed checks.
OPENSESAME_ENV=development


# @type=string
# @required @sensitive
# Pepper for user-code digests (separate purpose prefix)
OPENSESAME_USER_CODE_PEPPER=

# @type=string
# @sensitive
# Pairwise subject derivation pepper / sector HMAC key
OPENSESAME_PAIRWISE_PEPPER=

# @type=string
# @public
# Truthy: 1|true|yes|on
OPENSESAME_ORIGIN_CLIENTS_ENABLED=false

# @type=string
# @public
OPENSESAME_DCR_ENABLED=false

# @type=string
# @public
OPENSESAME_CIMD_ENABLED=false

# @type=url
# @public
OPENSESAME_UPSTREAM_ISSUER=http://127.0.0.1:9090

# @type=string
# @public
OPENSESAME_UPSTREAM_CLIENT_ID=opensesame-upstream

# @type=string
# @sensitive
OPENSESAME_UPSTREAM_CLIENT_SECRET=

# @type=string
# @public
# Pre-registered demo RP clients
OPENSESAME_RP_ALPHA_CLIENT_ID=rp-alpha

# @type=string
# @public
OPENSESAME_RP_BETA_CLIENT_ID=rp-beta

# @type=string
# @public
OPENSESAME_CLI_CLIENT_ID=opensesame-cli

# @type=string
# @public
# Feature: allow anonymous / provisional principals
OPENSESAME_ANONYMOUS_ENABLED=true

# @type=string
# @public
OPENSESAME_DEVICE_FLOW_ENABLED=true

# @type=string
# @public
OPENSESAME_AGENT_CLAIMS_ENABLED=true

# @type=string
# @public
# PostHog telemetry (WP5, packages/telemetry) is fully opt-in: unset means no
# process ever sends an event, a no-op end to end. Marked public rather than
# sensitive because a PostHog *project* API key is a write-only capture key
# by design (it cannot read data back) — the same class of value this schema
# already treats as public for the OPENSESAME_*_CLIENT_ID entries above —
# and VITE_OPENSESAME_TELEMETRY_KEY below is, by construction, compiled into
# the publicly served apps/pages bundle, so marking either one sensitive
# would be misleading. The event/prop allowlist that bounds what a
# configured key can ever receive lives in packages/telemetry, independent
# of this key. See docs/operators/posthog-setup.md.
OPENSESAME_TELEMETRY_KEY=

# @type=string
# @public
# Same PostHog project key, inlined into the apps/pages build at build time
# (Vite only exposes VITE_-prefixed vars to import.meta.env). Unset means no
# posthog.init() call, a verified no-op — see apps/pages/src/lib/telemetry.ts
# and docs/operators/posthog-setup.md.
VITE_OPENSESAME_TELEMETRY_KEY=

# @type=string
# @public
# GitHub OAuth App client id for the connection broker (`opensesame connect
# create github`). The broker derives this name from the provider id; without
# it the github provider reports `configured: false` and authorize fails.
OPENSESAME_PROVIDER_GITHUB_CLIENT_ID=

# @type=string
# @sensitive
# GitHub OAuth App client secret paired with the client id above.
OPENSESAME_PROVIDER_GITHUB_CLIENT_SECRET=

# @type=string
# @public
# GitHub App id for `github-app` installation-token leases and sealed-store
# backup pushes (`opensesame backup`).
GITHUB_APP_ID=

# @type=string
# @public
# Filesystem path to the GitHub App private key PEM. Keep the key outside git;
# GITHUB_APP_PRIVATE_KEY (inline PEM) is also honored for CI-style injection.
GITHUB_APP_PRIVATE_KEY_PATH=

# @type=string
# @public
# Installation to mint tokens for. Optional when the app has exactly one
# installation.
GITHUB_APP_INSTALLATION_ID=

# @type=string
# @sensitive
# Ambient token override for sealed-store backup pushes; checked before the
# GitHub App and `gh auth token` fallbacks.
GITHUB_TOKEN=

# @type=url
# @public
# PostHog ingestion host for OPENSESAME_TELEMETRY_KEY (apps/mcp-host).
# Defaults to https://us.i.posthog.com when unset.
OPENSESAME_TELEMETRY_HOST=https://us.i.posthog.com

# @type=url
# @public
# Same PostHog ingestion host, for apps/pages specifically — Vite only
# inlines VITE_-prefixed vars into the build, so it cannot see the unprefixed
# OPENSESAME_TELEMETRY_HOST above at build time. Defaults to
# https://us.i.posthog.com when unset, same as the host-side variable.
VITE_OPENSESAME_TELEMETRY_HOST=https://us.i.posthog.com
