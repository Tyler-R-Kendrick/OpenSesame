    "test": "vitest run"
  },
  "dependencies": {
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/sdk-browser": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.0",
    "typescript": "7.0.2",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
