{
  "name": "@opensesame/example-agent",
  "version": "0.1.0",
  "description": "Example agent that registers anonymously with the Identity API and polls until a person claims it",
  "private": true,
  "type": "module",
  "bin": {
    "opensesame-example-agent": "./src/main.ts"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensesame/agent-protocols": "*",
    "@opensesame/contracts": "*",
    "@opensesame/log-scrub": "*",
    "@opensesame/os-domain": "*",
    "@opensesame/sdk-cli": "*"
  },
  "devDependencies": {
    "@opensesame/testing": "*",
    "@types/node": "22.15.29",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
