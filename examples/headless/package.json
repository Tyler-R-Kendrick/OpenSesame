{
  "name": "@opensesame/example-headless",
  "version": "0.1.0",
  "description": "Example RFC 8628 device login from a machine with no browser, through @opensesame/sdk-cli",
  "private": true,
  "type": "module",
  "bin": {
    "opensesame-example-headless": "./src/main.ts"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/sdk-cli": "workspace:*"
  },
  "devDependencies": {
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  }
}
