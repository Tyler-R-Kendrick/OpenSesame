# @defaultSensitive=false
# ---
# OpenSesame demo schema — @env-spec (ADR 0006)
# Agents may read this file; sensitive values are never committed as plaintext.

# @type=url
# @public
API_URL=http://localhost:3000

# WorkOS — legacy HTTP SDK gets shaped placeholder via projection=legacy-token
# @required @sensitive
WORKOS_API_KEY=opensesameConnection(conn://demo/workos, projection=legacy-token)

# GitHub — Vault-aware handle (ConnectionRef URI in env for handle mode)
# @required @sensitive
GITHUB_TOKEN=opensesame(conn://demo/github)
