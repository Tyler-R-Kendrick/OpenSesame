# @defaultSensitive=false
# ---
# OpenSesame demo schema — @env-spec (ADR 0006)
# Agents may read this file; sensitive values are never committed as plaintext.

# @type=url
# @public
API_URL=http://localhost:3000

# Stripe — legacy HTTP SDK gets shaped placeholder via projection=legacy-token
# @required @sensitive
# @type=string(startsWith="sk_")
STRIPE_SECRET_KEY=opensesameConnection(conn://demo/stripe, projection=legacy-token)

# GitHub — Vault-aware handle (ConnectionRef URI in env for handle mode)
# @required @sensitive
GITHUB_TOKEN=opensesame(conn://demo/github)
