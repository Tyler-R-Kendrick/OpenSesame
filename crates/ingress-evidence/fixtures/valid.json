{
  "description": "Header sets that decode to a ForwardedChain.",
  "cases": [
    {
      "name": "leaf_only",
      "description": "Client-Cert alone; no chain.",
      "headers": [
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "ok": {
          "leaf_sha256": "e63c04ba07425273685feb75a2fa0a9b24a3d9ebe7957a540e9f907ca502dc4c",
          "intermediates_sha256": []
        }
      }
    },
    {
      "name": "leaf_and_chain_single_field",
      "description": "Intermediate and root in one list.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::, ::"
        ]
      ],
      "expect": {
        "ok": {
          "leaf_sha256": "e63c04ba07425273685feb75a2fa0a9b24a3d9ebe7957a540e9f907ca502dc4c",
          "intermediates_sha256": [
            "1ca86e0e15dbb33baa68d7f3f6d6df554411c77ac6d99812f597e4df173bb81d",
            "bae191bd732cffeff2793a4dfc900a598784f3e9f43e4693d982389cbe3064d9"
          ]
        }
      }
    },
    {
      "name": "leaf_and_chain_split_fields",
      "description": "AT-INGRESS-CHAINFIELDS: the same list split over two physical fields decodes identically.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::"
        ],
        [
          "client-cert-chain",
          "::"
        ]
      ],
      "expect": {
        "ok": {
          "leaf_sha256": "e63c04ba07425273685feb75a2fa0a9b24a3d9ebe7957a540e9f907ca502dc4c",
          "intermediates_sha256": [
            "1ca86e0e15dbb33baa68d7f3f6d6df554411c77ac6d99812f597e4df173bb81d",
            "bae191bd732cffeff2793a4dfc900a598784f3e9f43e4693d982389cbe3064d9"
          ]
        }
      }
    },
    {
      "name": "leaf_and_chain_split_three_fields",
      "description": "Order of the chain fields is wire order regardless of where Client-Cert sits.",
      "headers": [
        [
          "client-cert-chain",
          "::"
        ],
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::"
        ],
        [
          "client-cert-chain",
          "::"
        ]
      ],
      "expect": {
        "ok": {
          "leaf_sha256": "e63c04ba07425273685feb75a2fa0a9b24a3d9ebe7957a540e9f907ca502dc4c",
          "intermediates_sha256": [
            "1ca86e0e15dbb33baa68d7f3f6d6df554411c77ac6d99812f597e4df173bb81d",
            "bae191bd732cffeff2793a4dfc900a598784f3e9f43e4693d982389cbe3064d9",
            "bae191bd732cffeff2793a4dfc900a598784f3e9f43e4693d982389cbe3064d9"
          ]
        }
      }
    },
    {
      "name": "chain_with_leading_leaf_duplicate",
      "description": "A proxy that repeats the leaf as the first chain member is tolerated; the duplicate is dropped.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::, ::"
        ]
      ],
      "expect": {
        "ok": {
          "leaf_sha256": "e63c04ba07425273685feb75a2fa0a9b24a3d9ebe7957a540e9f907ca502dc4c",
          "intermediates_sha256": [
            "1ca86e0e15dbb33baa68d7f3f6d6df554411c77ac6d99812f597e4df173bb81d"
          ]
        }
      }
    },
    {
      "name": "chain_intermediate_only",
      "description": "Root omitted, as RFC 9440 §2.3 allows.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::"
        ]
      ],
      "expect": {
        "ok": {
          "leaf_sha256": "e63c04ba07425273685feb75a2fa0a9b24a3d9ebe7957a540e9f907ca502dc4c",
          "intermediates_sha256": [
            "1ca86e0e15dbb33baa68d7f3f6d6df554411c77ac6d99812f597e4df173bb81d"
          ]
        }
      }
    },
    {
      "name": "whitespace_around_members",
      "description": "OWS around members and separators is structured-field syntax, not an error.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "  :: ,\t::  "
        ]
      ],
      "expect": {
        "ok": {
          "leaf_sha256": "e63c04ba07425273685feb75a2fa0a9b24a3d9ebe7957a540e9f907ca502dc4c",
          "intermediates_sha256": [
            "1ca86e0e15dbb33baa68d7f3f6d6df554411c77ac6d99812f597e4df173bb81d",
            "bae191bd732cffeff2793a4dfc900a598784f3e9f43e4693d982389cbe3064d9"
          ]
        }
      }
    },
    {
      "name": "header_name_uppercase",
      "description": "Field names are case-insensitive.",
      "headers": [
        [
          "Client-Cert",
          "::"
        ],
        [
          "Client-Cert-Chain",
          "::"
        ]
      ],
      "expect": {
        "ok": {
          "leaf_sha256": "e63c04ba07425273685feb75a2fa0a9b24a3d9ebe7957a540e9f907ca502dc4c",
          "intermediates_sha256": [
            "1ca86e0e15dbb33baa68d7f3f6d6df554411c77ac6d99812f597e4df173bb81d"
          ]
        }
      }
    }
  ]
}
