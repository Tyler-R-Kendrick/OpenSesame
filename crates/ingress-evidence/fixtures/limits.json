    {
      "name": "leaf_over_certificate_limit",
      "description": "Leaf larger than a lowered per-certificate limit.",
      "headers": [
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "error": "certificate_too_large"
      },
      "limits": {
        "max_certificate_bytes": 500,
        "max_chain_certificates": 8,
        "max_total_header_bytes": 65536
      }
    },
    {
      "name": "chain_member_over_certificate_limit",
      "description": "Size is checked before DER, so oversized garbage is reported as too large.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::"
        ]
      ],
      "expect": {
        "error": "certificate_too_large"
      },
      "limits": {
        "max_certificate_bytes": 550,
        "max_chain_certificates": 8,
        "max_total_header_bytes": 65536
      }
    },
    {
      "name": "chain_limit_lowered",
      "description": "Two members over a limit of one.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::, ::"
        ]
      ],
      "expect": {
        "error": "chain_too_long"
      },
      "limits": {
        "max_certificate_bytes": 16384,
        "max_chain_certificates": 1,
        "max_total_header_bytes": 65536
      }
    },
    {
      "name": "header_bytes_exceeded",
      "description": "Total undecoded header text over a lowered limit.",
      "headers": [
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "error": "header_bytes_exceeded"
      },
      "limits": {
        "max_certificate_bytes": 16384,
        "max_chain_certificates": 8,
        "max_total_header_bytes": 100
      }
    },
    {
      "name": "header_bytes_checked_first",
      "description": "The byte ceiling is applied before multiplicity, so nothing is decoded from an oversized request.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "error": "header_bytes_exceeded"
      },
      "limits": {
        "max_certificate_bytes": 16384,
        "max_chain_certificates": 8,
        "max_total_header_bytes": 100
      }
    }
