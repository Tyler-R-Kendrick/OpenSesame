{
  "description": "Malformed or conflicting header sets and the code each must produce.",
  "cases": [
    {
      "name": "leaf_repeated",
      "description": "AT-INGRESS-PARSER: Client-Cert is a singleton; a second physical field is refused even when both values are valid.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "error": "leaf_repeated"
      }
    },
    {
      "name": "leaf_repeated_identical",
      "description": "Identical repeats are still repeats.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "error": "leaf_repeated"
      }
    },
    {
      "name": "chain_without_leaf",
      "description": "Client-Cert-Chain MUST NOT appear without Client-Cert.",
      "headers": [
        [
          "client-cert-chain",
          "::"
        ]
      ],
      "expect": {
        "error": "leaf_missing"
      }
    },
    {
      "name": "leaf_as_list",
      "description": "A list where a single item is required is a syntax error, which is also what a fetch Headers join of two Client-Cert fields looks like.",
      "headers": [
        [
          "client-cert",
          "::, ::"
        ]
      ],
      "expect": {
        "error": "malformed_structured_field"
      }
    },
    {
      "name": "leaf_string_item",
      "description": "A String item is not a Byte Sequence.",
      "headers": [
        [
          "client-cert",
          "\"\""
        ]
      ],
      "expect": {
        "error": "not_byte_sequence"
      }
    },
    {
      "name": "leaf_token_item",
      "description": "A Token item is not a Byte Sequence.",
      "headers": [["client-cert", "abc"]],
      "expect": {
        "error": "not_byte_sequence"
      }
    },
    {
      "name": "leaf_integer_item",
      "description": "An Integer item is not a Byte Sequence.",
      "headers": [["client-cert", "42"]],
      "expect": {
        "error": "not_byte_sequence"
      }
    },
    {
      "name": "leaf_boolean_item",
      "description": "A Boolean item is not a Byte Sequence.",
      "headers": [["client-cert", "?1"]],
      "expect": {
        "error": "not_byte_sequence"
      }
    },
    {
      "name": "leaf_with_parameters",
      "description": "RFC 9440 defines no parameters.",
      "headers": [
        [
          "client-cert",
          "::;a=1"
        ]
      ],
      "expect": {
        "error": "parameters_present"
      }
    },
    {
      "name": "chain_member_with_parameters",
      "description": "Parameters on a chain member are refused too.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::;x"
        ]
      ],
      "expect": {
        "error": "parameters_present"
      }
    },
    {
      "name": "chain_inner_list",
      "description": "An Inner List member is not a Byte Sequence.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "(:: ::)"
        ]
      ],
      "expect": {
        "error": "not_byte_sequence"
      }
    },
    {
      "name": "chain_string_member",
      "description": "A String member is not a Byte Sequence.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::, \"x\""
        ]
      ],
      "expect": {
        "error": "not_byte_sequence"
      }
    },
    {
      "name": "leaf_empty_byte_sequence",
      "description": "Zero decoded bytes.",
      "headers": [["client-cert", "::"]],
      "expect": {
        "error": "empty_item"
      }
    },
    {
      "name": "chain_empty_byte_sequence",
      "description": "Zero decoded bytes in a chain member.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::, ::"
        ]
      ],
      "expect": {
        "error": "empty_item"
      }
    },
    {
      "name": "leaf_empty_value",
      "description": "An empty field value.",
      "headers": [["client-cert", ""]],
      "expect": {
        "error": "empty_item"
      }
    },
    {
      "name": "chain_empty_field",
      "description": "A chain field with no members is not something a proxy emits.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        ["client-cert-chain", "  "]
      ],
      "expect": {
        "error": "empty_item"
      }
    },
    {
      "name": "leaf_invalid_base64_characters",
      "description": "Characters outside the base64 alphabet.",
      "headers": [["client-cert", ":ab$cd:"]],
      "expect": {
        "error": "malformed_structured_field"
      }
    },
    {
      "name": "leaf_unpadded_base64",
      "description": "RFC 8941 lets parsers tolerate missing padding; this profile requires the canonical encoding, so both implementations refuse it identically.",
      "headers": [["client-cert", ":AQ:"]],
      "expect": {
        "error": "malformed_structured_field"
      }
    },
    {
      "name": "leaf_noncanonical_pad_bits",
      "description": "Non-zero pad bits are not canonical.",
      "headers": [["client-cert", ":AR==:"]],
      "expect": {
        "error": "malformed_structured_field"
      }
    },
    {
      "name": "chain_unpadded_base64",
      "description": "Unpadded intermediate.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::"
        ]
      ],
      "expect": {
        "error": "malformed_structured_field"
      }
    },
    {
      "name": "leaf_unterminated_byte_sequence",
      "description": "Missing closing colon.",
      "headers": [
        [
          "client-cert",
          ":"
        ]
      ],
      "expect": {
        "error": "malformed_structured_field"
      }
    },
    {
      "name": "leaf_trailing_garbage",
      "description": "Trailing characters after the item.",
      "headers": [
        [
          "client-cert",
          ":: x"
        ]
      ],
      "expect": {
        "error": "malformed_structured_field"
      }
    },
    {
      "name": "chain_trailing_comma",
      "description": "A trailing comma is a List syntax error.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::,"
        ]
      ],
      "expect": {
        "error": "malformed_structured_field"
      }
    },
    {
      "name": "leaf_non_ascii",
      "description": "A non-ASCII byte is never valid structured-field text.",
      "headers": [
        [
          "client-cert",
          ":éAAA:"
        ]
      ],
      "expect": {
        "error": "malformed_structured_field"
      }
    },
    {
      "name": "leaf_not_der",
      "description": "Three zero bytes are not a certificate.",
      "headers": [["client-cert", ":AAAA:"]],
      "expect": {
        "error": "not_der_certificate"
      }
    },
    {
      "name": "leaf_der_trailing_byte",
      "description": "One byte after the certificate: a byte sequence must be exactly one certificate.",
      "headers": [
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "error": "not_der_certificate"
      }
    },
    {
      "name": "leaf_der_truncated",
      "description": "Truncated DER.",
      "headers": [
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "error": "not_der_certificate"
      }
    },
    {
      "name": "leaf_der_prefixed",
      "description": "Bytes before the certificate.",
      "headers": [
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "error": "not_der_certificate"
      }
    },
    {
      "name": "chain_not_der",
      "description": "A chain member that is not a certificate.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::, :AAAA:"
        ]
      ],
      "expect": {
        "error": "not_der_certificate"
      }
    },
    {
      "name": "leaf_is_ca_certificate",
      "description": "A CA certificate cannot be the end-entity leaf.",
      "headers": [
        [
          "client-cert",
          "::"
        ]
      ],
      "expect": {
        "error": "conflicting_leaf"
      }
    },
    {
      "name": "chain_contains_other_end_entity",
      "description": "A different end-entity certificate in the chain conflicts with Client-Cert whatever its subject says.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::, ::"
        ]
      ],
      "expect": {
        "error": "conflicting_leaf"
      }
    },
    {
      "name": "chain_leaf_duplicate_not_first",
      "description": "The leaf may only be tolerated at position zero.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::, ::"
        ]
      ],
      "expect": {
        "error": "conflicting_leaf"
      }
    },
    {
      "name": "chain_leaf_duplicate_twice",
      "description": "After the leading duplicate is dropped, a second copy conflicts.",
      "headers": [
        [
          "client-cert",
          "::"
        ],
        [
          "client-cert-chain",
          "::, ::, ::"
        ]
      ],
      "expect": {
        "error": "conflicting_leaf"
      }
    },
    {
      "name": "leaf_repeated_wins_over_malformed",
      "description": "Multiplicity is checked before any value is decoded.",
      "headers": [["client-cert", "garbage"], ["client-cert", "::"]],
      "expect": {
        "error": "leaf_repeated"
      }
    }
  ]
}
