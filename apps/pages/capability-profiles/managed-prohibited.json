{
  "$schema": "opensesame-capability-profile/1",
  "name": "managed-prohibited",
  "notes": "Managed instance that prohibits git backup, enterprise, WebMCP agents, remote AI and telemetry as deliberate refusals. The installation tries to select backup.git-remote anyway; it must resolve PROHIBITED_BY_INSTANCE while sharing.drops is approved.",
  "instancePolicy": {
    "schemaVersion": 1,
    "kind": "InstanceCapabilityPolicy",
    "instanceId": "inst-managed",
    "revision": "12",
    "presetProvenance": {
      "id": "custom",
      "version": 1
    },
    "capabilities": {
      "default": "deny",
      "required": [],
      "optional": [
        "identity.local-iam",
        "identity.siop",
        "identity.site-broker",
        "sharing.drops",
        "support.local-ai"
      ],
      "prohibited": [
        "agents.webmcp",
        "backup.git-remote",
        "enterprise.ca-administration",
        "enterprise.directory-provisioning",
        "networking.tailnet",
        "support.remote-ai",
        "telemetry.external"
      ]
    },
    "network": {
      "externalServices": "allow",
      "allowedServiceOrigins": []
    },
    "updates": {
      "unknownCapabilities": "deny",
      "expandedExposure": "require-approval"
    }
  },
  "installationSelection": {
    "schemaVersion": 1,
    "kind": "InstallationCapabilitySelection",
    "instanceId": "inst-managed",
    "installationId": "device-managed-1",
    "basePolicyRevision": "12",
    "revision": "1",
    "acceptedRequired": [],
    "selectedOptional": ["backup.git-remote", "sharing.drops"],
    "chosenAlternatives": {},
    "delivery": {
      "prefetch": "selected",
      "offlineCache": "selected-only"
    }
  }
}
