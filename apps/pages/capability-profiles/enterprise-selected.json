{
  "$schema": "opensesame-capability-profile/1",
  "name": "enterprise-selected",
  "notes": "Organization instance: access.authority and identity.local-iam plus directory provisioning and CA administration. The closure pulls identity.federation (dependency of directory provisioning) and vault.certificate-records (dependency of CA administration), both permitted by the policy.",
  "instancePolicy": {
    "schemaVersion": 1,
    "kind": "InstanceCapabilityPolicy",
    "instanceId": "inst-org",
    "revision": "7",
    "presetProvenance": {
      "id": "organization",
      "version": 1
    },
    "capabilities": {
      "default": "deny",
      "required": [],
      "optional": [
        "access.authority",
        "enterprise.ca-administration",
        "enterprise.directory-provisioning",
        "identity.federation",
        "identity.local-iam",
        "vault.certificate-records"
      ],
      "prohibited": [
        "activity.log",
        "agents.webmcp",
        "backup.cloud-secrets",
        "backup.git-remote",
        "connectors.external",
        "identity.ambient-sso",
        "identity.siop",
        "identity.site-broker",
        "notifications.web-push",
        "sharing.drops",
        "sharing.household",
        "support.guided-help",
        "support.local-ai",
        "support.remote-ai",
        "telemetry.external",
        "vault.interop-formats",
        "vault.passkey-records",
        "wallet.spending"
      ]
    },
    "network": {
      "externalServices": "allow",
      "allowedServiceOrigins": []
    },
    "updates": {
      "unknownCapabilities": "deny",
      "expandedExposure": "require-approval"
    }
  },
  "installationSelection": {
    "schemaVersion": 1,
    "kind": "InstallationCapabilitySelection",
    "instanceId": "inst-org",
    "installationId": "device-org-1",
    "basePolicyRevision": "7",
    "revision": "1",
    "acceptedRequired": [],
    "selectedOptional": [
      "access.authority",
      "enterprise.ca-administration",
      "enterprise.directory-provisioning",
      "identity.local-iam"
    ],
    "chosenAlternatives": {},
    "delivery": {
      "prefetch": "selected",
      "offlineCache": "selected-only"
    }
  }
}
