{
  "$schema": "opensesame-capability-profile/1",
  "name": "enterprise-selected",
  "notes": "Organization instance: directory provisioning and CA administration. Their dependencies (identity.federation, access.authority, vault.certificate-records) and browser-local IAM are always on.",
  "instancePolicy": {
    "schemaVersion": 1,
    "kind": "InstanceCapabilityPolicy",
    "instanceId": "inst-org",
    "revision": "7",
    "presetProvenance": {
      "id": "organization",
      "version": 1
    },
    "capabilities": {
      "default": "deny",
      "required": [],
      "optional": [
        "enterprise.ca-administration",
        "enterprise.directory-provisioning"
      ],
      "prohibited": [
        "agents.webmcp",
        "networking.tailnet",
        "notifications.routing",
        "notifications.web-push",
        "sharing.drops",
        "sharing.household",
        "support.local-ai",
        "support.remote-ai",
        "telemetry.external",
        "wallet.spending"
      ]
    },
    "network": {
      "externalServices": "allow",
      "allowedServiceOrigins": []
    },
    "updates": {
      "unknownCapabilities": "deny",
      "expandedExposure": "require-approval"
    }
  },
  "installationSelection": {
    "schemaVersion": 1,
    "kind": "InstallationCapabilitySelection",
    "instanceId": "inst-org",
    "installationId": "device-org-1",
    "basePolicyRevision": "7",
    "revision": "1",
    "acceptedRequired": [],
    "selectedOptional": [
      "enterprise.ca-administration",
      "enterprise.directory-provisioning"
    ],
    "chosenAlternatives": {},
    "delivery": {
      "prefetch": "selected",
      "offlineCache": "selected-only"
    }
  }
}
