{
  "name": "@opensesame/pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Pages installable PWA \u2014 offline client shell for OpenSesame",
  "scripts": {
    "dev": "bash ../../scripts/dev/pages-dev.sh",
    "dev:web": "vite --port 5180 --strictPort --host localhost",
    "relay": "node server/server.mjs",
    "build": "node scripts/security-profile.mjs && tsc --noEmit && vite build && node scripts/build-workers.mjs",
    "preview": "vite preview --port 5180",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test server/test/*.test.mjs",
    "test:relay": "node --test server/test/*.test.mjs",
    "generate:connect": "node scripts/emit-connect-verify-targets.mjs && biome format --write server/connect-verify-targets.generated.mjs",
    "verify:static": "node scripts/verify-static-origin.mjs",
    "verify:self-hosted-connectors": "node scripts/verify-self-hosted-connectors.mjs",
    "verify:auth": "node scripts/verify-auth-flow.mjs",
    "verify:device-identity": "node scripts/verify-device-identity.mjs",
    "verify:device-inbox": "node scripts/verify-device-inbox.mjs",
    "verify:live-join": "node scripts/verify-live-join.mjs",
    "verify:live-local-pair": "node scripts/verify-live-local-pair.mjs",
    "verify:peer-trust-two-context": "node scripts/verify-peer-trust-two-context.mjs",
    "verify:peering-diagnostics": "node scripts/verify-peering-diagnostic-observation.mjs && node scripts/verify-peering-diagnostics.mjs",
    "verify:fresh-vault-login": "node scripts/verify-fresh-vault-login.mjs",
    "verify:cli-public-site": "node scripts/verify-cli-public-site.mjs",
    "verify:relay-join": "node scripts/verify-relay-join.mjs",
    "verify:relay-join-live": "node scripts/verify-relay-join-live.mjs",
    "verify:live-netns": "node scripts/verify-live-netns.mjs",
    "verify:browser-sessions": "node scripts/verify-browser-sessions.mjs",
    "verify:browser-session-lifecycle": "node scripts/verify-browser-session-lifecycle.mjs",
    "test:browser-sessions": "VITE_BASE=/OpenSesame/ pnpm run build && pnpm run verify:browser-sessions",
    "verify:keyboard": "node scripts/verify-keyboard.mjs",
    "verify:tutorials": "node scripts/verify-tutorials.mjs",
    "verify:tutorials-profiles": "node scripts/verify-tutorials-profiles.mjs",
    "verify:push-worker": "node scripts/verify-push-worker.mjs",
    "verify:sw-dirty-edit": "node scripts/verify-sw-dirty-edit.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "verify:header-layout": "node scripts/verify-header-layout.mjs",
    "verify:local-iam": "vitest run scripts/local-iam-headers.test.mjs && node scripts/verify-local-iam.mjs",
    "verify:siop": "vitest run scripts/siop-headers.test.mjs && node scripts/verify-siop.mjs",
    "verify:webmcp": "node scripts/verify-webmcp.mjs",
    "verify:transport": "node scripts/verify-transport.mjs",
    "verify:access-pathbar": "node scripts/verify-access-pathbar.mjs",
    "verify:ambient-sso": "node scripts/verify-ambient-sso.mjs",
    "verify:experience": "node scripts/verify-experience.mjs",
    "vectors:vault": "node scripts/emit-vault-vectors.mjs",
    "verify:key-protection": "pnpm --filter @opensesame/app-core exec vitest run src/lib/vault/protection src/lib/age-keys",
    "verify:duress": "node scripts/verify-duress.mjs",
    "verify:duress:offline": "node scripts/verify-duress-offline.mjs",
    "verify:duress:browser": "node scripts/verify-duress-browser.mjs",
    "build:profile": "node scripts/build-profile.mjs",
    "build:push-verify": "PAGES_DEPLOYMENT_PROFILE=loopback_development PAGES_CANONICAL_ORIGIN=http://localhost:41877 node scripts/stamped-build.mjs 'vite build --outDir dist-push-verify --emptyOutDir && PAGES_OUT_DIR=dist-push-verify node scripts/build-workers.mjs'",
    "verify:push": "pnpm --filter @opensesame/control-plane exec tsx ../../apps/pages/scripts/verify-push.mjs",
    "build:live-dedicated": "PAGES_DEPLOYMENT_PROFILE=dedicated_origin PAGES_CANONICAL_ORIGIN=https://opensesame.example.test PAGES_HEADER_SECURITY=1 node scripts/stamped-build.mjs 'vite build --outDir dist-live-dedicated --emptyOutDir'",
    "verify:capability-graph": "node scripts/verify-capability-graph.mjs",
    "verify:mutations": "node scripts/verify-mutations.mjs",
    "verify:tailnet-sync": "node scripts/verify-tailnet-sync.mjs",
    "verify:tailnet-devices": "node scripts/verify-tailnet-devices.mjs",
    "verify:password-agent": "node scripts/verify-password-agent.mjs",
    "verify:encrypted-search": "node scripts/verify-encrypted-search.mjs",
    "verify:portable-drop": "node scripts/verify-portable-drop.mjs",
    "verify:native-connectors": "node scripts/verify-native-connectors-journey.mjs",
    "verify:native-public-protocol": "node scripts/verify-native-public-protocol.mjs",
    "verify:provider-auth": "node scripts/verify-provider-auth.mjs",
    "verify:quorum-browser": "node scripts/verify-quorum-browser.mjs",
    "verify:trusted-unlock": "node scripts/verify-trusted-unlock.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "typecheck:storybook": "tsc -p .storybook/tsconfig.json",
    "compose:identity-integrations": "node scripts/compose-identity-integrations.mjs",
    "capture:identity-integrations": "node scripts/capture-identity-integrations.mjs",
    "verify:identity-connections": "PAGES_VERIFY_DIST=dist-identity-verify node scripts/verify-identity-connections.mjs",
    "build:identity-verify": "PAGES_DEPLOYMENT_PROFILE=loopback_development PAGES_CANONICAL_ORIGIN=http://localhost:41899 node scripts/stamped-build.mjs 'vite build --outDir dist-identity-verify --emptyOutDir && PAGES_OUT_DIR=dist-identity-verify node scripts/build-workers.mjs'",
    "build:secret-backends-verify": "PAGES_DEPLOYMENT_PROFILE=loopback_development PAGES_CANONICAL_ORIGIN=http://localhost:41901 node scripts/stamped-build.mjs 'vite build --outDir dist-secret-backends-verify --emptyOutDir && PAGES_OUT_DIR=dist-secret-backends-verify node scripts/build-workers.mjs'",
    "verify:secret-backends": "pnpm --filter @opensesame/control-plane exec tsx ../../apps/pages/scripts/verify-secret-backends.mjs",
    "verify:github-app-browser": "pnpm --filter @opensesame/control-plane exec tsx ../../apps/pages/scripts/verify-github-app-browser.mjs",
    "capture:backup-integrations": "node scripts/capture-backup-integrations.mjs",
    "compose:backup-integrations": "node scripts/compose-backup-integrations.mjs",
    "build:ai-connections-verify": "OPENSESAME_AI_COMPLETION_VERIFY=1 PAGES_DEPLOYMENT_PROFILE=loopback_development PAGES_CANONICAL_ORIGIN=http://localhost:41911 node scripts/stamped-build.mjs 'vite build --outDir dist-ai-connections-verify --emptyOutDir && PAGES_OUT_DIR=dist-ai-connections-verify node scripts/build-workers.mjs'",
    "verify:ai-connections": "node scripts/verify-ai-connections.mjs",
    "build:tailnet-browser-verify": "PAGES_DEPLOYMENT_PROFILE=loopback_development PAGES_CANONICAL_ORIGIN=http://localhost:41911 node scripts/stamped-build.mjs 'vite build --outDir dist-tailscale-browser-verify --emptyOutDir && PAGES_OUT_DIR=dist-tailscale-browser-verify node scripts/build-workers.mjs'",
    "verify:tailnet-browser-node": "node scripts/verify-tailnet-browser-node.mjs",
    "verify:tailscale-provisioning": "node scripts/verify-tailscale-provisioning.mjs",
    "build:iwa": "PAGES_DEPLOYMENT_PROFILE=isolated_web_app PAGES_CANONICAL_ORIGIN=isolated-app: node scripts/stamped-build.mjs 'VITE_BASE=/ vite build --outDir dist-iwa --emptyOutDir && PAGES_OUT_DIR=dist-iwa node scripts/build-workers.mjs && node scripts/build-iwa-manifest.mjs'",
    "build:iwa:signed": "pnpm run build:iwa && node scripts/sign-iwa.mjs",
    "generate:icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@1password/save-button": "1.3.0",
    "@azure/msal-browser": "5.22.0",
    "@nats-io/nats-core": "3.4.0",
    "@nats-io/services": "3.4.0",
    "@openfeature/core": "1.12.0",
    "@openfeature/web-sdk": "1.10.0",
    "@opensesame/app-core": "workspace:*",
    "@opensesame/capability-composition": "workspace:*",
    "@opensesame/capability-registry": "workspace:*",
    "@opensesame/contracts": "workspace:*",
    "@opensesame/guide-lang": "workspace:*",
    "@opensesame/guide-runtime": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/qr": "workspace:^",
    "@opensesame/sdk-browser": "workspace:*",
    "@opensesame/siop-v2": "workspace:*",
    "@opensesame/static-auth": "workspace:*",
    "@opensesame/support-agent": "workspace:*",
    "@opensesame/vault-core": "workspace:*",
    "@opensesame/vault-item-types": "workspace:*",
    "@opensesame/webmcp": "workspace:*",
    "age-encryption": "0.3.1",
    "mqtt": "5.16.0",
    "nostr-tools": "2.25.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "simple-icons": "15.16.1",
    "tinykeys": "4.0.0"
  },
  "devDependencies": {
    "@opensesame/connector-bridge": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.3",
    "@storybook/react-vite": "10.6.1",
    "@tailscale/connect": "1.102.3-3-tb31d8a75a-g5e651e16f",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.29",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.5.0",
    "aedes": "1.2.0",
    "fast-check": "4.9.0",
    "jsdom": "26.1.0",
    "node-turn": "0.0.6",
    "storybook": "10.6.2",
    "terser": "5.51.2",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "4.1.12",
    "wbn": "0.0.9",
    "wbn-sign": "0.3.3",
    "workbox-window": "7.3.0",
    "ws": "8.21.3"
  }
}
