{
  "name": "@opensesame/pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Pages installable PWA — offline client shell for OpenSesame",
  "scripts": {
    "dev": "bash ../../scripts/pages-dev.sh",
    "dev:web": "vite --port 5180 --strictPort --host localhost",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5180",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "verify:static": "node scripts/verify-static-origin.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@opensesame/api-client": "workspace:*",
    "@opensesame/capability-registry": "workspace:*",
    "@opensesame/client-core": "workspace:*",
    "@opensesame/contracts": "workspace:*",
    "@opensesame/guide-lang": "workspace:*",
    "@opensesame/guide-runtime": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/qr": "workspace:^",
    "@opensesame/sdk-browser": "workspace:*",
    "@opensesame/support-agent": "workspace:*",
    "@opensesame/vault-item-types": "workspace:*",
    "@opensesame/webmcp": "workspace:*",
    "@tursodatabase/sync-wasm": "0.7.2",
    "driver.js": "1.8.0",
    "hash-wasm": "4.12.0",
    "kdbxweb": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "simple-icons": "15.16.1",
    "tinykeys": "4.0.0"
  },
  "devDependencies": {
    "@opensesame/testing": "workspace:*",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.29",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.0",
    "fast-check": "4.9.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "4.1.10",
    "workbox-window": "7.3.0"
  }
}
