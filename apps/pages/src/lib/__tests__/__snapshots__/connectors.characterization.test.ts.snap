// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`connector copy characterization > explains every failure class in exactly these words 1`] = `
"offline          This device is offline. Checks resume when the network is back.
timeout          Host did not answer in time. It may be starting up, or the tailnet may be slow.
unreachable      Nothing answered. Check Host is running, and that this page is allowed to reach it.
rejected         Host answered but refused the request. Its credentials need renewing.
server-error     Host answered with an error of its own. Its logs will say more than this page can.
not-opensesame   Something is listening at Host, but it is not the OpenSesame service. Check the port."
`;

exports[`connector copy characterization > says exactly this for an Identity that was never configured 1`] = `"no base                                off      Not configured"`;

