{
  "$comment": [
    "Which Pages sources move to packages/app-core and which stay in the React shell (ADR 0133).",
    "Paths are relative to apps/pages/src. A file moves when it matches `move` and no `stay` pattern; everything else stays.",
    "Checked by scripts/app-core-partition.mjs. Before the relocation (step 3) it must report zero edges from moving code into staying code."
  ],
  "root": "apps/pages/src",
  "move": [
    "lib/**",
    "webmcp/**",
    "tutorial/agents/**",
    "tutorial/registry/**",
    "screens/unlock/unlock-duress-continue*.ts",
    "screens/unlock/unlock-duress-refuse*.ts",
    "screens/unlock/unlock-passkey-duress*.ts",
    "screens/unlock/unlock-passkey-evidence*.ts",
    "screens/unlock/unlock-password-duress*.ts",
    "screens/unlock/unlock-pin-duress*.ts",
    "screens/unlock/unlock-second-step-duress*.ts",
    "screens/setup/providers*.ts",
    "sections/access/duress-approval-bridge*.ts",
    "sections/connections/githubAppSummaryModel*.ts",
    "sections/connections/githubBackupRepoActions*.ts",
    "sections/connections/githubBackupRepoLoad*.ts",
    "sections/connections/GithubBackupRepoResolve*.ts",
    "sections/connections/GithubBackupRepoSuggestions*.ts",
    "sections/connections/shared*.ts",
    "sections/settings/item-type-fields*.ts",
    "sections/settings/settings-files*.ts",
    "sections/settings/security/duress-unlock-bridge*.ts",
    "sections/settings/sops/identities*.ts",
    "routes/settings/security/duress-enrollment-derived*.ts"
  ],
  "stay": [
