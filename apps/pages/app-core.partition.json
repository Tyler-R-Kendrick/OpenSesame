    "**/*.css",
    "lib/agent-page-dump*.ts",
    "lib/command-bar/focus*.ts",
    "lib/crumbs*.ts",
    "lib/focus*.ts",
    "lib/gestures*.ts",
    "lib/install*.ts",
    "lib/keymap*.ts",
    "lib/modal-focus*.ts",
    "lib/page-to-tree*.ts",
    "lib/pane-escape*.ts",
    "lib/push*.ts",
    "lib/pwa-update*.ts",
    "lib/section-views*.ts",
    "lib/theme*.ts",
    "lib/tree-motion*.ts",
    "lib/use-*.ts",
    "lib/vault/hooks*.ts",
    "tutorial/registry/targets*.ts",
    "webmcp/lifecycle*.ts",
    "webmcp/registration*.ts"
  ]
}
