    "@opensesame/os-domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
