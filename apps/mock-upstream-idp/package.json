{
  "name": "@opensesame/mock-upstream-idp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mock-upstream-idp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
