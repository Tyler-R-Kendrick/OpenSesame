<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(OPENSESAME_KEYCHAIN_GROUP)</string>
		<string>$(AppIdentifierPrefix)group.dev.opensesame.authenticator</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(OPENSESAME_INVOCATION_HOST)</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(OPENSESAME_APP_GROUP)</string>
	</array>
</dict>
</plist>
