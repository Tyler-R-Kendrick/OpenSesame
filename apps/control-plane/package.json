{
  "name": "@opensesame/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:openapi": "tsx src/generate-openapi.ts && biome format --write openapi.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@opensesame/audit": "workspace:*",
    "@opensesame/auth-upstream": "workspace:*",
    "@opensesame/claims": "workspace:*",
    "@opensesame/contracts": "workspace:*",
    "@opensesame/database": "workspace:*",
    "@opensesame/device-auth": "workspace:*",
    "@opensesame/oauth-provider": "workspace:*",
    "@opensesame/observability": "workspace:*",
    "@opensesame/os-domain": "workspace:*",
    "@opensesame/policy": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@opensesame/testing": "workspace:*",
    "@types/node": "22.15.29",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
